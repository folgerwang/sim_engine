#version 450
#extension GL_ARB_separate_shader_objects : enable
#include "global_definition.glsl.h"

// ─── Apply SSAO to the scene colour buffer ────────────────────
// Multiplies the blurred AO texture into the colour buffer in-place.
//
// ── TWO CORRECTIONS THIS PASS CARRIES ────────────────────────────────
// This used to be `color.rgb *= ao`, which is wrong twice over and is
// most of why shadowed ground read as near-black.
//
// 1. AO IS AN AMBIENT-ONLY TERM.  A pixel's direct sunlight is already
//    occlusion-tested per pixel by the shadow map; darkening it again
//    with a screen-space occlusion estimate double-counts.  The
//    deferred resolve knows this — it folds `rt_ao` into the ambient
//    term alone and only bleeds RT_AO_DIRECT_FRACTION of it into the
//    direct one.  This pass runs on the composited colour and cannot
//    separate the two, so it bounds the darkening instead: kAoFloor is
//    the least a fully-occluded pixel may keep.  A pixel that is
//    ambient-only (i.e. in shadow) is exactly the one this used to
//    crush, because there was nothing else in it to survive the
//    multiply.
//
// 2. THE BUFFER IS ALREADY TONEMAPPED.  Every writer calls
//    sceneTonemap() before it stores, so what is here is a
//    gamma-encoded display value, not radiance.  Multiplying a
//    gamma-encoded 0.4 by 0.5 lands at linear 0.03, where the correct
//    linear-space multiply lands at 0.066 — AO came out roughly twice
//    as dark as intended, and worst on the dimmest pixels.  Raising ao
//    to 1/2.2 makes the multiply equivalent to a linear-space one
//    (exact for the gamma leg; the ACES shoulder above it only ever
//    makes the remaining error smaller, because it compresses).
//
// When debug_mode == DEBUG_RENDER_MODE_SSAO, instead of modulating the
// existing color we OVERWRITE it with vec3(ao) so the screen shows the
// raw ambient-occlusion factor as a grayscale image:
//   white  = unoccluded
//   grey   = partial AO
//   black  = fully occluded
// Useful for tuning SSAO radius / sample count without scene shading
// in the way.

layout(push_constant) uniform SSAOApplyPushConstants {
    vec2  inv_screen_size;
    float ao_strength;    // 0 = no AO, 1 = full AO
    int   debug_mode;     // matches DEBUG_RENDER_MODE_*; only ==SSAO
                          // (=11) and FINAL (=0) are special-cased here
};

layout(set = 0, binding = 0) uniform sampler2D ao_tex;
layout(set = 0, binding = 1, r11f_g11f_b10f) uniform image2D color_buf;

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 coords = ivec2(gl_GlobalInvocationID.xy);
    vec2 uv = (vec2(coords) + 0.5) * inv_screen_size;

    float ao = texture(ao_tex, uv).r;

    if (debug_mode == DEBUG_RENDER_MODE_SSAO) {
        // DIAGNOSTIC visualisation — colour-codes AO ranges so we can
        // tell at a glance whether (a) this branch is even running and
        // (b) what range of AO values the SSAO compute is producing:
        //   red    = ao > 0.99   (effectively unoccluded / sky)
        //   yellow = ao > 0.90
        //   green  = ao > 0.50
        //   blue   = ao <= 0.50  (heavy occlusion)
        // If the screen is still uniform white after rebuilding shaders,
        // this .comp is not being recompiled by the build system.
        // If the screen is mostly red, the SSAO compute is producing
        // ao ≈ 1.0 everywhere → look at ssao.comp / its inputs, not here.
        vec3 dbg;
        if      (ao > 0.99) dbg = vec3(1.0, 0.0, 0.0);
        else if (ao > 0.90) dbg = vec3(1.0, 1.0, 0.0);
        else if (ao > 0.50) dbg = vec3(0.0, 1.0, 0.0);
        else                dbg = vec3(0.0, 0.0, 1.0);
        imageStore(color_buf, coords, vec4(dbg, 1.0));
        return;
    }

    // Other debug visualisations (Hi-Z, velocity, normals, etc.) wrote
    // their final pixels directly into color_buf — modulating by AO on
    // top would mix occluder darkening into the diagnostic image and
    // make it visually noisy / misleading.  Skip the multiply for any
    // non-FINAL debug mode so the viz is clean.
    if (debug_mode != DEBUG_RENDER_MODE_FINAL) {
        return;
    }

    // Least a fully-occluded pixel may keep.  Real ambient occlusion
    // never removes ALL indirect light — a crevice still sees a slice
    // of sky — and this pass is darkening the composited colour, so a
    // hard zero here takes the direct term with it.
    const float kAoFloor = 0.35;

    ao = mix(1.0, max(ao, kAoFloor), ao_strength);
    // Linear-space equivalent of the multiply, applied to a
    // gamma-encoded buffer.  See correction 2 in the header comment.
    ao = pow(ao, 1.0 / 2.2);

    vec4 color = imageLoad(color_buf, coords);
    color.rgb *= ao;
    imageStore(color_buf, coords, color);
}
