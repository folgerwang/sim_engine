#version 450
#extension GL_ARB_separate_shader_objects : enable
#include "global_definition.glsl.h"
#include "water_waves.glsl.h"

// ── D2Q9 shallow-water Lattice-Boltzmann river surface ───────────────
// A REAL LBM this time (the old lbm_patch.comp was a stranded hair
// demo): nine distribution functions on a square lattice, BGK single-
// relaxation-time collision against the shallow-water equilibrium
//
//   f_eq_0 = h (1 - 5gh/6e^2 - 2u.u/3e^2)
//   f_eq_i = h (gh/6e^2 + e_i.u/3e^2 + (e_i.u)^2/2e^4 - u.u/6e^2)   axis
//   f_eq_i = h (gh/24e^2 + e_i.u/12e^2 + (e_i.u)^2/8e^4 - u.u/24e^2) diag
//
// (Zhou, "Lattice Boltzmann Methods for Shallow Water Flows").  The
// patch FOLLOWS THE CAMERA: push constants carry this frame's patch
// origin and last frame's, and the pull-streaming step reads the
// neighbour at the shifted texel so the sim state stays glued to the
// world while the window slides over it.  Cells scrolled in from
// outside the previous window initialise to rest depth.
//
// Forcing: a steady body force along the river's flow direction (the
// classic bed-slope term) plus a slow procedural stirring so the
// surface never settles glassy-flat.  Output is what the WATER_ATTR
// terrain pass consumes: xyz = world-space surface normal of the LBM
// height field, w = height deviation from rest (metres).
//
// Nine distributions ride three RGBA32F images (fA = f0..f3,
// fB = f4..f7, fC.r = f8), ping-ponged A→B each dispatch.  One
// dispatch per frame = one LBM time step; at 60 fps and 0.25 m cells
// the lattice speed e = dx/dt is ~15 m/s, comfortably above river
// surface wave speeds, so the sim stays in its stable regime.

layout(push_constant) uniform LbmWaterPush {
    LbmWaterParams params;
};

layout(set = 0, binding = 0, rgba32f) uniform image2D src_fA;
layout(set = 0, binding = 1, rgba32f) uniform image2D src_fB;
layout(set = 0, binding = 2, rgba32f) uniform image2D src_fC;
layout(set = 0, binding = 3, rgba32f) uniform image2D dst_fA;
layout(set = 0, binding = 4, rgba32f) uniform image2D dst_fB;
layout(set = 0, binding = 5, rgba32f) uniform image2D dst_fC;
// xyz = surface normal (world space), w = height deviation (m)
layout(set = 0, binding = 6, rgba16f) uniform image2D dst_surface;
// STATIC water-surface map (<map stem>_hydro_pondz.png, u16 height /
// kTerrainHeightAmpMeters — the same map the tile creator fills the
// water layer from).  The LBM GENERATES its own flow from this: the
// body force is the surface's downstream gradient, so rivers (whose
// authored surface descends monotonically) develop real along-channel
// currents, lakes (flat surface) stay still, and confluences merge —
// no painted flowmap involved.  level_map_world.w == 0 (map not
// bound) selects the legacy global flow_dir instead.
layout(set = 0, binding = 7) uniform sampler2D water_level_tex;
// GENERATED FLOWMAP: this step's macroscopic velocity u (m/s, world
// xz) per cell.  The water shading samples it to advect surface
// detail along the current — the LBM is the flow AUTHOR now.
layout(set = 0, binding = 8, rg16f) uniform writeonly image2D dst_flow;

// D2Q9 lattice: 0 = rest, 1..4 axis (+x, +y, -x, -y), 5..8 diagonal
// (+x+y, -x+y, -x-y, +x-y).  "y" here is the patch's Z in world space.
const ivec2 kE[9] = ivec2[9](
    ivec2(0, 0),
    ivec2(1, 0), ivec2(0, 1), ivec2(-1, 0), ivec2(0, -1),
    ivec2(1, 1), ivec2(-1, 1), ivec2(-1, -1), ivec2(1, -1));

float loadF(int i, ivec2 p) {
    if (i < 4)  return imageLoad(src_fA, p)[i];
    if (i < 8)  return imageLoad(src_fB, p)[i - 4];
    return imageLoad(src_fC, p).r;
}

float waveAt(ivec2 p, int size, bool reset) {
    if (reset) return 0.0;
    p = clamp(p, ivec2(0), ivec2(size - 1));
    float depth = 0.0;
    for (int i = 0; i < 9; ++i) depth += loadF(i, p);
    return boundedWaterWave((depth - params.rest_depth) * params.normal_amp);
}

// hash for the stirring term — deterministic per cell+frame
float lw_h21(vec2 p) {
    vec3 q = fract(vec3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

// Absorbing rim, in cells (11% of a 512 patch) -- see the sponge below.
const float kSpongeCells = 56.0;

layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    ivec2 pc = ivec2(gl_GlobalInvocationID.xy);
    int N = int(params.grid_size);
    if (pc.x >= N || pc.y >= N) return;

    const float h0    = params.rest_depth;      // rest water depth (m)
    const float e     = params.cell_m / params.dt;  // lattice speed
    const float inv_e2 = 1.0 / (e * e);
    const float g     = 9.81;
    const float tau   = 0.60;                   // BGK relaxation (stable > 0.5)

    // How far (in cells) the patch origin moved since last frame: the
    // pull below reads last frame's grid at (p + shift), keeping every
    // distribution anchored to its WORLD cell as the window slides.
    ivec2 shift = ivec2(round(
        (params.origin_ws.xz - params.prev_origin_ws.xz) / params.cell_m));

    float f[9];
    bool fresh = (params.reset != 0u);
    for (int i = 0; i < 9; ++i) {
        // Pull streaming: f_i at this cell came from the neighbour one
        // lattice vector upstream — combined with the window shift.
        // ZERO-GRADIENT open boundary: a source outside the window
        // (the patch edge, or the strip a camera move scrolled in)
        // reads the nearest cell INSIDE it.  It used to read the rest
        // state, which made the boundary a wall: every cell the window
        // slid onto was a step of still water against a stirred
        // interior, and every edge a mirror, so the patch's own rim --
        // worst at its corners, where two edges meet -- radiated ring
        // after ring across the near water.
        ivec2 src = clamp(pc + shift - kE[i], ivec2(0), ivec2(N - 1));
        f[i] = loadF(i, src);
        fresh = fresh || isnan(f[i]) || isinf(f[i]);
    }

    // Rest-state equilibrium fill on the first frame / after a reset.
    // (h = h0, u = 0.)
    float gh6 = g * h0 * inv_e2 / 6.0;
    float w_axis_rest = h0 * gh6;
    float w_diag_rest = h0 * gh6 * 0.25;
    float f0_rest = h0 - 4.0 * w_axis_rest - 4.0 * w_diag_rest;
    if (fresh) {
        for (int i = 0; i < 9; ++i) {
            f[i] = (i == 0) ? f0_rest : (i < 5 ? w_axis_rest : w_diag_rest);
        }
    }

    // Macroscopic depth + velocity.
    float h = 0.0;
    vec2  hu = vec2(0.0);
    for (int i = 0; i < 9; ++i) {
        h  += f[i];
        hu += vec2(kE[i]) * (e * f[i]);
    }
    h = max(h, 1e-4);
    vec2 u = hu / h;
    // velocity clamp keeps the sim stable if forcing spikes
    float umax = 0.35 * e;
    float ul = length(u);
    if (ul > umax) u *= umax / ul;

    // ── Forcing ─────────────────────────────────────────────────────
    // Bed-slope body force along the river flow direction + a gentle
    // travelling stir so the surface carries ripples even where the
    // mean flow is slow.  Scaled by dt (force per step).
    vec2 wpos = params.origin_ws.xz + vec2(pc) * params.cell_m;
    // ── The LBM generates its own flow ───────────────────────────────
    // Body force from the STATIC water surface's gradient: the
    // authored river surfaces descend monotonically downstream, so
    // -grad(surface) points down-channel; a bend turns the force with
    // the channel, a lake's flat surface produces none.  Cells at the
    // water's edge (any tap reads "no water") take no force — the
    // gradient there is bank geometry, not current.
    vec2 flow;
    if (params.level_map_world.w > 0.0) {
        const float step_m = 8.0;   // gradient baseline (2 map texels)
        vec2 uv = clamp((wpos - params.level_map_world.xy) *
                        params.level_map_world.z, 0.0, 1.0);
        vec2 du = vec2(step_m * params.level_map_world.z, 0.0);
        float zc = texture(water_level_tex, uv).x;
        float zx = texture(water_level_tex,
                           clamp(uv + du.xy, 0.0, 1.0)).x;
        float zy = texture(water_level_tex,
                           clamp(uv + du.yx, 0.0, 1.0)).x;
        if (zc > 0.0 && zx > 0.0 && zy > 0.0) {
            vec2 grad = (vec2(zx, zy) - zc) *
                        (kTerrainHeightAmpMeters / step_m);
            flow = -grad * params.level_map_world.w;
            float fl = length(flow);
            if (fl > 2.0) flow *= 2.0 / fl;     // physical cap, m/s
        } else {
            flow = vec2(0.0);
        }
    } else {
        flow = params.flow_dir.xy;
    }
    // Gentle momentum stirring on lakes, stronger stirring in a current.
    float t = params.time;
    float sa = sin(dot(wpos, vec2( 0.74,  0.31)) * 0.53 + t * 1.30)
             + sin(dot(wpos, vec2(-0.42,  0.65)) * 0.87 + t * 0.90 + 1.7)
             + sin(dot(wpos, vec2( 0.18, -0.91)) * 1.21 - t * 1.60 + 4.1);
    float sb = sin(dot(wpos, vec2(-0.83, -0.27)) * 0.35 + t * 0.70 + 2.9)
             + sin(dot(wpos, vec2( 0.55, -0.60)) * 0.95 - t * 1.10 + 0.6)
             + sin(dot(wpos, vec2( 0.30,  0.88)) * 1.45 + t * 1.85 + 3.3);
    float stir_gain = smoothstep(0.03, 0.40, length(flow));
    // Rain rings: 1.5e-4 per cell per step was ~40 drops a frame on
    // the patch -- a downpour on a clear day.  A rare touch now.
    vec2 force = flow * params.flow_strength +
                 vec2(sa, sb) * (0.005 + 0.015 * stir_gain);

    // ── BGK collision against shallow-water equilibrium ─────────────
    float uu = dot(u, u) * inv_e2;
    float gh = g * h * inv_e2;
    float out_f[9];
    for (int i = 0; i < 9; ++i) {
        float feq;
        if (i == 0) {
            feq = h * (1.0 - 5.0 * gh / 6.0 - 2.0 * uu / 3.0);
        } else {
            vec2 ei = vec2(kE[i]);
            float eu = dot(ei * e, u) * inv_e2;
            if (i < 5) {
                feq = h * (gh / 6.0 + eu / 3.0 + eu * eu * 0.5 - uu / 6.0);
            } else {
                feq = h * (gh / 24.0 + eu / 12.0 + eu * eu * 0.125 - uu / 24.0);
            }
        }
        // force term distributed over the axis/diagonal directions
        float fi = (i == 0) ? 0.0
                 : dot(vec2(kE[i]), force) * params.dt *
                       (i < 5 ? (1.0 / 6.0) : (1.0 / 24.0)) * h / e;
        out_f[i] = f[i] - (f[i] - feq) / tau + fi;
        out_f[i] = max(out_f[i], 0.0);
    }
    // Stir momentum, not mass: waves must not raise the mean water level.
    // ── Mean-depth restoration ──────────────────────────────────────
    // The forced equilibrium's max(0) clip can introduce mass, so the mean
    // depth DRIFTS: mass slowly lost or gained shows up as a whole-
    // patch height deviation that tile_water_lbm_vert applies to the
    // MESH -- the river sinking under its bed (gone) or lifting over
    // its banks, until the next camera-driven reset put it back.  Pull
    // the rest distribution back toward h0 a little every step; the
    // ripples (which are deviations AROUND the mean) are unaffected.
    out_f[0] += (h0 - h) * 0.02;
    out_f[0]  = max(out_f[0], 0.0);
    // ── Sponge rim ──────────────────────────────────────────────────
    // The outer kSpongeCells of the patch pull their depth toward
    // rest a little every step: a wave running out of the window is
    // absorbed across the band instead of reflecting off the edge
    // back over the near water, and the strip a camera move scrolls
    // in is eased rather than stepped.  A shallow-water wave crosses
    // the band in ~350 steps, so 5% a step is total absorption.  The
    // band lies inside the display feather (tile_water.frag fades the
    // ripples over the outer 15%), so the damping itself is never
    // seen.  A mass rescale, so u is untouched and a river's current
    // still runs out through the rim.
    {
        int   edge   = min(min(pc.x, N - 1 - pc.x), min(pc.y, N - 1 - pc.y));
        float sponge = 1.0 - smoothstep(0.0, kSpongeCells, float(edge));
        if (sponge > 0.0) {
            float hn = 0.0;
            for (int i = 0; i < 9; ++i) hn += out_f[i];
            float k = 1.0 + (h0 / max(hn, 1e-4) - 1.0) * (0.10 * sponge);
            for (int i = 0; i < 9; ++i) out_f[i] *= k;
        }
    }

    imageStore(dst_fA, pc, vec4(out_f[0], out_f[1], out_f[2], out_f[3]));
    imageStore(dst_fB, pc, vec4(out_f[4], out_f[5], out_f[6], out_f[7]));
    imageStore(dst_fC, pc, vec4(out_f[8], 0.0, 0.0, 0.0));

    // ── Surface output: height deviation + normal ───────────────────
    // Central differences over THIS step's neighbours (previous-step
    // heights — one frame of latency, invisible at ripple scale).
    // Sample the same previous-state field for offset and gradient, shifted
    // with the camera just like streaming. Reset frames publish a flat field
    // instead of deriving normals from stale/uninitialised distributions.
    ivec2 world_cell = pc + shift;
    float deviation = waveAt(world_cell, N, fresh);
    float hl = waveAt(world_cell - ivec2(1, 0), N, fresh);
    float hr = waveAt(world_cell + ivec2(1, 0), N, fresh);
    float hd = waveAt(world_cell - ivec2(0, 1), N, fresh);
    float hup = waveAt(world_cell + ivec2(0, 1), N, fresh);
    vec3 nrm = normalize(vec3(
        -(hr - hl) / (2.0 * params.cell_m),
        1.0,
        -(hup - hd) / (2.0 * params.cell_m)));
    imageStore(dst_surface, pc, vec4(nrm, deviation));
    // Publish this cell's macroscopic velocity — the GENERATED flowmap
    // the water shading advects its surface detail by.
    imageStore(dst_flow, pc, vec4(u, 0.0, 0.0));
}
