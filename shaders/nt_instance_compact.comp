#version 450
#extension GL_ARB_separate_shader_objects : enable
// ── nt_instance_compact.comp — per-INSTANCE cull for the node table ───
// Runs before node_table_cull.comp, once per pass, over every instance
// of every record in the pass's survivor class.
//
// Why: a per-instance-band node (a plant "_lodtile_" of one band) owns
// the tile's FULL instance list.  Five bands overlap a 512 m tile, so
// the old path submitted every instance five times and base.vert threw
// four bands' worth away one VERTEX at a time -- every vertex fetched,
// every triangle assembled and clipped, in the prepass AND again in the
// G-buffer.  Here each instance is tested ONCE (band + frustum) and only
// the survivors are copied into a compact per-pass instance buffer; the
// cull then points each command at the record's compacted range.
//
// Non-banded records pass through unchanged (frustum test only), so one
// compact buffer can serve every command of the pass.
#include "global_definition.glsl.h"

layout(push_constant) uniform PC {
    NtCompactPushConstants pc;
};

layout(std430, set = 0, binding = 0) readonly buffer InfoBuf     { NtCullInfo infos[]; };
layout(std430, set = 0, binding = 1) readonly buffer CmdSrcBuf   { uint cmd_src[]; };
layout(std430, set = 0, binding = 2) readonly buffer ClassIdxBuf { uint class_idx[]; };
layout(std430, set = 0, binding = 3) readonly buffer PrefixBuf   { uint class_prefix[]; };
layout(std430, set = 0, binding = 4) readonly buffer RecordBuf   { ModelParams records[]; };
layout(std430, set = 0, binding = 5) readonly buffer InstSrcBuf  { InstanceDataInfo inst_src[]; };
layout(std430, set = 0, binding = 6) readonly buffer AgeSrcBuf   { float age_src[]; };
layout(std430, set = 0, binding = 7) writeonly buffer InstDstBuf { InstanceDataInfo inst_dst[]; };
layout(std430, set = 0, binding = 8) writeonly buffer AgeDstBuf  { float age_dst[]; };
layout(std430, set = 0, binding = 9) buffer RecCountBuf          { uint rec_counts[]; };
// Predicted-depth Hi-Z pyramid (max-Z, mip 0 = half res) -- the same one
// node_table_cull.comp reads.  Only sampled when pc.flags has
// NT_COMPACT_HIZ.
layout(set = 0, binding = 12) uniform sampler2D hiz_pyramid;

// ── Per-instance occlusion ───────────────────────────────────────────
// WHY HERE: node_table_cull.comp tests the pyramid per NODE, and a plant
// node ("<species>_lodtile_<x>_<z>_512_...") owns every instance on a
// 512 m tile -- its sphere spans a big part of the screen, lands on a
// coarse mip where something is always far, and is never rejected.  So
// the frame-ahead depth culled practically no plants: every in-band,
// in-frustum tree was drawn, forest interior included.  Testing each
// instance's own sphere is what lets the predicted depth bite.
// Same algebra as node_table_cull.comp (ntFrustumPlane / ntHiZOccluded),
// here in WORLD space (the instance translation is a world position).
vec4 ncFrustumPlane(const mat4 M, uint k) {
    const vec4 r0 = vec4(M[0][0], M[1][0], M[2][0], M[3][0]);
    const vec4 r1 = vec4(M[0][1], M[1][1], M[2][1], M[3][1]);
    const vec4 r2 = vec4(M[0][2], M[1][2], M[2][2], M[3][2]);
    const vec4 r3 = vec4(M[0][3], M[1][3], M[2][3], M[3][3]);
    if      (k == 0u) return r3 + r0;
    else if (k == 1u) return r3 - r0;
    else if (k == 2u) return r3 + r1;
    else if (k == 3u) return r3 - r1;
    else if (k == 4u) return r3 + r2;
    return r3 - r2;
}
bool ncHiZOccluded(const mat4 M, vec3 c, float r, vec2 hiz_size, float hiz_mips) {
    vec2  ndc_min = vec2( 1.0);
    vec2  ndc_max = vec2(-1.0);
    float ndc_z_near = 1.0;
    for (int i = 0; i < 8; ++i) {
        const vec3 cw = c + r * vec3(
            ((i & 1) != 0) ?  1.0 : -1.0,
            ((i & 2) != 0) ?  1.0 : -1.0,
            ((i & 4) != 0) ?  1.0 : -1.0);
        const vec4 cc = M * vec4(cw, 1.0);
        if (cc.w <= 1e-4) return false;
        const vec3 nd = cc.xyz / cc.w;
        ndc_min = min(ndc_min, nd.xy);
        ndc_max = max(ndc_max, nd.xy);
        ndc_z_near = min(ndc_z_near, nd.z);
    }
    if (ndc_z_near < 0.0) return false;
    const vec2 uv_min = max(ndc_min * 0.5 + 0.5, vec2(0.0));
    const vec2 uv_max = min(ndc_max * 0.5 + 0.5, vec2(1.0));
    if (uv_max.x <= uv_min.x || uv_max.y <= uv_min.y) return false;
    const vec2  aabb_px = (uv_max - uv_min) * hiz_size;
    const float max_dim = max(aabb_px.x, aabb_px.y);
    if (min(aabb_px.x, aabb_px.y) < 0.5 && max_dim < 2.0) return false;
    float mip = clamp(ceil(log2(max(max_dim * 0.5, 1.0))), 0.0, hiz_mips - 1.0);
    const float pyramid_max_z = max(
        max(textureLod(hiz_pyramid, vec2(uv_min.x, uv_min.y), mip).r,
            textureLod(hiz_pyramid, vec2(uv_min.x, uv_max.y), mip).r),
        max(textureLod(hiz_pyramid, vec2(uv_max.x, uv_min.y), mip).r,
            textureLod(hiz_pyramid, vec2(uv_max.x, uv_max.y), mip).r));
    const float bias = 1e-5 + ndc_z_near * 1e-4;
    return pyramid_max_z < 0.99999 && ndc_z_near > pyramid_max_z + bias;
}
// ── Plants on the cluster path (hand-off) ────────────────────────────
// Per record: the cluster renderer's plant TEMPLATE for the node's mesh
// (0xFFFFFFFF = none).  A surviving instance whose record has a
// template and whose root lies within params.eye_radius.w of the eye is
// NOT compacted for the drawable path: it becomes a job for
// plant_cluster_expand.comp (set 1), which rasterises it through the
// cluster pipeline next frame.  Over budget -> it stays on the drawable
// path, so nothing ever disappears.
layout(std430, set = 0, binding = 10) readonly buffer RecTemplateBuf { uint rec_template[]; };
layout(std430, set = 1, binding = 0) readonly buffer PlantParamsBuf { PlantJobParams plant; };
layout(std430, set = 1, binding = 1) buffer PlantCounterBuf         { uint plant_ctr[]; };
layout(std430, set = 1, binding = 2) writeonly buffer PlantJobBuf   { PlantExpandJob plant_jobs[]; };
layout(std430, set = 1, binding = 3) writeonly buffer PlantWorkBuf  { uvec2 plant_work[]; };
layout(std430, set = 1, binding = 4) readonly buffer PlantTemplateBuf { PlantTemplateInfo plant_templates[]; };
// Per source instance, two words (slot = frame id & 1): which frame
// handed this instance to the cluster path, and with which template(s).
// word = (frame id << 16) | (1 << (template & 15)).  The expand draws
// frame F's jobs in frame F+1, so every pass of frame F+1 skips exactly
// the instances stamped F (plant.drawn_frame) -- see PlantJobParams.
layout(std430, set = 0, binding = 11) buffer HandoffStampBuf { uint handoff_stamp[]; };
// ── Two-phase occlusion (NT_COMPACT_RETEST / NT_COMPACT_PHASE_B) ────────
// retest[]  : (rec, inst) of every instance Phase A's Hi-Z test rejected.
// pb_words[] : [0] retest count, [1 .. 1+cap) Phase B survivors per record,
//             [1+cap .. 1+2cap) node-level Phase A Hi-Z rejections
//             (node_table_cull.comp; cap = the host's record capacity,
//             which only that shader needs -- its pc.pad2).
layout(std430, set = 0, binding = 13) buffer RetestBuf  { uvec2 retest[]; };
layout(std430, set = 0, binding = 14) buffer PhaseBBuf  { uint pb_words[]; };

uint plantTemplateBit(uint t) { return 1u << (t & 15u); }

// Drawn by the cluster path THIS frame (a job appended last frame).
bool plantOwnedByClusters(uint rec, uint inst) {
    if (plant.drawn_frame == 0u) return false;
    const uint t = rec_template[rec];
    if (t == 0xFFFFFFFFu) return false;
    const uint w = inst * 2u + (plant.drawn_frame & 1u);
    if (w >= uint(handoff_stamp.length())) return false;
    const uint v = handoff_stamp[w];
    return (v >> 16) == plant.drawn_frame && (v & plantTemplateBit(t)) != 0u;
}

// Record a successful hand-off for the frame after this one.  Several
// records can share an instance list (one per band / mesh), hence the
// CAS: a stale frame is replaced, the same frame accumulates bits.
void plantStampHandoff(uint inst, uint t) {
    const uint w = inst * 2u + (plant.handoff_frame & 1u);
    if (w >= uint(handoff_stamp.length())) return;
    const uint bit = plantTemplateBit(t);
    uint old = handoff_stamp[w];
    for (uint it = 0u; it < 16u; ++it) {
        const uint want = ((old >> 16) == plant.handoff_frame)
            ? (old | bit) : ((plant.handoff_frame << 16) | bit);
        const uint seen = atomicCompSwap(handoff_stamp[w], old, want);
        if (seen == old) return;
        old = seen;
    }
}

// The hand-off test: a template for the node's mesh and a root within
// the radius.  Shared by the appending pass (G-buffer) and the passes
// that merely drop the same instances (forward-covered).
bool plantInHandoff(uint rec, const InstanceDataInfo d, const mat4 m) {
    if (plant.eye_radius.w <= 0.0) return false;
    // Adaptive radius (plant_cluster_expand.comp phase 2), <= the slider.
    const float r_adapt = uintBitsToFloat(plant_ctr[PLANT_CTR_RADIUS]);
    const float radius = (r_adapt > 0.0) ? min(r_adapt, plant.eye_radius.w)
                                         : plant.eye_radius.w;
    const uint t = rec_template[rec];
    if (t >= plant.template_count) return false;
    const mat3 r = mat3(d.mat_rot_0.xyz, d.mat_rot_1.xyz, d.mat_rot_2.xyz);
    const vec3 t_inst = vec3(d.mat_rot_0.w, d.mat_rot_1.w, d.mat_rot_2.w);
    const vec3 trans = r * m[3].xyz + t_inst;
    const vec3 dv = trans - plant.eye_radius.xyz;
    return dot(dv, dv) <= radius * radius;
}

// Returns true when the instance was handed to the cluster path.
bool plantHandOff(uint rec, const InstanceDataInfo d, const mat4 m, float age) {
    const uint t = rec_template[rec];
    // Composed transform: world = R_inst * (M_node * p) + t_inst, as
    // three rows (basis columns in .xyz, translation in .w).
    const mat3 r = mat3(d.mat_rot_0.xyz, d.mat_rot_1.xyz, d.mat_rot_2.xyz);
    const vec3 t_inst = vec3(d.mat_rot_0.w, d.mat_rot_1.w, d.mat_rot_2.w);
    const mat3 basis = r * mat3(m);
    const vec3 trans = r * m[3].xyz + t_inst;

    const PlantTemplateInfo tp = plant_templates[t];
    const uint c0 = atomicAdd(plant_ctr[PLANT_CTR_CLUSTERS], tp.cluster_count);
    if (c0 + tp.cluster_count > plant.cluster_cap) { atomicAdd(plant_ctr[PLANT_CTR_DROPPED], 1u); return false; }
    const uint v0 = atomicAdd(plant_ctr[PLANT_CTR_VERTICES], tp.vertex_count);
    if (v0 + tp.vertex_count > plant.vertex_cap)   { atomicAdd(plant_ctr[PLANT_CTR_DROPPED], 1u); return false; }
    const uint j = atomicAdd(plant_ctr[PLANT_CTR_JOBS], 1u);
    if (j >= plant.job_cap)                        { atomicAdd(plant_ctr[PLANT_CTR_DROPPED], 1u); return false; }
    const uint w0 = atomicAdd(plant_ctr[PLANT_CTR_WORK], tp.cluster_count);
    if (w0 + tp.cluster_count > plant.work_cap)    { atomicAdd(plant_ctr[PLANT_CTR_DROPPED], 1u); return false; }

    PlantExpandJob job;
    job.row0 = vec4(basis[0], trans.x);
    job.row1 = vec4(basis[1], trans.y);
    job.row2 = vec4(basis[2], trans.z);
    job.template_idx = t;
    job.dyn_cluster_first = plant.dyn_cluster_first + c0;
    job.dyn_vertex_first  = plant.dyn_vertex_first + v0;
    job.flags = ((records[rec].flip_uv_coord & MODEL_FLAG_VEGETATION_SWAY) != 0u) ? PLANT_JOB_SWAY : 0u;
    job.tree_age = age;
    job.plant_bits = records[rec].debug_skip_skinning;
    job.pad0 = 0u; job.pad1 = 0u;
    plant_jobs[j] = job;
    for (uint c = 0u; c < tp.cluster_count; ++c) plant_work[w0 + c] = uvec2(j, c);
    return true;
}

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.inst_total || pc.record_count == 0u) return;
    const bool phase_b = (pc.flags & NT_COMPACT_PHASE_B) != 0u;

    uint rec, inst;
    if (phase_b) {
        // One invocation per Phase A rejection; band + frustum passed
        // there, only the occlusion test is repeated (real depth now).
        if (gid >= pb_words[0]) return;
        rec  = retest[gid].x;
        inst = retest[gid].y;
    } else {
        // Which class entry owns this invocation: last e with prefix[e] <= gid.
        uint lo = 0u, hi = pc.record_count - 1u;
        while (lo < hi) {
            const uint mid = (lo + hi + 1u) >> 1u;
            if (class_prefix[pc.record_first + mid] <= gid) lo = mid; else hi = mid - 1u;
        }
        rec = class_idx[pc.record_first + lo];
        const uint k = gid - class_prefix[pc.record_first + lo];
        const NtCullInfo info0 = infos[rec];
        if (info0.prim_count == 0u) return;
        // The node's instance range, straight from its first command.
        const uint src = info0.cmd_ofs_u32;
        const uint n = min(cmd_src[src + 1u], info0.inst_cap);
        if (k >= n) return;
        inst = cmd_src[src + 4u] + k;
    }
    const NtCullInfo info = infos[rec];
    const InstanceDataInfo d = inst_src[inst];
    const mat4 m = records[rec].model_mat;

    // ── Per-instance LOD band (same expression base.vert used) ────────
    const uint ilod_bits = floatBitsToUint(records[rec].model_params_pad0);
    if (!phase_b && (pc.flags & NT_COMPACT_BAND_TEST) != 0u && ilod_bits != 0u) {
        const vec3 inst_t = (m * vec4(d.mat_rot_0.w, d.mat_rot_1.w, d.mat_rot_2.w, 1.0)).xyz;
        const float ilod_d = distance(inst_t.xz, pc.eye.xz);
        const float ilod_near = float((ilod_bits >> 16) & 0x7FFFu) * 0.25;
        const float ilod_far = float(ilod_bits & 0xFFFFu) * 0.25;
        if (!(ilod_d >= ilod_near && ilod_d < ilod_far)) return;
    }

    // ── Per-instance frustum (+ occlusion) ────────────────────────────
    const bool hiz = (pc.flags & NT_COMPACT_HIZ) != 0u;
    const uint plane_count = hiz ? 6u : min(pc.flags & 0xFFu, 6u);
    if (plane_count > 0u && (!phase_b || hiz)) {
        const mat3 r = mat3(d.mat_rot_0.xyz, d.mat_rot_1.xyz, d.mat_rot_2.xyz);
        const vec3 t = vec3(d.mat_rot_0.w, d.mat_rot_1.w, d.mat_rot_2.w);
        // Same order base.vert places a vertex in: the record matrix
        // first (mesh -> node space), THEN the instance basis and the
        // instance translation, which is already a world position.
        const vec3 c = r * (m * vec4(info.mesh_sphere.xyz, 1.0)).xyz + t;
        const float s_inst = max(length(r[0]), max(length(r[1]), length(r[2])));
        const float s_node = max(length(m[0].xyz), max(length(m[1].xyz), length(m[2].xyz)));
        // Margin for the wind sway, which displaces after this transform.
        const float rad = info.mesh_sphere.w * s_inst * s_node * 1.1 + 1.0;
        if (hiz) {
            const mat4 M = mat4(pc.planes[0], pc.planes[1], pc.planes[2], pc.planes[3]);
            if (!phase_b) {
                for (uint k = 0u; k < 6u; ++k) {
                    vec4 p = ncFrustumPlane(M, k);
                    const float n_len = length(p.xyz);
                    if (n_len < 1e-12) continue;          // degenerate (infinite far)
                    p /= n_len;
                    if (dot(p.xyz, c) + p.w < -rad) return;
                }
            }
            // Before the plant hand-off below: an occluded plant needs no
            // cluster job either.  (One the cluster path draws THIS frame
            // is not drawn here anyway, so returning early is consistent.)
            if (ncHiZOccluded(M, c, rad, pc.planes[4].xy, pc.planes[4].z)) {
                if (!phase_b && (pc.flags & NT_COMPACT_RETEST) != 0u) {
                    // Not dropped: Phase B decides against the real depth.
                    const uint slot_r = atomicAdd(pb_words[0], 1u);
                    if (slot_r < pc.inst_total) retest[slot_r] = uvec2(rec, inst);
                }
                return;
            }
        } else {
            for (uint p = 0u; p < plane_count; ++p) {
                if (dot(pc.planes[p].xyz, c) + pc.planes[p].w < -rad) return;
            }
        }
    }

    // Plants on the cluster path.  Two separate questions:
    //  1. Who draws this instance THIS frame?  The cluster path draws the
    //     jobs appended LAST frame (the expand runs before the cull), so
    //     the drawable path skips exactly the instances stamped with
    //     plant.drawn_frame -- in every camera pass, not only this one.
    //  2. (G-buffer pass only) hand it off for NEXT frame: append a job
    //     and stamp it with plant.handoff_frame.
    // Skipping on (2) instead of (1) -- what this used to do -- made the
    // two paths disagree whenever the handed-off set changed between
    // frames: a new instance was drawn by neither path for a frame, a
    // dropped one by both.  Over budget (a few dozen trees fit the
    // 96k-cluster tail) the winners are atomic-order random, so the set
    // changed EVERY frame: trees vanishing and doubling -- the flicker.
    if ((pc.flags & (NT_COMPACT_PLANT_HANDOFF | NT_COMPACT_PLANT_SKIP)) != 0u &&
        plant.eye_radius.w > 0.0) {
        const bool owned = plantOwnedByClusters(rec, inst);
        if ((pc.flags & NT_COMPACT_PLANT_HANDOFF) != 0u && plantInHandoff(rec, d, m) &&
            plantHandOff(rec, d, m, age_src[inst])) {
            plantStampHandoff(inst, rec_template[rec]);
        }
        if (owned) return;
    }

    uint slot;
    if (phase_b) {
        // Appended after Phase A's survivors of the same record.
        slot = rec_counts[rec] + atomicAdd(pb_words[1u + rec], 1u);
    } else {
        slot = atomicAdd(rec_counts[rec], 1u);
    }
    if (slot >= info.inst_cap) return;
    const uint dst = info.out_base + slot;
    inst_dst[dst] = d;
    age_dst[dst] = age_src[inst];
}
