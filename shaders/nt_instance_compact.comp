#version 450
#extension GL_ARB_separate_shader_objects : enable
// ── nt_instance_compact.comp — per-INSTANCE cull for the node table ───
// Runs before node_table_cull.comp, once per pass, over every instance
// of every record in the pass's survivor class.
//
// Why: a per-instance-band node (a plant "_lodtile_" of one band) owns
// the tile's FULL instance list.  Five bands overlap a 512 m tile, so
// the old path submitted every instance five times and base.vert threw
// four bands' worth away one VERTEX at a time -- every vertex fetched,
// every triangle assembled and clipped, in the prepass AND again in the
// G-buffer.  Here each instance is tested ONCE (band + frustum) and only
// the survivors are copied into a compact per-pass instance buffer; the
// cull then points each command at the record's compacted range.
//
// Non-banded records pass through unchanged (frustum test only), so one
// compact buffer can serve every command of the pass.
#include "global_definition.glsl.h"

layout(push_constant) uniform PC {
    NtCompactPushConstants pc;
};

layout(std430, set = 0, binding = 0) readonly buffer InfoBuf     { NtCullInfo infos[]; };
layout(std430, set = 0, binding = 1) readonly buffer CmdSrcBuf   { uint cmd_src[]; };
layout(std430, set = 0, binding = 2) readonly buffer ClassIdxBuf { uint class_idx[]; };
layout(std430, set = 0, binding = 3) readonly buffer PrefixBuf   { uint class_prefix[]; };
layout(std430, set = 0, binding = 4) readonly buffer RecordBuf   { ModelParams records[]; };
layout(std430, set = 0, binding = 5) readonly buffer InstSrcBuf  { InstanceDataInfo inst_src[]; };
layout(std430, set = 0, binding = 6) readonly buffer AgeSrcBuf   { float age_src[]; };
layout(std430, set = 0, binding = 7) writeonly buffer InstDstBuf { InstanceDataInfo inst_dst[]; };
layout(std430, set = 0, binding = 8) writeonly buffer AgeDstBuf  { float age_dst[]; };
layout(std430, set = 0, binding = 9) buffer RecCountBuf          { uint rec_counts[]; };
// ── Plants on the cluster path (hand-off) ────────────────────────────
// Per record: the cluster renderer's plant TEMPLATE for the node's mesh
// (0xFFFFFFFF = none).  A surviving instance whose record has a
// template and whose root lies within params.eye_radius.w of the eye is
// NOT compacted for the drawable path: it becomes a job for
// plant_cluster_expand.comp (set 1), which rasterises it through the
// cluster pipeline next frame.  Over budget -> it stays on the drawable
// path, so nothing ever disappears.
layout(std430, set = 0, binding = 10) readonly buffer RecTemplateBuf { uint rec_template[]; };
layout(std430, set = 1, binding = 0) readonly buffer PlantParamsBuf { PlantJobParams plant; };
layout(std430, set = 1, binding = 1) buffer PlantCounterBuf         { uint plant_ctr[]; };
layout(std430, set = 1, binding = 2) writeonly buffer PlantJobBuf   { PlantExpandJob plant_jobs[]; };
layout(std430, set = 1, binding = 3) writeonly buffer PlantWorkBuf  { uvec2 plant_work[]; };
layout(std430, set = 1, binding = 4) readonly buffer PlantTemplateBuf { PlantTemplateInfo plant_templates[]; };

// The hand-off test: a template for the node's mesh and a root within
// the radius.  Shared by the appending pass (G-buffer) and the passes
// that merely drop the same instances (forward-covered).
bool plantInHandoff(uint rec, const InstanceDataInfo d, const mat4 m) {
    if (plant.eye_radius.w <= 0.0) return false;
    const uint t = rec_template[rec];
    if (t >= plant.template_count) return false;
    const mat3 r = mat3(d.mat_rot_0.xyz, d.mat_rot_1.xyz, d.mat_rot_2.xyz);
    const vec3 t_inst = vec3(d.mat_rot_0.w, d.mat_rot_1.w, d.mat_rot_2.w);
    const vec3 trans = r * m[3].xyz + t_inst;
    const vec3 dv = trans - plant.eye_radius.xyz;
    return dot(dv, dv) <= plant.eye_radius.w * plant.eye_radius.w;
}

// Returns true when the instance was handed to the cluster path.
bool plantHandOff(uint rec, const InstanceDataInfo d, const mat4 m, float age) {
    const uint t = rec_template[rec];
    // Composed transform: world = R_inst * (M_node * p) + t_inst, as
    // three rows (basis columns in .xyz, translation in .w).
    const mat3 r = mat3(d.mat_rot_0.xyz, d.mat_rot_1.xyz, d.mat_rot_2.xyz);
    const vec3 t_inst = vec3(d.mat_rot_0.w, d.mat_rot_1.w, d.mat_rot_2.w);
    const mat3 basis = r * mat3(m);
    const vec3 trans = r * m[3].xyz + t_inst;

    const PlantTemplateInfo tp = plant_templates[t];
    const uint c0 = atomicAdd(plant_ctr[PLANT_CTR_CLUSTERS], tp.cluster_count);
    if (c0 + tp.cluster_count > plant.cluster_cap) { atomicAdd(plant_ctr[PLANT_CTR_DROPPED], 1u); return false; }
    const uint v0 = atomicAdd(plant_ctr[PLANT_CTR_VERTICES], tp.vertex_count);
    if (v0 + tp.vertex_count > plant.vertex_cap)   { atomicAdd(plant_ctr[PLANT_CTR_DROPPED], 1u); return false; }
    const uint j = atomicAdd(plant_ctr[PLANT_CTR_JOBS], 1u);
    if (j >= plant.job_cap)                        { atomicAdd(plant_ctr[PLANT_CTR_DROPPED], 1u); return false; }
    const uint w0 = atomicAdd(plant_ctr[PLANT_CTR_WORK], tp.cluster_count);
    if (w0 + tp.cluster_count > plant.work_cap)    { atomicAdd(plant_ctr[PLANT_CTR_DROPPED], 1u); return false; }

    PlantExpandJob job;
    job.row0 = vec4(basis[0], trans.x);
    job.row1 = vec4(basis[1], trans.y);
    job.row2 = vec4(basis[2], trans.z);
    job.template_idx = t;
    job.dyn_cluster_first = plant.dyn_cluster_first + c0;
    job.dyn_vertex_first  = plant.dyn_vertex_first + v0;
    job.flags = ((records[rec].flip_uv_coord & MODEL_FLAG_VEGETATION_SWAY) != 0u) ? PLANT_JOB_SWAY : 0u;
    job.tree_age = age;
    job.plant_bits = records[rec].debug_skip_skinning;
    job.pad0 = 0u; job.pad1 = 0u;
    plant_jobs[j] = job;
    for (uint c = 0u; c < tp.cluster_count; ++c) plant_work[w0 + c] = uvec2(j, c);
    return true;
}

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.inst_total || pc.record_count == 0u) return;

    // Which class entry owns this invocation: last e with prefix[e] <= gid.
    uint lo = 0u, hi = pc.record_count - 1u;
    while (lo < hi) {
        const uint mid = (lo + hi + 1u) >> 1u;
        if (class_prefix[pc.record_first + mid] <= gid) lo = mid; else hi = mid - 1u;
    }
    const uint rec = class_idx[pc.record_first + lo];
    const uint k = gid - class_prefix[pc.record_first + lo];
    const NtCullInfo info = infos[rec];
    if (info.prim_count == 0u) return;

    // The node's instance range, straight from its first command.
    const uint src = info.cmd_ofs_u32;
    const uint n = min(cmd_src[src + 1u], info.inst_cap);
    if (k >= n) return;
    const uint inst = cmd_src[src + 4u] + k;
    const InstanceDataInfo d = inst_src[inst];
    const mat4 m = records[rec].model_mat;

    // ── Per-instance LOD band (same expression base.vert used) ────────
    const uint ilod_bits = floatBitsToUint(records[rec].model_params_pad0);
    if ((pc.flags & NT_COMPACT_BAND_TEST) != 0u && ilod_bits != 0u) {
        const vec3 inst_t = (m * vec4(d.mat_rot_0.w, d.mat_rot_1.w, d.mat_rot_2.w, 1.0)).xyz;
        const float ilod_d = distance(inst_t.xz, pc.eye.xz);
        const float ilod_near = float((ilod_bits >> 16) & 0x7FFFu) * 0.25;
        const float ilod_far = float(ilod_bits & 0xFFFFu) * 0.25;
        if (!(ilod_d >= ilod_near && ilod_d < ilod_far)) return;
    }

    // ── Per-instance frustum ──────────────────────────────────────────
    const uint plane_count = min(pc.flags & 0xFFu, 6u);
    if (plane_count > 0u) {
        const mat3 r = mat3(d.mat_rot_0.xyz, d.mat_rot_1.xyz, d.mat_rot_2.xyz);
        const vec3 t = vec3(d.mat_rot_0.w, d.mat_rot_1.w, d.mat_rot_2.w);
        // Same order base.vert places a vertex in: the record matrix
        // first (mesh -> node space), THEN the instance basis and the
        // instance translation, which is already a world position.
        const vec3 c = r * (m * vec4(info.mesh_sphere.xyz, 1.0)).xyz + t;
        const float s_inst = max(length(r[0]), max(length(r[1]), length(r[2])));
        const float s_node = max(length(m[0].xyz), max(length(m[1].xyz), length(m[2].xyz)));
        // Margin for the wind sway, which displaces after this transform.
        const float rad = info.mesh_sphere.w * s_inst * s_node * 1.1 + 1.0;
        for (uint p = 0u; p < plane_count; ++p) {
            if (dot(pc.planes[p].xyz, c) + pc.planes[p].w < -rad) return;
        }
    }

    // Plants on the cluster path: within the hand-off radius the
    // instance is expanded into cluster geometry instead of drawn here.
    if ((pc.flags & (NT_COMPACT_PLANT_HANDOFF | NT_COMPACT_PLANT_SKIP)) != 0u &&
        plantInHandoff(rec, d, m)) {
        if ((pc.flags & NT_COMPACT_PLANT_SKIP) != 0u) return;          // the G-buffer pass owns it
        if (plantHandOff(rec, d, m, age_src[inst])) return;             // over budget: falls through
    }

    const uint slot = atomicAdd(rec_counts[rec], 1u);
    if (slot >= info.inst_cap) return;
    const uint dst = info.out_base + slot;
    inst_dst[dst] = d;
    age_dst[dst] = age_src[inst];
}
