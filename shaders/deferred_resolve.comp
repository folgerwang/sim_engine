// 460 (not 450): GL_EXT_ray_query only registers its types/builtins on
// GLSL 4.60+, and the HW-RT variant of this shader ray-queries the
// cluster TLAS.  460 is a strict superset of 450 for everything else
// here, so the non-RT variant is unaffected.
#version 460
#extension GL_ARB_separate_shader_objects : enable
// For rt_base_color_textures[] — the alpha-cutoff test in rtShadowFactor
// indexes the texture array by a per-cluster material id (divergent).
#extension GL_EXT_nonuniform_qualifier : enable
#ifdef HW_RT_SHADOW
// HW-RT pipeline variant (deferred_resolve_hwrt_comp.spv): traces sun
// shadows with VK_KHR_ray_query against the cluster TLAS instead of the
// software BVH.  Compiled with --target-env=vulkan1.2.
#extension GL_EXT_ray_query : enable
#endif
#include "global_definition.glsl.h"
#include "functions.glsl.h"
#include "brdf.glsl.h"   // D_GGX / V_GGX / F_Schlick for the PBR resolve

// ─── deferred_resolve.comp ────────────────────────────────────────────────
// Phase 1 deferred lighting compute.
//
// Reads the 3-RT G-buffer + depth written by the cluster bindless GBUFFER
// pipeline and runs the same lighting math that cluster_bindless.frag's
// forward path runs (Lambertian sun direct + Blinn-Phong specular + a
// single-cascade CSM shadow + Lambertian IBL ambient).  The lit colour is
// linearTosRGB-encoded to match the forward path's tone-map exactly so
// switching deferred ON/OFF does not visibly shift colour.
//
// Pixels whose depth equals 1.0 are sky/empty: we skip them and leave
// hdr_color_buffer_ untouched so the downstream sky envmap pass can paint
// over them.  This matches the forward path's depth-LEQUAL sky behaviour.
//
// Set bindings mirror the forward shaders:
//   set 0 = PBR globals (IBL cubes, BRDF LUTs, CSM array)
//   set 1 = view camera (inv_view_proj for world-pos reconstruction)
//   set 2 = G-buffer + HDR output (this file's local set)
//   set 3 = unused (kept for SKIN_PARAMS_SET symmetry with forward path)
//   set 4 = runtime lights (sun + cascade VPs / splits)

#include "ibl.glsl.h"   // declares set 0 IBL + direct_shadow_sampler

layout(std430, set = VIEW_PARAMS_SET, binding = VIEW_CAMERA_BUFFER_INDEX)
    readonly buffer CameraInfoBuffer {
    ViewCameraInfo camera_info;
};

layout(set = PBR_MATERIAL_PARAMS_SET, binding = 0)
    uniform sampler2D gbuf_albedo_ao;
layout(set = PBR_MATERIAL_PARAMS_SET, binding = 1)
    uniform sampler2D gbuf_normal_rough;
layout(set = PBR_MATERIAL_PARAMS_SET, binding = 2)
    uniform sampler2D gbuf_emissive_metal;
layout(set = PBR_MATERIAL_PARAMS_SET, binding = 3)
    uniform sampler2D gbuf_depth;
// HDR colour target — matches the application's main scene colour buffer
// format (B10G11R11_UFLOAT_PACK32 → r11f_g11f_b10f in GLSL terms).  Must
// stay in sync with hdr_format_ in application.h.
layout(set = PBR_MATERIAL_PARAMS_SET, binding = 4, r11f_g11f_b10f)
    uniform writeonly image2D hdr_out;
// G-buffer RT3 — screen-space NDC velocity.  Only sampled by the
// DEBUG_RENDER_MODE_VELOCITY visualisation below; the real lighting math
// doesn't need it.
layout(set = PBR_MATERIAL_PARAMS_SET, binding = 5)
    uniform sampler2D gbuf_velocity;
// Full-pyramid Hi-Z sampled view — mip 0 is half-res of the scene depth
// max-reduced to be conservative-far.  Sampled only by the
// DEBUG_RENDER_MODE_HIZ visualisation; the regular lighting path
// ignores it.  textureLod(hiz_pyramid, uv, mip) picks the level the
// menu's mip slider chose (packed into camera_info.input_features bits
// 24..27).
layout(set = PBR_MATERIAL_PARAMS_SET, binding = 6)
    uniform sampler2D hiz_pyramid;

layout(set = RUNTIME_LIGHTS_PARAMS_SET, binding = RUNTIME_LIGHTS_CONSTANT_INDEX)
    uniform RuntimeLightsUniformBufferObject {
    RuntimeLightsParams runtime_lights;
};

// ─── Software-RT shadow data (world-space raytraced shadows) ─────────
// Bound by the app from ClusterRenderer's rt_shadow_desc_set_ — the same
// merged cluster geometry the bindless raster path draws, plus a CPU-
// built BVH over cluster bounds.  Only statically reachable through
// rtShadowFactor(), which main() calls under FEATURE_INPUT_RT_SHADOW.
#define RT_SHADOW_DATA_SET (RUNTIME_LIGHTS_PARAMS_SET + 1)
layout(std430, set = RT_SHADOW_DATA_SET, binding = 0) readonly buffer RtCullInfos {
    ClusterCullInfo rt_cull_infos[];
};
layout(std430, set = RT_SHADOW_DATA_SET, binding = 1) readonly buffer RtDrawInfos {
    ClusterDrawInfo rt_draw_infos[];
};
// Packed position + UV: vec4 = { position.xyz, packHalf2x16(uv) }.
// Built CPU-side in buildRtShadowBvh() from the merged vertex staging
// data.  ONE coalesced 16 B fetch per vertex instead of three floats
// scattered across the 24 B interleaved BindlessVertex stride (packed oct/half layout) (the
// dominant bandwidth cost of the triangle loop), and the UV rides along
// for free so alpha-cutoff casters can be texture-tested at the hit.
layout(std430, set = RT_SHADOW_DATA_SET, binding = 2) readonly buffer RtPosUv {
    vec4 rt_pos_uv[];
};
layout(std430, set = RT_SHADOW_DATA_SET, binding = 3) readonly buffer RtIndices {
    uint rt_indices[];
};
layout(std430, set = RT_SHADOW_DATA_SET, binding = 4) readonly buffer RtMaterials {
    BindlessMaterialParams rt_materials[];
};
layout(std430, set = RT_SHADOW_DATA_SET, binding = 5) readonly buffer RtBvhNodes {
    RtBvhNode rt_bvh_nodes[];
};
layout(std430, set = RT_SHADOW_DATA_SET, binding = 6) readonly buffer RtBvhLeaves {
    uint rt_bvh_leaf_clusters[];
};

// ─── ReSTIR direct lighting data (app-owned, set 2) ──────────────────
// binding 7: per-pixel reservoirs, TWO screen-sized halves back to back
//            (ping-pong: FEATURE_INPUT_RESTIR_PARITY selects read/write).
// binding 8: authored point lights (.rwlight scene objects), uploaded
//            every frame; header.x = light count.
layout(std430, set = PBR_MATERIAL_PARAMS_SET, binding = 7)
    buffer RestirReservoirBuf {
    RestirReservoir restir_reservoirs[];
};
layout(std430, set = PBR_MATERIAL_PARAMS_SET, binding = 8)
    readonly buffer RestirLightsBuf {
    uvec4            restir_light_header;   // x = light count
    RestirPointLight restir_lights[];
};

// ─── RT indirect diffuse (1-bounce GI) accumulation (binding 11) ─────
// vec4 = (irradiance-estimate RGB, history length).  TWO screen-sized
// halves ping-ponged by FEATURE_INPUT_RESTIR_PARITY, exactly like the
// DI reservoirs above — temporal reuse in the ReSTIR spirit: each
// frame's single-sample estimate is folded into the reprojected
// surviving history instead of being resampled from scratch.
// ── Glass / water attributes (bindings 12/13) ────────────────────────
// Written by the glass-attribute pass (window/door panes via
// base_frag_*_GLASS, river surfaces via tile_water_attr_frag) after the
// opaque G-buffer passes.  Cleared to 0 each frame; .a of the tint
// target is the KIND: 0 = nothing, 0.25+0.5*alpha = glass pane,
// 1.0 = water.  The overlay at the end of this shader ray-traces
// reflection AND refraction/transmission for these pixels.
layout(set = PBR_MATERIAL_PARAMS_SET, binding = 12)
    uniform sampler2D gbuf_glass_nr;     // octN.xy, view linZ (m), rough
layout(set = PBR_MATERIAL_PARAMS_SET, binding = 13)
    uniform sampler2D gbuf_glass_tint;   // tint.rgb, kind

layout(std430, set = PBR_MATERIAL_PARAMS_SET, binding = 11)
    buffer GiAccumBuf {
    vec4 gi_accum[];
};

// ─── RT shadow/AO smoothing (three-dispatch flow) ─────────────────────
// pass_mode 1 (GEN):   trace shadow+AO only, store raw (shad, ao) into
//                      rt_raw_out, skip all shading.
// (rt_filter.comp then runs an edge-aware bilateral blur raw→filtered.)
// pass_mode 2 (APPLY): skip tracing; read the FILTERED (shad, ao) from
//                      rt_filtered_in and run the full shading.
// pass_mode 0:         legacy single dispatch (trace + shade, no filter).
layout(push_constant) uniform ResolvePC {
    uint pass_mode;
} rpc;
layout(set = PBR_MATERIAL_PARAMS_SET, binding = 9, rg16f)
    uniform writeonly image2D rt_raw_out;
layout(set = PBR_MATERIAL_PARAMS_SET, binding = 10, rg16f)
    uniform readonly image2D rt_filtered_in;

// ── "no measurement here" sentinel for the smooth chain ──────────────
// GEN only traces rays for DEFERRED pixels.  Sky pixels and every
// FORWARD-shaded pixel (grass, hair, ground clutter, water — anything
// whose albedo_ao.a sentinel is < 0.5) exit before any ray is cast, and
// they still have to write SOMETHING into the raw target or the à-trous
// pass reads uninitialised texels.
//
// That "something" used to be (1.0, 1.0): fully lit, fully open.  It is
// the single worst value that could have been chosen.  rt_filter.comp
// rejects a neighbour only when its DEPTH says sky (zq >= 1.0), and a
// forward pixel is not sky — a grass blade standing 10 cm above the sand
// passes the depth-similarity weight at essentially full strength.  So
// every forward pixel was injecting a hard "unshadowed, unoccluded" vote
// into its deferred neighbours, and three à-trous iterations at tap
// spacing 1/2/4 spread that vote over a ~29x29 footprint.  In any
// vegetated area the terrain's traced shadow and AO were being averaged
// toward 1.0 by pixels that were never traced at all — the ground went
// flat and blew out, and only in the RT modes, because the GEN/filter/
// APPLY chain does not exist on the CSM path.
//
// rg16f is SIGNED, so a negative value is free and unambiguous: no real
// visibility term can be < 0.  rt_filter.comp skips these taps entirely
// and passes them through untouched, so they survive all three
// iterations and never contaminate anything.  APPLY never reads one —
// it early-outs on the same two conditions that write it.
const float RT_SMOOTH_INVALID = -1.0;
// Base-colour textures — the SAME views the bindless raster set exposes,
// re-written onto this COMPUTE-visible set by buildRtShadowBvh().
// Sampled ONLY on alpha-masked triangle hits so foliage / fence cards
// shadow by their texture silhouette instead of their full quad
// (parity with the raster CSM path's alpha-cutoff fragment shader).
layout(set = RT_SHADOW_DATA_SET, binding = 7)
    uniform sampler2D rt_base_color_textures[MAX_CLUSTER_TEXTURES];
// ── RT-shadow skeleton casters (skinned characters) ──────────────────
// Written per frame by ClusterRenderer::updateRtSkeletons (CPU-skinned
// WORLD-space positions).  The software path (rtShadowFactor) tests
// skeleton AABB → chunk AABB → triangles; the hardware path gets the
// same geometry through its own skeleton BLAS instance in the TLAS.
layout(std430, set = RT_SHADOW_DATA_SET, binding = 8)
    readonly buffer RtSkelHeaders {
    uvec4        rt_skel_counts;    // x = skeleton count
    RtSkelHeader rt_skel_headers[];
};
layout(std430, set = RT_SHADOW_DATA_SET, binding = 9)
    readonly buffer RtSkelChunks {
    vec4 rt_skel_chunks[];          // AABB min/max pairs per chunk
};
layout(std430, set = RT_SHADOW_DATA_SET, binding = 10)
    readonly buffer RtSkelPositions {
    vec4 rt_skel_pos[];             // skinned world positions
};
layout(std430, set = RT_SHADOW_DATA_SET, binding = 11)
    readonly buffer RtSkelIndices {
    uint rt_skel_indices[];         // triangle list (global vertex ids)
};

#ifdef HW_RT_SHADOW
// ─── Hardware-RT shadow data (ray query) ─────────────────────────────
// Bound from ClusterRenderer's hw_rt_desc_set_ — only in the HW-RT
// pipeline variant, and only dispatched when hwRtShadowReady(), so no
// dummy TLAS is ever required.
//   0  TLAS over the merged cluster geometry (geom 0 opaque, geom 1
//      alpha-masked / non-opaque)
//   1  masked geometry's index buffer (GLOBAL vertex ids — same ids
//      rt_pos_uv[] uses, so hit UVs come from the packed buffer)
//   2  per-masked-triangle material id (into rt_materials[])
#define HW_RT_SHADOW_DATA_SET (RT_SHADOW_DATA_SET + 1)
layout(set = HW_RT_SHADOW_DATA_SET, binding = 0)
    uniform accelerationStructureEXT hw_rt_tlas;
layout(std430, set = HW_RT_SHADOW_DATA_SET, binding = 1)
    readonly buffer HwRtMaskedIndices {
    uint hw_rt_masked_indices[];
};
layout(std430, set = HW_RT_SHADOW_DATA_SET, binding = 2)
    readonly buffer HwRtMaskedTriMats {
    uint hw_rt_masked_tri_mat[];
};
//   3  opaque geometry's index buffer (GLOBAL vertex ids, like binding 1)
//   4  per-opaque-triangle material id (into rt_materials[])
// Needed by the CLOSEST-HIT GI ray (hwRtGiRadiance): unlike the any-hit
// shadow query, a committed GI hit on the opaque geometry must recover
// its triangle (normal) + material (albedo) — the shadow-only bindings
// above cover masked candidates only.
layout(std430, set = HW_RT_SHADOW_DATA_SET, binding = 3)
    readonly buffer HwRtOpaqueIndices {
    uint hw_rt_opaque_indices[];
};
layout(std430, set = HW_RT_SHADOW_DATA_SET, binding = 4)
    readonly buffer HwRtOpaqueTriMats {
    uint hw_rt_opaque_tri_mat[];
};
#endif

// Octahedral decode — companion of the encode in cluster_bindless.frag
// (GBUFFER_OUTPUT branch).  Maps a 2D unit-square coordinate back onto a
// unit sphere with no singularities and ~7 bits of angular precision per
// channel — adequate for diffuse + low-spec lighting at RGBA8 storage.
vec3 octDecode(vec2 f) {
    f = f * 2.0 - 1.0;
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = max(-n.z, 0.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

// ─── PCSS soft-shadow constants ────────────────────────────────────
// All distances are in WORLD UNITS so that the physical blur radius is
// consistent across cascade transitions.  Per-cascade conversion to
// shadow-map UV uses w2uv = 0.5 * length(light_view_proj[c][0].xyz),
// which is the orthographic projection's world→clip scale folded into
// the [-1,1]→[0,1] UV remap.  See shadowFactor() below.
const float CSM_NORMAL_BIAS_SCALE     = 0.05;
// Depth bias in WORLD units (meters along the light's Z axis).  The
// shader converts to per-cascade clip-Z by multiplying by the cascade's
// Z-scale factor (1 / (far - near)) extracted from the projection
// matrix.  Without this conversion, a constant clip-Z bias would
// represent (far - near) wildly different world distances per cascade
// — coarser cascades would silently apply 5–10× more bias than fine
// ones, producing a visible step in shadow intensity at cascade
// boundaries.
const float CSM_DEPTH_BIAS_BASE_WORLD  = 0.05;   // ~5 cm
const float CSM_DEPTH_BIAS_SLOPE_WORLD = 0.20;   // ~20 cm at grazing
// PCSS sun apparent half-size in world units.  Drives penumbra width
// proportional to caster→receiver distance.  Real sun is ~0.005 (= a
// few cm at 10 m caster distance) but we exaggerate for visible
// softness.  Tunable.
const float CSM_LIGHT_SIZE_WORLD      = 0.10;   // halved: tighter penumbra, less visible dither
// Blocker search disk radius in world units — wider catches more
// distant blockers and produces smoother penumbras at the cost of
// more incoherent texture fetches.
const float CSM_BLOCKER_RADIUS_WORLD  = 0.20;   // halved with light size
// Min/max PCF radius caps in world units.  Min keeps a small soft
// fringe even on tight contact (anti-banding); max stops kernels from
// blowing up to read outside the cascade on very tall casters.
const float CSM_MIN_PCF_RADIUS_WORLD  = 0.02;
const float CSM_MAX_PCF_RADIUS_WORLD  = 0.40;   // halved with light size

const float CSM_RANGE_FADE_START      = 0.85;  // fade shadows out over the last 15% of CSM range
const int   CSM_BLOCKER_SAMPLES       = 16;
const int   CSM_PCF_SAMPLES           = 16;

// Vogel disk: ~uniform low-discrepancy distribution of N points in a
// unit disk.  Per-pixel rotation phi de-correlates neighbouring
// pixels' kernels so the soft edge is dithered rather than visibly
// banded.  Golden-angle index ensures even coverage at any prefix.
vec2 csmVogelDisk(int i, int n, float phi) {
    const float GOLDEN_ANGLE = 2.39996323;  // ~137.5°
    float r     = sqrt((float(i) + 0.5) / float(n));
    float theta = GOLDEN_ANGLE * float(i) + phi;
    return vec2(r * cos(theta), r * sin(theta));
}

// Interleaved Gradient Noise (Jorge Jimenez, CoD AW).  Cheap
// per-pixel hash giving clean dither without a noise texture.
float csmIGN(vec2 pixel) {
    return fract(52.9829189 *
                 fract(dot(pixel, vec2(0.06711056, 0.00583715))));
}

// ── CSM coverage helpers (out-of-range handling) ─────────────────────
// Fetch one shadow-map texel, treating anything outside the cascade's
// [0,1] UV box as "nothing between this point and the light".
//
// The shadow sampler is CLAMP_TO_EDGE and the CSM silhouette prepass
// clears the map to 0.0 outside each cascade's camera-frustum
// silhouette, so an out-of-bounds read returns 0.0 = "an occluder sits
// right at the light" — the blocker search then finds a fake blocker
// and the receiver resolves fully black.  Two places hit that path:
// border taps of the LAST cascade (no cascade left to be promoted
// into), and every receiver past the CSM's max range, whose projection
// lands far outside the last cascade's box.  The latter is what turns
// the whole far field (last split → camera far plane) black behind a
// hard, camera-dependent boundary.  With no data out there, "lit" is
// the only honest answer.
float csmSampleMap(vec2 tap_uv, int cascade) {
    if (any(lessThan(tap_uv, vec2(0.0))) ||
        any(greaterThan(tap_uv, vec2(1.0))))
        return 1.0;
    return texture(direct_shadow_sampler, vec3(tap_uv, float(cascade))).r;
}

// View-space distance at which the CSM runs out of data — the last
// cascade's far split (cascade_splits is packed vec4[2]).
float csmMaxRange() {
    return runtime_lights.cascade_splits[(CSM_CASCADE_COUNT - 1) >> 2]
                                        [(CSM_CASCADE_COUNT - 1) & 3];
}

// 0 well inside the covered range → 1 at/past the last split.  Fading
// the shadow term to fully lit across the tail of the last cascade
// keeps the edge of shadow coverage from reading as a visible ring.
float csmRangeFade(float view_depth) {
    float max_range  = csmMaxRange();
    float fade_begin = max_range * CSM_RANGE_FADE_START;
    return clamp((view_depth - fade_begin) /
                 max(max_range - fade_begin, 1e-4), 0.0, 1.0);
}

// ─── Software screen-space raytraced sun shadows ────────────────────
// FEATURE_INPUT_SSRT_SHADOW: instead of sampling the CSM cascade array,
// march a ray from the pixel's reconstructed world position toward the
// sun THROUGH SCREEN SPACE, testing each step against the G-buffer
// depth.  Pure compute + depth reads — no RT hardware, no shadow-map
// rendering at all (the app skips the whole CSM pass in this mode).
//
// Inherent limits (accepted for this experiment):
//   • only occluders VISIBLE ON SCREEN can cast shadows — geometry
//     behind the camera or off-frame casts nothing;
//   • the depth buffer is a single layer, so occluder thickness is a
//     heuristic (kSsrtThickness) — very thick objects can leak light
//     when the ray passes "behind" their visible front shell.
const int   SSRT_STEPS         = 24;     // depth taps per pixel
const float SSRT_MAX_DIST      = 12.0;   // world meters of caster search
const float SSRT_THICKNESS     = 0.40;   // occluder thickness heuristic (m)
const float SSRT_SURFACE_BIAS  = 0.03;   // self-intersection guard (m)

// ─── World-space software raytraced sun shadows ──────────────────────
// FEATURE_INPUT_RT_SHADOW: trace the pixel's sun ray through the CPU-
// built cluster BVH and Möller–Trumbore-test the triangles of every
// intersected cluster.  TRUE world-space occlusion: casters do not need
// to be on screen.  Pure compute — this is the "software RT" datapoint
// to compare against CSM ("CSM Shadow" scope goes to ~0; this cost lands
// in "Deferred Resolve Compute").
const float RT_SHADOW_MAX_DIST = 300.0;  // caster search range (m)
const float RT_SHADOW_BIAS     = 0.03;   // launch offset (m)
const int   RT_BVH_STACK_SIZE  = 48;
// Transparent-texel hit budget per ray.  Correct alpha-cutoff handling
// means a ray no longer terminates on the first foliage card it grazes —
// through dense vegetation it can march hundreds of triangles + texture
// samples.  After this many transparent hits the ray is, for sun-shadow
// purposes, inside a canopy: call it occluded and stop.  Bounds the
// worst case at a bias that over-darkens (never light-leaks).
const int   RT_ALPHA_HIT_BUDGET = 8;

// ── Soft shadows (both RT modes) ─────────────────────────────────────
// The sun is a disk, not a point: each shadow ray gets a random
// direction inside a cone around L, so penumbras widen with caster
// distance (contact-hardening comes free).  Multiple jittered rays are
// averaged; the IGN dither decorrelates neighbouring pixels so the
// residual noise reads as grain rather than banding.
// RT_SUN_TAN_RADIUS is tan(angular radius): the real sun is ~0.0047
// (0.27°); the default is padded for a visibly soft edge.  Set the
// sample counts to 1 for the old hard shadows.
const float RT_SUN_TAN_RADIUS      = 0.006;  // was 0.01 — tighter cone, less dither spread
// Multi-ray, single-frame sampling (no temporal accumulation): the IGN
// dither pattern is STATIC per pixel, so the result is a stable ordered
// dither rather than animated noise.  Doubled from 4/2: more rays = more
// discrete visibility levels per pixel, which the à-trous smooth pass
// then blends into clean penumbra ramps (fewer levels = residual bands).
const int   RT_SOFT_SAMPLES_HW     = 8;   // hardware ray query — cheap rays
const int   RT_SOFT_SAMPLES_SW     = 4;   // software BVH walk — pricey rays

// Random direction in the sun cone: xi in [0,1)^2, concentric disk via
// sqrt, oriented on an L-orthonormal basis.
vec3 rtSunConeDir(vec3 L, vec2 xi) {
    vec3 t = (abs(L.z) < 0.999)
                 ? normalize(cross(L, vec3(0.0, 0.0, 1.0)))
                 : vec3(1.0, 0.0, 0.0);
    vec3 b = cross(L, t);
    float r   = RT_SUN_TAN_RADIUS * sqrt(xi.x);
    float phi = 6.28318530718 * xi.y;
    return normalize(L + r * (cos(phi) * t + sin(phi) * b));
}

// ── Ray-traced ambient occlusion (FEATURE_INPUT_RT_AO) ───────────────
// Short cosine-weighted hemisphere rays traced with whichever RT
// backend this pipeline variant uses.  Replaces the screen-space SSAO
// post pass while an RT shadow mode is active: true world-space AO —
// off-screen and behind-camera geometry occludes correctly.
const float RT_AO_RADIUS     = 2.0;   // occluder search range (m)
const int   RT_AO_SAMPLES_HW = 4;
const int   RT_AO_SAMPLES_SW = 2;
// Response shaping.  The raw factor is a linear visibility average,
// which reads weak — the power curve deepens partial occlusion (corners,
// under-awning, contact regions) without crushing open areas.
const float RT_AO_POWER = 2.0;
// SSAO-parity: the old screen-space pass multiplied the FINAL colour,
// so it also dimmed sunlit pixels.  Pure ambient-only AO is physically
// nicer but far subtler; this fraction lets RT AO dim direct light too.
// 0 = ambient-only (physical), 1 = full SSAO-style darkening.
const float RT_AO_DIRECT_FRACTION = 0.4;

// Cosine-weighted hemisphere direction around n (xi in [0,1)^2).
vec3 rtCosHemisphereDir(vec3 n, vec2 xi) {
    vec3 t = (abs(n.z) < 0.999)
                 ? normalize(cross(n, vec3(0.0, 0.0, 1.0)))
                 : vec3(1.0, 0.0, 0.0);
    vec3 b = cross(n, t);
    float r   = sqrt(xi.x);
    float phi = 6.28318530718 * xi.y;
    float z   = sqrt(max(0.0, 1.0 - xi.x));
    return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * z);
}

// Slab test vs node AABB.  inv_dir precomputed by the caller; returns
// true when the ray's [0, t_max] interval overlaps the box.
bool rtRayAabb(vec3 ro, vec3 inv_dir, float t_max, vec3 bmin, vec3 bmax) {
    vec3 t0 = (bmin - ro) * inv_dir;
    vec3 t1 = (bmax - ro) * inv_dir;
    vec3 tmin3 = min(t0, t1);
    vec3 tmax3 = max(t0, t1);
    float t_enter = max(max(tmin3.x, tmin3.y), tmin3.z);
    float t_exit  = min(min(tmax3.x, tmax3.y), tmax3.z);
    return t_exit >= max(t_enter, 0.0) && t_enter <= t_max;
}

// Möller–Trumbore, double-sided, any-hit semantics.  Barycentrics (u, v)
// are returned so alpha-masked hits can interpolate the vertex UVs and
// texture-test the cutoff.
bool rtRayTri(vec3 ro, vec3 rd, float t_max, vec3 v0, vec3 v1, vec3 v2,
              out float o_u, out float o_v) {
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    vec3 pv = cross(rd, e2);
    float det = dot(e1, pv);
    if (abs(det) < 1e-8) return false;
    float inv_det = 1.0 / det;
    vec3 tv = ro - v0;
    float u = dot(tv, pv) * inv_det;
    if (u < 0.0 || u > 1.0) return false;
    vec3 qv = cross(tv, e1);
    float v = dot(rd, qv) * inv_det;
    if (v < 0.0 || u + v > 1.0) return false;
    float t = dot(e2, qv) * inv_det;
    o_u = u;
    o_v = v;
    return t > RT_SHADOW_BIAS && t < t_max;
}

// One ray (origin + direction, bounded by t_max) vs the static cluster
// BVH + the skeleton casters.  Returns 1.0 unoccluded / 0.0 occluded.
// Shadow rays pass RT_SHADOW_MAX_DIST; AO rays pass RT_AO_RADIUS.
float rtShadowRayVisible(vec3 ro, vec3 rd, float t_max) {
    vec3 inv_dir = 1.0 / rd;   // GLSL inf per component when rd axis == 0 — fine for the slab test

    uint stack[RT_BVH_STACK_SIZE];
    int  sp = 0;
    stack[sp++] = 0u;   // root
    int alpha_hits = 0;     // transparent-texel hits so far (budgeted)

    while (sp > 0) {
        RtBvhNode node = rt_bvh_nodes[stack[--sp]];
        if (!rtRayAabb(ro, inv_dir, t_max,
                       node.aabb_min, node.aabb_max)) continue;

        if (node.prim_count == 0u) {
            // Inner node: children are adjacent (left, left+1).
            if (sp + 2 <= RT_BVH_STACK_SIZE) {
                stack[sp++] = node.left_first;
                stack[sp++] = node.left_first + 1u;
            }
            continue;
        }

        // Leaf: test each referenced cluster's triangles.
        for (uint p = 0u; p < node.prim_count; ++p) {
            uint cluster_idx = rt_bvh_leaf_clusters[node.left_first + p];

            // Cheap sphere reject before touching triangle data.
            vec4 bs = rt_cull_infos[cluster_idx].bounds_sphere;
            vec3 oc = bs.xyz - ro;
            float t_ca = dot(oc, rd);
            float d2 = dot(oc, oc) - t_ca * t_ca;
            if (t_ca < -bs.w || t_ca - bs.w > t_max ||
                d2 > bs.w * bs.w) continue;

            ClusterDrawInfo draw = rt_draw_infos[cluster_idx];
            // Translucent clusters don't occlude the sun (matches the
            // raster shadow path, which skips them at cull time).
            BindlessMaterialParams m = rt_materials[draw.material_idx];
            uint mflags = uint(m.flags);
            if ((mflags & BINDLESS_MAT_TRANSLUCENT) != 0u) continue;

            // Alpha-cutoff casters (foliage, fences, decals): a geometric
            // hit is only an occluder if the base-colour texel at the hit
            // point passes the cutoff — otherwise the ray continues
            // through the transparent part of the card.  Matches the
            // raster CSM path, which runs those materials through the
            // alpha-test fragment shader.
            bool masked = (mflags & BINDLESS_MAT_ALPHA_MASK) != 0u;
            if (masked && m.base_color_tex_idx < 0) {
                // No texture — the constant factor decides for the whole
                // cluster: below the cutoff nothing here ever occludes.
                if (m.base_color_factor.a < m.alpha_cutoff) continue;
                masked = false;   // at/above cutoff: behaves opaque
            }

            uint tri_count = draw.index_count / 3u;
            for (uint t = 0u; t < tri_count; ++t) {
                uint i0 = rt_indices[draw.index_offset + t * 3u + 0u]
                          + draw.vertex_offset;
                uint i1 = rt_indices[draw.index_offset + t * 3u + 1u]
                          + draw.vertex_offset;
                uint i2 = rt_indices[draw.index_offset + t * 3u + 2u]
                          + draw.vertex_offset;
                vec4 p0 = rt_pos_uv[i0];
                vec4 p1 = rt_pos_uv[i1];
                vec4 p2 = rt_pos_uv[i2];
                float hu, hv;
                if (!rtRayTri(ro, rd, t_max,
                              p0.xyz, p1.xyz, p2.xyz, hu, hv)) {
                    continue;
                }
                if (!masked) return 0.0;   // opaque hit — occluded

                // Interpolate UV at the hit and alpha-test the texel.
                vec2 uv0 = unpackHalf2x16(floatBitsToUint(p0.w));
                vec2 uv1 = unpackHalf2x16(floatBitsToUint(p1.w));
                vec2 uv2 = unpackHalf2x16(floatBitsToUint(p2.w));
                vec2 huv = uv0 * (1.0 - hu - hv) + uv1 * hu + uv2 * hv;
                float a = textureLod(
                    rt_base_color_textures[
                        nonuniformEXT(m.base_color_tex_idx)],
                    huv, 0.0).a * m.base_color_factor.a;
                if (a >= m.alpha_cutoff) return 0.0;   // solid texel
                // Transparent texel — keep marching, but bounded: deep
                // inside vegetation the answer is "shadowed" anyway.
                if (++alpha_hits >= RT_ALPHA_HIT_BUDGET) return 0.0;
            }
        }
    }

    // ── Skeleton casters (skinned characters, CPU-skinned per frame) ──
    // Not part of the static BVH (they deform); a handful of characters
    // with per-skeleton + per-chunk AABB rejection keeps this cheap for
    // rays that don't pass near a character.  Always opaque.
    const uint skel_n = min(rt_skel_counts.x, uint(RT_SKEL_MAX));
    for (uint s = 0u; s < skel_n; ++s) {
        RtSkelHeader h = rt_skel_headers[s];
        if (!rtRayAabb(ro, inv_dir, t_max,
                       h.aabb_min.xyz, h.aabb_max.xyz)) continue;
        const uint chunk_n =
            (h.tri_count + uint(RT_SKEL_CHUNK_TRIS) - 1u) /
            uint(RT_SKEL_CHUNK_TRIS);
        for (uint c = 0u; c < chunk_n; ++c) {
            vec3 cmin = rt_skel_chunks[(h.chunk_offset + c) * 2u + 0u].xyz;
            vec3 cmax = rt_skel_chunks[(h.chunk_offset + c) * 2u + 1u].xyz;
            if (!rtRayAabb(ro, inv_dir, t_max, cmin, cmax))
                continue;
            const uint t0i = h.tri_offset + c * uint(RT_SKEL_CHUNK_TRIS);
            const uint t1i = min(h.tri_offset + h.tri_count,
                                 t0i + uint(RT_SKEL_CHUNK_TRIS));
            for (uint t = t0i; t < t1i; ++t) {
                float hu, hv;
                if (rtRayTri(ro, rd, t_max,
                             rt_skel_pos[rt_skel_indices[t * 3u + 0u]].xyz,
                             rt_skel_pos[rt_skel_indices[t * 3u + 1u]].xyz,
                             rt_skel_pos[rt_skel_indices[t * 3u + 2u]].xyz,
                             hu, hv)) {
                    return 0.0;   // opaque — occluded
                }
            }
        }
    }
    return 1.0;
}

// Soft sun shadow: average RT_SOFT_SAMPLES_SW cone-jittered rays.  The
// IGN pair is decorrelated per sample by golden-ratio-ish offsets so a
// 2-sample pixel doesn't reuse the same disk point.
// ─── RT indirect diffuse: 1-bounce GI radiance along one ray ─────────
// Closest-hit walk over the SAME cluster BVH the shadow rays traverse.
// On a miss the ray sees sky: sample the IBL RADIANCE cubemap
// (ggx_env_sampler, whose lower mips are the lightly prefiltered live
// sky) along the ray.  With cosine-distributed rays the per-sample
// radiance averages to exactly the E/pi the irradiance cube stores, so
// the calibration is unchanged — but unlike the old lambertian-cube
// fetch (irradiance re-sampled along one ray: doubly convolved, nearly
// direction-free) the estimator now actually SEES the sky's directional
// structure: a bright horizon, a sunset side, an overcast dome each
// push different GI, and the temporal history integrates the extra
// per-sample variance away.  On
// a hit, the bounce radiance is the hit surface's (mip-filtered) albedo
// lit by the sun — with a real occlusion ray from the hit point — plus
// a small sky leak so back-faces don't return pure black.  Skinned
// skeleton casters are skipped: a character's bounce contribution is
// not worth the per-pixel chunk walk.
const float RT_GI_MAX_DIST    = 120.0;  // bounce interval; sky beyond
const float RT_GI_NORMAL_BIAS = 0.05;   // metres off the surface
const float RT_GI_TEX_LOD     = 4.0;    // prefiltered albedo fetch
// Sky fetch mip in the GGX radiance chain: mip 0 is mirror-sharp sky,
// each mip a wider prefilter.  1.0 keeps the horizon/zenith structure
// that makes the GI directional while shaving the brightest-texel
// fireflies a raw fetch would feed the 1-spp estimator.
const float RT_GI_SKY_LOD     = 1.0;
const float RT_GI_SKY_LEAK    = 0.35;   // hit surface's own ambient
// Temporal history clamp.  1/RT_GI_HIST_MAX is the minimum blend factor
// of the fresh sample, so the effective history weight is capped at
// 1 - 1/16 = 0.9375 — inside the ~0.90-0.95 band where lighting changes
// still land within a third of a second.  Was 24 (0.958): visibly laggy
// ("temporal of ray tracing very noticeable") whenever the sun or the
// camera moved.
const float RT_GI_HIST_MAX    = 16.0;
// Disocclusion rejection threshold: relative linear-depth mismatch
// between the reprojected history texel's stored depth and this pixel's
// depth above which the history belongs to a DIFFERENT surface (edge
// revealed by camera/object motion) and must be dropped.  10% tolerates
// normal forward camera motion between frames while still catching
// foreground/background swaps, which are always a large depth jump.
const float RT_GI_DEPTH_REJECT = 0.10;
// ── Indirect-diffuse FLOOR ──────────────────────────────────────────
// Minimum fraction of the unoccluded sky irradiance that a deferred
// pixel keeps, no matter what the tracer returns.  This is a safety
// net, not a lighting model: a 1-spp estimator that returns ~0 on a
// surface which is plainly open to the sky is reporting a failure (a
// bad launch normal, a ray that started inside geometry, an
// acceleration structure that does not contain what the raster pass
// drew), and the honest response to a failed estimate is to fall back
// toward the value we know is an upper bound, not to paint the surface
// black.  0.30 keeps real occlusion contrast — a closed interior still
// reads much darker than open ground — while making pure black
// impossible.  Set to 0.0 to see the raw estimator again.
const float RT_GI_AMBIENT_FLOOR = 0.30;

// ═════════════════════════════════════════════════════════════════════
//  SCREEN-PROBE GI  (Lumen-style screen probe gather)
// ═════════════════════════════════════════════════════════════════════
//
// The per-pixel estimator above traces ONE cosine ray for EVERY shaded
// pixel — 2.07 M rays at 1080p, every frame, from 2.07 M *different*
// origins.  That is the single most expensive thing this resolve does,
// and it is mostly wasted: indirect diffuse is a low-frequency signal,
// so neighbouring pixels are integrating almost the same hemisphere.
//
// Unreal's Lumen answers this with a SCREEN PROBE GATHER, and that is
// what this block implements:
//
//   1. Place one probe per GI_PROBE_TILE x GI_PROBE_TILE pixel tile
//      (16x16), jittered inside its tile each frame so that over a few
//      frames the probes sweep the whole screen.
//   2. Each probe traces GI_OCTA_RES^2 (8x8 = 64) rays laid out on a
//      HEMI-OCTAHEDRAL map around the probe's geometric normal — a
//      structured, near-uniform-solid-angle direction set instead of a
//      random one, so the estimate is low-variance by construction.
//   3. The 64 radiance samples are temporally accumulated per texel
//      (probe-space reprojection through the velocity buffer, rejected
//      on plane/normal mismatch) and then projected to 2nd-order
//      spherical harmonics ONCE, in shared memory, by the same
//      workgroup that traced them.
//   4. Every pixel then reconstructs its irradiance by bilaterally
//      interpolating the SH of the 4 probes around it and evaluating
//      the Lambert-convolved SH in its own normal direction.  No rays.
//
// Ray budget: 64 rays / 256 pixels = 0.25 rays/pixel, a 4x reduction —
// and the surviving rays are FAR more coherent (one origin, one
// hemisphere fan per workgroup) which is worth another large factor on
// the hardware ray-query path.  The per-pixel cost that replaces the
// trace is 4 probe headers + 4x9 SH loads, all L2-resident.
//
// One workgroup (8x8 = 64 invocations) handles exactly one probe, so
// the octahedral texel index IS gl_LocalInvocationID.xy and the probe
// index IS gl_WorkGroupID.xy.  That identity is why the local size is
// not allowed to change.
const int   GI_PROBE_TILE  = 16;    // pixels per probe, both axes
const int   GI_OCTA_RES    = 8;     // hemi-octahedral atlas side
const int   GI_OCTA_TEXELS = GI_OCTA_RES * GI_OCTA_RES;   // = 64
// Longer than the per-pixel path's 16 (RT_GI_HIST_MAX): a probe's 64
// structured rays are already low-variance, so history here buys
// stability rather than convergence and can afford to be deeper.
const float GI_PROBE_HIST_MAX = 24.0;
// Reprojected-probe acceptance.  Tighter than the per-pixel depth test
// because the atlas is stored in the probe normal's TANGENT frame — a
// large normal change would reinterpret every texel.
const float GI_PROBE_N_ACCEPT = 0.95;   // cos(N_now, N_prev)
// Plane distance (metres) at which a neighbour probe's contribution has
// decayed to ~e^-1 during the gather, expressed as a fraction of view
// depth.  0.02 * z is roughly one probe spacing for a 60 deg vertical
// FOV at 1080p, so this is "one tile away from my plane".
const float GI_PROBE_PLANE_K  = 0.02;

// ── gi_accum sub-allocation ─────────────────────────────────────────
// The screen-probe path reuses the SAME storage buffer the per-pixel
// accumulator uses (2 * W * H vec4), because it needs far less of it:
//   atlas   2 * n * 64  vec4   (ping-pong radiance, n = probe count)
//   header  2 * n * 2   vec4   (ping-pong; TWO vec4 per probe —
//                               [world_pos, history] and [normal, linZ])
//   SH      2 * n * 9   vec4   (ping-pong — the trace pass READS last
//                               frame's SH for the second bounce while
//                               it writes this frame's, so these cannot
//                               share one slot)
// = 150 * n vec4, and n = W*H/256, so the whole thing is 0.59 * W * H
// vec4 — comfortably inside the existing allocation.  The two paths
// never run in the same frame; toggling between them raises
// rt_gi_dirty_ on the CPU so the buffer is re-zeroed.
ivec2 giProbeDim(ivec2 sz) {
    return (sz + ivec2(GI_PROBE_TILE - 1)) / GI_PROBE_TILE;
}
uint giProbeCount(ivec2 sz) {
    ivec2 d = giProbeDim(sz);
    return uint(d.x) * uint(d.y);
}
uint giAtlasOfs(uint nprobes, bool slot, uint probe, uint texel) {
    return (slot ? nprobes * uint(GI_OCTA_TEXELS) : 0u) +
           probe * uint(GI_OCTA_TEXELS) + texel;
}
// Header stride is 2: [0] = (world_pos.xyz, history)  — history 0 marks
// the probe INVALID (sky tile, forward-shaded tile, never written);
//                     [1] = (geometric normal.xyz, linear view depth).
uint giHdrOfs(uint nprobes, bool slot, uint probe) {
    return 2u * nprobes * uint(GI_OCTA_TEXELS) +
           (slot ? 2u * nprobes : 0u) + probe * 2u;
}
uint giShOfs(uint nprobes, bool slot, uint probe, uint coef) {
    return 2u * nprobes * uint(GI_OCTA_TEXELS) + 4u * nprobes +
           (slot ? 9u * nprobes : 0u) + probe * 9u + coef;
}

// ── Hemi-octahedral direction set ───────────────────────────────────
// Maps the unit square onto the upper hemisphere with near-constant
// solid angle per texel (the octahedral map's defining property), which
// is exactly what an unbiased uniform-hemisphere estimator wants:
// every texel carries the same weight dw = 2*PI / 64.
vec3 giHemiOctDecode(vec2 f) {          // f in [0,1]^2 -> |d| = 1, d.z >= 0
    vec2 t = f * 2.0 - 1.0;
    vec2 p = vec2(t.x + t.y, t.x - t.y) * 0.5;
    return normalize(vec3(p, 1.0 - abs(p.x) - abs(p.y)));
}

// Duff et al. branchless orthonormal basis — continuous in n (away from
// the n.z = -1 pole), which is what makes the tangent-frame atlas
// reprojectable across frames.
void giOnb(vec3 n, out vec3 t, out vec3 b) {
    float s  = n.z >= 0.0 ? 1.0 : -1.0;
    float a  = -1.0 / (s + n.z);
    float bb = n.x * n.y * a;
    t = vec3(1.0 + s * n.x * n.x * a, s * bb, -s * n.x);
    b = vec3(bb, s + n.y * n.y * a, -n.y);
}

// ── 2nd-order real SH ───────────────────────────────────────────────
// giShBasis returns Y_00 .. Y_22 for a direction; giShIrradiance folds
// in the Lambert transfer coefficients A_l / PI = (1, 2/3, 1/4) so the
// result is E(N) / PI — the SAME quantity the cosine-sampled per-pixel
// estimator produced, which is why `ambient_diffuse = c_diff * gi_E`
// downstream is untouched.
void giShBasis(vec3 d, out float y[9]) {
    y[0] = 0.282095;
    y[1] = 0.488603 * d.y;
    y[2] = 0.488603 * d.z;
    y[3] = 0.488603 * d.x;
    y[4] = 1.092548 * d.x * d.y;
    y[5] = 1.092548 * d.y * d.z;
    y[6] = 0.315392 * (3.0 * d.z * d.z - 1.0);
    y[7] = 1.092548 * d.x * d.z;
    y[8] = 0.546274 * (d.x * d.x - d.y * d.y);
}
vec3 giShIrradiance(vec3 c[9], vec3 n) {
    float y[9];
    giShBasis(n, y);
    const float a0 = 1.0;          // A_0 / PI
    const float a1 = 2.0 / 3.0;    // A_1 / PI
    const float a2 = 0.25;         // A_2 / PI
    vec3 e = c[0] * (a0 * y[0]);
    e += (c[1] * y[1] + c[2] * y[2] + c[3] * y[3]) * a1;
    e += (c[4] * y[4] + c[5] * y[5] + c[6] * y[6] +
          c[7] * y[7] + c[8] * y[8]) * a2;
    return max(e, vec3(0.0));      // ringing can push L2 SH negative
}

// ── Second bounce: the ray hit reads the radiance cache ─────────────
// The single most valuable thing Lumen does with its cache is CLOSE THE
// LOOP: a GI ray that lands on a wall does not need its own hemisphere
// of rays to know how much indirect light reaches that wall — last
// frame's probes already integrated exactly that, and they are still
// resident.  Projecting the hit point into the PREVIOUS frame's screen
// and reading the probe there upgrades a 1-bounce estimator to a
// multi-bounce one for the price of a handful of loads, and because
// each frame's probes are fed back into the next frame's, the series
// converges to full multi-bounce GI over a few frames.
//
// Everything here reads the PREVIOUS ping-pong slot (with
// prev_view_proj to match, since that is the screen the probes were
// placed on), which is also what makes it safe to call from inside the
// probe trace pass while that pass writes the current slot.
//
// Fails — and the caller keeps the old constant sky leak — when the hit
// is off-screen, behind the camera, or lands where no probe agrees with
// its plane.  Those are exactly the cases where a screen-space cache
// has no information, and pretending otherwise is how light leaks.
//
// Damping: the feedback is a geometric series in surface albedo, and a
// white interior (albedo ~0.9) would converge to ~10x the first bounce
// — physically right, but this scene already reads bright and the sun
// is not energy-matched to it.  0.7 per bounce keeps the series near
// 2.5x, which is where a second bounce reads as "the room fills in"
// rather than "the room glows".
const float RT_GI_BOUNCE_GAIN = 0.70;

// ── Second bounce, per-pixel variant: temporal feedback ─────────────
// The screen-probe cache below is not the only radiance cache in this
// shader.  The PER-PIXEL estimator already keeps `gi_accum`: one
// temporally-accumulated irradiance/PI per pixel, exactly the quantity
// a ray hit needs for "how much indirect light arrives here".  So a GI
// ray that lands on a surface which was ON SCREEN last frame can simply
// read that pixel's accumulated value — multi-bounce for ZERO extra
// rays, on the estimator that is actually the default.
//
// Why the surface normal is not a problem: the depth test below accepts
// only when the reprojected pixel's stored linear depth matches the
// hit's, i.e. that screen pixel IS the surface point the ray hit.  Its
// accumulated irradiance was therefore integrated over that same
// surface's hemisphere with that same normal, by construction.
//
// clip.w of a standard perspective projection IS linear view depth, so
// the hit's previous-frame depth comes free with the reprojection.
//
// Convergence: steady state solves E = E_1 + gain*albedo*E, so with
// gain 0.7 and albedo <= 1 the series is bounded at 3.3x the first
// bounce.  No clamp needed.
bool giTemporalSecondBounce(vec3 wp, out vec3 o_E) {
    o_E = vec3(0.0);
    if ((camera_info.input_features & FEATURE_INPUT_GI_MULTI_BOUNCE) == 0u)
        return false;

    vec4 clip = camera_info.prev_view_proj * vec4(wp, 1.0);
    if (clip.w <= 1e-4) return false;                    // behind camera
    vec2 uv = (clip.xy / clip.w) * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) ||
        any(greaterThanEqual(uv, vec2(1.0)))) return false;

    ivec2 sz = imageSize(hdr_out);
    ivec2 p  = clamp(ivec2(uv * vec2(sz)), ivec2(0), sz - 1);
    // Same ping-pong convention as the per-pixel accumulator: read the
    // half the CURRENT frame is not writing.
    uint gi_half = uint(sz.x) * uint(sz.y);
    bool gi_par  = (camera_info.input_features &
                    FEATURE_INPUT_RESTIR_PARITY) != 0u;
    uint gi_rofs = gi_par ? 0u : gi_half;

    vec4 prev    = gi_accum[gi_rofs + uint(p.y) * uint(sz.x) + uint(p.x)];
    vec2 prev_hd = unpackHalf2x16(floatBitsToUint(prev.w));
    // prev_hd = (history, stored linear view depth).  History 0 means
    // never written / zero-cleared, and self-rejects.
    if (prev_hd.x <= 0.5) return false;
    float hit_lin_z = clip.w;
    if (abs(prev_hd.y - hit_lin_z) >
        RT_GI_DEPTH_REJECT * max(hit_lin_z, 1e-3)) return false;

    o_E = prev.rgb;
    return true;
}

bool giProbeSecondBounce(vec3 wp, vec3 n, out vec3 o_E) {
    o_E = vec3(0.0);
    if ((camera_info.input_features & FEATURE_INPUT_GI_SCREEN_PROBE) == 0u)
        return false;

    vec4 clip = camera_info.prev_view_proj * vec4(wp, 1.0);
    if (clip.w <= 1e-4) return false;                    // behind camera
    vec2 uv = (clip.xy / clip.w) * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) ||
        any(greaterThanEqual(uv, vec2(1.0)))) return false;

    ivec2 sz      = imageSize(hdr_out);
    ivec2 dim     = giProbeDim(sz);
    uint  nprobes = uint(dim.x) * uint(dim.y);
    // Previous slot — see the note above.
    bool  slot = (camera_info.input_features &
                  FEATURE_INPUT_RESTIR_PARITY) == 0u;

    vec2  pf = (uv * vec2(sz)) / float(GI_PROBE_TILE) - 0.5;
    ivec2 p0 = ivec2(floor(pf));
    vec2  fr = fract(pf);
    // No linear view depth at a ray hit, so scale the plane tolerance by
    // the hit's distance from the camera instead — same intent, same
    // "one probe spacing" magnitude.
    float plane_scale =
        1.0 / max(GI_PROBE_PLANE_K * distance(wp, camera_info.position),
                  0.10);

    vec3  sum  = vec3(0.0);
    float wsum = 0.0;
    for (int j = 0; j < 2; ++j) {
        for (int i = 0; i < 2; ++i) {
            ivec2 pc = p0 + ivec2(i, j);
            if (any(lessThan(pc, ivec2(0))) ||
                any(greaterThanEqual(pc, dim))) continue;
            uint q  = uint(pc.y) * uint(dim.x) + uint(pc.x);
            uint hb = giHdrOfs(nprobes, slot, q);
            vec4 h0 = gi_accum[hb];
            if (h0.w < 0.5) continue;
            vec4 h1 = gi_accum[hb + 1u];
            float wn = dot(n, h1.xyz);
            if (wn <= 0.0) continue;
            float pd = abs(dot(wp - h0.xyz, n)) * plane_scale;
            float wb = (i == 0 ? 1.0 - fr.x : fr.x) *
                       (j == 0 ? 1.0 - fr.y : fr.y) + 0.05;
            float w  = wb * (wn * wn) * exp(-pd * pd);
            if (w <= 1e-5) continue;
            vec3 c[9];
            uint sb = giShOfs(nprobes, slot, q, 0u);
            for (int k = 0; k < 9; ++k) c[k] = gi_accum[sb + uint(k)].rgb;
            sum  += giShIrradiance(c, n) * w;
            wsum += w;
        }
    }
    if (wsum <= 1e-5) return false;
    o_E = sum / wsum;
    return true;
}

// Whichever radiance cache this frame actually has.  The screen probes
// carry direction (SH), so they win when they are running; otherwise the
// per-pixel accumulator's temporal feedback covers the default path.
// Both fail closed, and the caller keeps the flat sky leak.
bool giSecondBounce(vec3 wp, vec3 n, out vec3 o_E) {
    if ((camera_info.input_features & FEATURE_INPUT_GI_SCREEN_PROBE) != 0u)
        return giProbeSecondBounce(wp, n, o_E);
    return giTemporalSecondBounce(wp, o_E);
}

// Möller–Trumbore with the hit DISTANCE returned (rtRayTri drops it —
// any-hit callers never need it, this closest-hit walk does).
bool rtGiRayTri(vec3 ro, vec3 rd, float t_max, vec3 v0, vec3 v1, vec3 v2,
                out float o_u, out float o_v, out float o_t) {
    vec3 e1 = v1 - v0;
    vec3 e2 = v2 - v0;
    vec3 pv = cross(rd, e2);
    float det = dot(e1, pv);
    if (abs(det) < 1e-8) return false;
    float inv_det = 1.0 / det;
    vec3 tv = ro - v0;
    float u = dot(tv, pv) * inv_det;
    if (u < 0.0 || u > 1.0) return false;
    vec3 qv = cross(tv, e1);
    float v = dot(rd, qv) * inv_det;
    if (v < 0.0 || u + v > 1.0) return false;
    float t = dot(e2, qv) * inv_det;
    if (t <= RT_SHADOW_BIAS || t >= t_max) return false;
    o_u = u; o_v = v; o_t = t;
    return true;
}

vec3 rtGiRadiance(vec3 ro, vec3 rd, vec3 sun_L, vec3 sun_col,
                  out float o_hit_t) {
    o_hit_t = RT_GI_MAX_DIST;
    vec3 inv_dir = 1.0 / rd;
    float best_t   = RT_GI_MAX_DIST;
    vec3  best_n   = vec3(0.0);
    vec3  best_alb = vec3(0.0);
    bool  hit = false;

    uint stack[RT_BVH_STACK_SIZE];
    int  sp = 0;
    stack[sp++] = 0u;
    while (sp > 0) {
        RtBvhNode node = rt_bvh_nodes[stack[--sp]];
        if (!rtRayAabb(ro, inv_dir, best_t,
                       node.aabb_min, node.aabb_max)) continue;
        if (node.prim_count == 0u) {
            if (sp + 2 <= RT_BVH_STACK_SIZE) {
                stack[sp++] = node.left_first;
                stack[sp++] = node.left_first + 1u;
            }
            continue;
        }
        for (uint p = 0u; p < node.prim_count; ++p) {
            uint cluster_idx = rt_bvh_leaf_clusters[node.left_first + p];
            vec4 bs = rt_cull_infos[cluster_idx].bounds_sphere;
            vec3 oc = bs.xyz - ro;
            float t_ca = dot(oc, rd);
            float d2 = dot(oc, oc) - t_ca * t_ca;
            if (t_ca < -bs.w || t_ca - bs.w > best_t ||
                d2 > bs.w * bs.w) continue;

            ClusterDrawInfo draw = rt_draw_infos[cluster_idx];
            BindlessMaterialParams m = rt_materials[draw.material_idx];
            uint mflags = uint(m.flags);
            if ((mflags & BINDLESS_MAT_TRANSLUCENT) != 0u) continue;
            bool masked = (mflags & BINDLESS_MAT_ALPHA_MASK) != 0u &&
                          m.base_color_tex_idx >= 0;

            uint tri_count = draw.index_count / 3u;
            for (uint t = 0u; t < tri_count; ++t) {
                uint i0 = rt_indices[draw.index_offset + t * 3u + 0u]
                          + draw.vertex_offset;
                uint i1 = rt_indices[draw.index_offset + t * 3u + 1u]
                          + draw.vertex_offset;
                uint i2 = rt_indices[draw.index_offset + t * 3u + 2u]
                          + draw.vertex_offset;
                vec4 p0 = rt_pos_uv[i0];
                vec4 p1 = rt_pos_uv[i1];
                vec4 p2 = rt_pos_uv[i2];
                float hu, hv, ht;
                if (!rtGiRayTri(ro, rd, best_t,
                                p0.xyz, p1.xyz, p2.xyz, hu, hv, ht)) {
                    continue;
                }
                vec4 texel = vec4(1.0);
                if (m.base_color_tex_idx >= 0) {
                    vec2 uv0 = unpackHalf2x16(floatBitsToUint(p0.w));
                    vec2 uv1 = unpackHalf2x16(floatBitsToUint(p1.w));
                    vec2 uv2 = unpackHalf2x16(floatBitsToUint(p2.w));
                    vec2 huv = uv0 * (1.0 - hu - hv) + uv1 * hu + uv2 * hv;
                    texel = textureLod(
                        rt_base_color_textures[
                            nonuniformEXT(m.base_color_tex_idx)],
                        huv, RT_GI_TEX_LOD);
                }
                if (masked &&
                    texel.a * m.base_color_factor.a < m.alpha_cutoff) {
                    continue;   // transparent texel — ray passes through
                }
                best_t   = ht;
                best_alb = texel.rgb * m.base_color_factor.rgb;
                best_n   = normalize(cross(p1.xyz - p0.xyz,
                                           p2.xyz - p0.xyz));
                hit = true;
            }
        }
    }

    if (!hit) {
        // Miss: the ray sees sky — the IBL radiance cubemap is the
        // light source (see the block comment above; the lambertian
        // cube stays for HIT-point ambient, where irradiance at the
        // surface normal is the correct quantity).
        vec3 sky = textureLod(ggx_env_sampler, rd, RT_GI_SKY_LOD).rgb *
                   kIblIrradianceScale;
#ifndef USE_HDR
        sky = sRGBToLinear(sky);
#endif
        return sky;
    }

    o_hit_t = best_t;
    vec3 hp = ro + rd * best_t;
    vec3 hn = (dot(best_n, rd) < 0.0) ? best_n : -best_n;
    float ndl = max(dot(hn, sun_L), 0.0);
    float vis = (ndl > 0.0)
        ? rtShadowRayVisible(hp + hn * RT_GI_NORMAL_BIAS, sun_L,
                             RT_SHADOW_MAX_DIST)
        : 0.0;
    // Indirect arriving AT the hit point.  With the screen-probe cache
    // live this is a real second bounce read out of last frame's probes;
    // without it (or off-screen) it falls back to the flat sky leak this
    // estimator has always used.
    vec3 hit_amb;
    if (giSecondBounce(hp, hn, hit_amb)) {
        hit_amb *= RT_GI_BOUNCE_GAIN;
    } else {
        vec3 sky_amb = texture(lambertian_env_sampler, hn).rgb *
                       kIblIrradianceScale;
#ifndef USE_HDR
        sky_amb = sRGBToLinear(sky_amb);
#endif
        hit_amb = sky_amb * RT_GI_SKY_LEAK;
    }
    return best_alb * (sun_col * (ndl * vis / M_PI) + hit_amb);
}

float rtShadowFactor(vec3 world_pos, vec3 world_normal, vec2 screen_pixel) {
    vec3 L  = normalize(-runtime_lights.lights[0].direction);
    // Slope-scaled launch offset: at grazing sun angles a flat 3 cm
    // normal bias leaves the origin inside its own surface's thickness,
    // producing self-shadow acne (reads as noise / a shadow offset).
    // Scale up to 4× as N·L falls off, plus a small step along the ray.
    float slope = 1.0 - clamp(dot(world_normal, L), 0.0, 1.0);
    vec3 ro = world_pos +
              world_normal * (RT_SHADOW_BIAS * (1.0 + 3.0 * slope)) +
              L * RT_SHADOW_BIAS;
    float lit = 0.0;
    for (int i = 0; i < RT_SOFT_SAMPLES_SW; ++i) {
        vec2 xi = vec2(
            csmIGN(screen_pixel + vec2(17.0 * float(i), 31.0 * float(i))),
            csmIGN(screen_pixel.yx +
                   vec2(47.0 + 13.0 * float(i), 5.0 + 7.0 * float(i))));
        lit += rtShadowRayVisible(ro, rtSunConeDir(L, xi),
                                  RT_SHADOW_MAX_DIST);
    }
    return lit / float(RT_SOFT_SAMPLES_SW);
}

// Software ray-traced AO: short cosine-hemisphere rays vs the same BVH
// + skeleton casters.  Returns 1 = open, 0 = fully occluded.
float rtAoFactor(vec3 world_pos, vec3 world_normal, vec2 screen_pixel) {
    vec3 ro = world_pos + world_normal * RT_SHADOW_BIAS;
    float open = 0.0;
    for (int i = 0; i < RT_AO_SAMPLES_SW; ++i) {
        vec2 xi = vec2(
            csmIGN(screen_pixel + vec2(23.0 * float(i) + 3.0,
                                       29.0 * float(i) + 11.0)),
            csmIGN(screen_pixel.yx + vec2(53.0 + 19.0 * float(i),
                                          2.0 + 41.0 * float(i))));
        open += rtShadowRayVisible(
            ro, rtCosHemisphereDir(world_normal, xi), RT_AO_RADIUS);
    }
    return open / float(RT_AO_SAMPLES_SW);
}

// ═══ ReSTIR direct lighting (FEATURE_INPUT_RESTIR) ═══════════════════
// Reservoir-based spatiotemporal importance resampling over the scene's
// authored point lights + the sun treated as an AREA light (disk).  Per
// pixel, per frame:
//   1. RIS over a handful of candidates (1 sun-disk direction + N
//      uniform light picks), target p-hat = luminance of the unshadowed
//      contribution at this pixel.
//   2. Temporal reuse: reproject via the G-buffer velocity, re-evaluate
//      the previous winner's p-hat at THIS pixel, merge reservoirs
//      (history clamped to RESTIR_M_CLAMP × the per-frame candidates).
//   3. ONE occlusion ray for the merged winner (soft sun penumbras come
//      from the per-frame disk directions being temporally integrated).
//   4. Shade winner × W.   Spatial reuse: v2.
const uint  RESTIR_SUN_ID           = 1u;   // reservoir ids: 0=empty, 2+k=light k
const int   RESTIR_LIGHT_CANDIDATES = 8;
const float RESTIR_M_CLAMP          = 20.0;

// PCG hash / rng.
uint restirPcg(uint v) {
    v = v * 747796405u + 2891336453u;
    v = ((v >> ((v >> 28u) + 4u)) ^ v) * 277803737u;
    return (v >> 22u) ^ v;
}
float restirRand(inout uint s) {
    s = restirPcg(s);
    return float(s) * (1.0 / 4294967296.0);
}

// Snorm octahedral encode/decode (2×16 bit) for the sun-disk direction.
uint restirOctEncode(vec3 n) {
    n /= (abs(n.x) + abs(n.y) + abs(n.z));
    vec2 e = (n.z >= 0.0)
        ? n.xy
        : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0,
                                   n.y >= 0.0 ? 1.0 : -1.0);
    return packSnorm2x16(e);
}
vec3 restirOctDecodeDir(uint p) {
    vec2 e = unpackSnorm2x16(p);
    vec3 n = vec3(e.x, e.y, 1.0 - abs(e.x) - abs(e.y));
    float t = max(-n.z, 0.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

float restirLuma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

// Unshadowed contribution f(sample) at this pixel.  id = RESTIR_SUN_ID
// evaluates the given sun-disk direction; id = 2+k evaluates point light
// k.  Also returns the occlusion ray for the sample.
vec3 restirEvalSample(uint id, vec3 sun_dir,
                      vec3 world_pos, vec3 N, vec3 albedo, vec3 V,
                      out vec3 o_ray_dir, out float o_ray_tmax) {
    if (id == RESTIR_SUN_ID) {
        vec3 radiance = runtime_lights.lights[0].color *
                        runtime_lights.lights[0].intensity;
        float ndl = max(dot(N, sun_dir), 0.0);
        vec3  H    = normalize(sun_dir + V);
        float spec = pow(max(dot(N, H), 0.0), 32.0);
        o_ray_dir  = sun_dir;
        o_ray_tmax = RT_SHADOW_MAX_DIST;
        return albedo * radiance * (ndl / M_PI) +
               radiance * (0.05 * spec / M_PI);
    }
    uint k = id - 2u;
    if (k >= restir_light_header.x) {
        o_ray_dir = vec3(0.0, 1.0, 0.0); o_ray_tmax = 0.0;
        return vec3(0.0);
    }
    RestirPointLight lp = restir_lights[k];
    vec3  to_l = lp.position - world_pos;
    float d    = length(to_l);
    if (d >= lp.radius || d < 1e-3) {
        o_ray_dir = vec3(0.0, 1.0, 0.0); o_ray_tmax = 0.0;
        return vec3(0.0);
    }
    vec3  Ld  = to_l / d;
    float ndl = max(dot(N, Ld), 0.0);
    // Inverse-square with a smooth window to zero at the cutoff radius
    // (UE-style), so lights never pop at their range boundary.
    float win = clamp(1.0 - pow(d / lp.radius, 4.0), 0.0, 1.0);
    float att = lp.intensity * win * win / (d * d + 1e-2);
    vec3  radiance = lp.color * att;
    vec3  H    = normalize(Ld + V);
    float spec = pow(max(dot(N, H), 0.0), 32.0);
    o_ray_dir  = Ld;
    o_ray_tmax = max(d - 2.0 * RT_SHADOW_BIAS, 0.0);
    return albedo * radiance * (ndl / M_PI) +
           radiance * (0.05 * spec / M_PI);
}

// Streaming reservoir update.  w already includes the candidate's 1/pdf.
void restirUpdate(inout uint r_id, inout uint r_dir, inout float r_wsum,
                  inout float r_m, inout float r_phat,
                  uint id, uint dir, float p_hat, float w, inout uint rng) {
    r_wsum += w;
    r_m    += 1.0;
    if (r_wsum > 0.0 && restirRand(rng) * r_wsum <= w) {
        r_id   = id;
        r_dir  = dir;
        r_phat = p_hat;
    }
}

#ifdef HW_RT_SHADOW
// Prototype — defined in the HW-RT block below; ReSTIR dispatches the
// winner's occlusion ray to whichever backend this variant has.
float hwRtShadowRayVisible(vec3 ro, vec3 rd, float t_max);
#endif

// Full per-pixel ReSTIR direct lighting.  Returns the shaded direct term
// (sun + point lights), and reports the winner's visibility for the
// SHADOW debug view.
vec3 restirDirectLighting(ivec2 px, ivec2 sz, vec2 uv,
                          vec3 world_pos, vec3 N, vec3 N_geom,
                          vec3 albedo, vec3 V, out float o_debug_vis) {
    const uint parity =
        (camera_info.input_features & FEATURE_INPUT_RESTIR_PARITY) != 0u
            ? 1u : 0u;
    const uint frame_bits =
        (camera_info.input_features & FEATURE_INPUT_FRAME_MASK)
            >> FEATURE_INPUT_FRAME_SHIFT;
    const uint pixel_count = uint(sz.x * sz.y);
    const uint write_ofs   = parity * pixel_count;
    const uint read_ofs    = (1u - parity) * pixel_count;

    uint rng = restirPcg(uint(px.x) * 1973u + uint(px.y) * 9277u +
                         frame_bits * 26699u + 1u);

    const uint  light_count = min(restir_light_header.x, 0xFFF0u);
    vec3 L = normalize(-runtime_lights.lights[0].direction);

    // ── 1. Initial candidates ────────────────────────────────────────
    uint  r_id = 0u, r_dir = 0u;
    float r_wsum = 0.0, r_m = 0.0, r_phat = 0.0;
    vec3  ray_dir; float ray_tmax;

    // Sun-disk candidate.  The sun's color×intensity is authored as the
    // TOTAL directional radiance (delta-light convention — the legacy
    // path shades with it directly), so the candidate is treated as one
    // DISCRETE light sampled with pdf 1: w = p-hat, NO solid-angle pdf
    // division.  The cone-jittered direction is temporal anti-aliasing
    // of the delta direction — the BRDF is effectively constant across
    // the 0.6° disk, and the soft penumbra emerges from the per-frame
    // VISIBILITY of the jittered rays being integrated by temporal
    // reuse.  (Dividing by the cone pdf here — a factor of ~3000 — is
    // the measure-mixing bug that shaded the sun black.)
    {
        vec2 xi = vec2(restirRand(rng), restirRand(rng));
        vec3 sd = rtSunConeDir(L, xi);
        float p_hat = restirLuma(restirEvalSample(
            RESTIR_SUN_ID, sd, world_pos, N, albedo, V,
            ray_dir, ray_tmax));
        restirUpdate(r_id, r_dir, r_wsum, r_m, r_phat,
                     RESTIR_SUN_ID, restirOctEncode(sd),
                     p_hat, p_hat, rng);
    }
    // Uniform point-light candidates (pdf = 1/count each).
    if (light_count > 0u) {
        for (int i = 0; i < RESTIR_LIGHT_CANDIDATES; ++i) {
            uint k = min(uint(restirRand(rng) * float(light_count)),
                         light_count - 1u);
            float p_hat = restirLuma(restirEvalSample(
                2u + k, L, world_pos, N, albedo, V, ray_dir, ray_tmax));
            restirUpdate(r_id, r_dir, r_wsum, r_m, r_phat,
                         2u + k, 0u, p_hat,
                         p_hat * float(light_count), rng);
        }
    }
    const float m_initial = r_m;

    // ── 2. Temporal reuse ────────────────────────────────────────────
    // Reproject via RT3 velocity (curNDC − prevNDC → uv delta = ×0.5).
    {
        vec2 vel = texture(gbuf_velocity, uv).rg;
        vec2 prev_uv = uv - vel * 0.5;
        if (all(greaterThanEqual(prev_uv, vec2(0.0))) &&
            all(lessThan(prev_uv, vec2(1.0)))) {
            ivec2 ppx = ivec2(prev_uv * vec2(sz));
            RestirReservoir prev =
                restir_reservoirs[read_ofs +
                                  uint(ppx.y) * uint(sz.x) + uint(ppx.x)];
            uint  p_id = prev.id_m & 0xFFFFu;
            float p_m  = float(prev.id_m >> 16u);
            bool valid =
                p_id >= 1u && p_id < 2u + light_count + 1u &&
                (p_id == RESTIR_SUN_ID || (p_id - 2u) < light_count) &&
                p_m > 0.0 &&
                !isnan(prev.w_sum) && !isinf(prev.w_sum) &&
                prev.w_sum >= 0.0 &&
                !isnan(prev.target_pdf) && !isinf(prev.target_pdf) &&
                prev.target_pdf > 0.0;
            if (valid) {
                // Unbiased W of the previous reservoir MUST use its
                // honest stored M.  The old code divided w_sum by the
                // CLAMPED M and then multiplied the clamped M back in,
                // so the merge weight collapsed to
                // p_hat_now * w_sum / target_pdf — i.e. the M clamp
                // cancelled out entirely and the history's weight
                // (w_sum, which grows every frame) entered the merge
                // UNBOUNDED: lighting changes took ever longer to
                // surface the longer a pixel had been on screen.
                float prev_W =
                    prev.w_sum / max(p_m * prev.target_pdf, 1e-6);
                vec3  p_dirv = restirOctDecodeDir(prev.dir_oct);
                float p_hat_now = restirLuma(restirEvalSample(
                    p_id, p_dirv, world_pos, N, albedo, V,
                    ray_dir, ray_tmax));
                // History clamp — NOW effective, because w below scales
                // linearly with the clamped p_m.  20 x the per-frame
                // candidate count keeps the fresh candidates at ~5% of
                // the merged mass (blend ~0.95).
                p_m = min(p_m, RESTIR_M_CLAMP * max(m_initial, 1.0));
                // Disocclusion / light-change rejection.  The reservoir
                // stores no geometry, but target_pdf is the winner's
                // p-hat AT THE SURFACE THAT WROTE IT: re-evaluating the
                // same sample at THIS pixel (p_hat_now) differing by
                // more than 4x means the reprojection landed on a
                // different surface (normal/albedo changed) or the light
                // itself changed — either way the history is stale, so
                // collapse it to one frame's worth instead of letting it
                // outvote the fresh candidates.
                float phat_ratio = p_hat_now / max(prev.target_pdf, 1e-6);
                if (phat_ratio < 0.25 || phat_ratio > 4.0)
                    p_m = min(p_m, max(m_initial, 1.0));
                float w = p_hat_now * prev_W * p_m;
                if (w > 0.0) {
                    restirUpdate(r_id, r_dir, r_wsum, r_m, r_phat,
                                 p_id, prev.dir_oct, p_hat_now, w, rng);
                    r_m += p_m - 1.0;   // update() added 1; history adds p_m
                }
            }
        }
    }

    // ── 3. Winner visibility (ONE ray) + 4. shade ────────────────────
    vec3  direct = vec3(0.0);
    float vis    = 1.0;
    if (r_id != 0u && r_phat > 0.0 && r_wsum > 0.0) {
        vec3 f = restirEvalSample(
            r_id, restirOctDecodeDir(r_dir),
            world_pos, N, albedo, V, ray_dir, ray_tmax);
        float slope = 1.0 - clamp(dot(N_geom, ray_dir), 0.0, 1.0);
        vec3 ro = world_pos +
                  N_geom * (RT_SHADOW_BIAS * (1.0 + 3.0 * slope)) +
                  ray_dir * RT_SHADOW_BIAS;
        if (dot(N_geom, ray_dir) <= 0.0) {
            vis = 0.0;             // facing away — geometrically shadowed
        } else {
#ifdef HW_RT_SHADOW
            vis = ((camera_info.input_features &
                    FEATURE_INPUT_HW_RT_SHADOW) != 0u)
                      ? hwRtShadowRayVisible(ro, ray_dir, ray_tmax)
                      : rtShadowRayVisible(ro, ray_dir, ray_tmax);
#else
            vis = rtShadowRayVisible(ro, ray_dir, ray_tmax);
#endif
        }
        float W = r_wsum / max(r_m * r_phat, 1e-6);
        direct = f * W * vis;
        // Visibility feedback: an occluded winner decays instead of
        // persisting through temporal reuse (kills shadow ghosting while
        // keeping the sample alive enough to re-test as things move).
        if (vis <= 0.0) r_wsum *= 0.25;
    }
    o_debug_vis = vis;

    // ── Persist this frame's reservoir ───────────────────────────────
    RestirReservoir outr;
    outr.id_m       = (r_id & 0xFFFFu) |
                      (uint(clamp(r_m, 0.0, 65535.0)) << 16u);
    outr.w_sum      = r_wsum;
    outr.target_pdf = r_phat;
    outr.dir_oct    = r_dir;
    restir_reservoirs[write_ofs +
                      uint(px.y) * uint(sz.x) + uint(px.x)] = outr;

    return direct;
}

#ifdef HW_RT_SHADOW
// ─── Hardware ray-query sun shadow ───────────────────────────────────
// Fixed-function traversal of the cluster TLAS.  Opaque geometry commits
// in hardware (TERMINATE_ON_FIRST_HIT makes it an any-hit query); only
// alpha-masked candidates surface to the shader, where the base-colour
// texel at the hit UV decides occlusion — identical policy to the
// software path's masked handling.
float hwRtShadowRayVisible(vec3 ro, vec3 rd, float t_max) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(
        rq, hw_rt_tlas,
        gl_RayFlagsTerminateOnFirstHitEXT, 0xFFu,
        ro, RT_SHADOW_BIAS, rd, t_max);

    while (rayQueryProceedEXT(rq)) {
        // Only non-opaque (masked) triangle candidates reach here.
        if (rayQueryGetIntersectionTypeEXT(rq, false) ==
            gl_RayQueryCandidateIntersectionTriangleEXT) {
            const int prim =
                rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            const uint mat_id = hw_rt_masked_tri_mat[prim];
            BindlessMaterialParams m = rt_materials[mat_id];

            uint i0 = hw_rt_masked_indices[3 * prim + 0];
            uint i1 = hw_rt_masked_indices[3 * prim + 1];
            uint i2 = hw_rt_masked_indices[3 * prim + 2];
            vec2 uv0 = unpackHalf2x16(floatBitsToUint(rt_pos_uv[i0].w));
            vec2 uv1 = unpackHalf2x16(floatBitsToUint(rt_pos_uv[i1].w));
            vec2 uv2 = unpackHalf2x16(floatBitsToUint(rt_pos_uv[i2].w));
            vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
            vec2 huv = uv0 * (1.0 - bary.x - bary.y)
                     + uv1 * bary.x + uv2 * bary.y;

            float a = (m.base_color_tex_idx >= 0)
                ? textureLod(rt_base_color_textures[
                      nonuniformEXT(m.base_color_tex_idx)], huv, 0.0).a
                      * m.base_color_factor.a
                : m.base_color_factor.a;
            if (a >= m.alpha_cutoff) {
                rayQueryConfirmIntersectionEXT(rq);   // solid texel
            }
        }
    }
    return (rayQueryGetIntersectionTypeEXT(rq, true) ==
            gl_RayQueryCommittedIntersectionNoneEXT) ? 1.0 : 0.0;
}

// Soft sun shadow: average RT_SOFT_SAMPLES_HW cone-jittered ray queries
// (same cone + IGN scheme as the software path).
float hwRtShadowFactor(vec3 world_pos, vec3 world_normal,
                       vec2 screen_pixel) {
    vec3 L  = normalize(-runtime_lights.lights[0].direction);
    // Slope-scaled launch offset — see rtShadowFactor.
    float slope = 1.0 - clamp(dot(world_normal, L), 0.0, 1.0);
    vec3 ro = world_pos +
              world_normal * (RT_SHADOW_BIAS * (1.0 + 3.0 * slope)) +
              L * RT_SHADOW_BIAS;
    float lit = 0.0;
    for (int i = 0; i < RT_SOFT_SAMPLES_HW; ++i) {
        vec2 xi = vec2(
            csmIGN(screen_pixel + vec2(17.0 * float(i), 31.0 * float(i))),
            csmIGN(screen_pixel.yx +
                   vec2(47.0 + 13.0 * float(i), 5.0 + 7.0 * float(i))));
        lit += hwRtShadowRayVisible(ro, rtSunConeDir(L, xi),
                                    RT_SHADOW_MAX_DIST);
    }
    return lit / float(RT_SOFT_SAMPLES_HW);
}

// Hardware ray-traced AO: short cosine-hemisphere ray queries.
float hwRtAoFactor(vec3 world_pos, vec3 world_normal,
                   vec2 screen_pixel) {
    vec3 ro = world_pos + world_normal * RT_SHADOW_BIAS;
    float open = 0.0;
    for (int i = 0; i < RT_AO_SAMPLES_HW; ++i) {
        vec2 xi = vec2(
            csmIGN(screen_pixel + vec2(23.0 * float(i) + 3.0,
                                       29.0 * float(i) + 11.0)),
            csmIGN(screen_pixel.yx + vec2(53.0 + 19.0 * float(i),
                                          2.0 + 41.0 * float(i))));
        open += hwRtShadowRayVisible(
            ro, rtCosHemisphereDir(world_normal, xi), RT_AO_RADIUS);
    }
    return open / float(RT_AO_SAMPLES_HW);
}

// ─── Hardware 1-bounce GI ray (closest hit vs the cluster TLAS) ──────
// Same estimator as rtGiRadiance, but the closest-hit walk runs in the
// RT cores instead of the software cluster BVH.  This matters far more
// for GI than for shadows: the shadow query is any-hit (first opaque
// hit ends it), while a closest-hit ray must consider EVERYTHING along
// its 120 m interval — on the unordered software BVH that walk was the
// entire "Deferred Resolve Compute" cost in dense scenes (hundreds of
// ms/frame), dwarfing the actual ray-query shadows it ran next to.
// Alpha-masked candidates get the same texel test as the shadow query;
// opaque hits commit in hardware.  The committed hit's geometry index
// picks the right index/material stream (geom 0 = opaque, 1 = masked),
// and both index buffers hold GLOBAL vertex ids into rt_pos_uv[].
vec3 hwRtGiRadiance(vec3 ro, vec3 rd, vec3 sun_L, vec3 sun_col,
                    out float o_hit_t) {
    o_hit_t = RT_GI_MAX_DIST;
    rayQueryEXT rq;
    rayQueryInitializeEXT(
        rq, hw_rt_tlas,
        gl_RayFlagsNoneEXT, 0xFFu,
        ro, RT_SHADOW_BIAS, rd, RT_GI_MAX_DIST);

    while (rayQueryProceedEXT(rq)) {
        // Only non-opaque (masked) triangle candidates reach here.
        if (rayQueryGetIntersectionTypeEXT(rq, false) ==
            gl_RayQueryCandidateIntersectionTriangleEXT) {
            const int prim =
                rayQueryGetIntersectionPrimitiveIndexEXT(rq, false);
            const uint mat_id = hw_rt_masked_tri_mat[prim];
            BindlessMaterialParams m = rt_materials[mat_id];

            uint i0 = hw_rt_masked_indices[3 * prim + 0];
            uint i1 = hw_rt_masked_indices[3 * prim + 1];
            uint i2 = hw_rt_masked_indices[3 * prim + 2];
            vec2 uv0 = unpackHalf2x16(floatBitsToUint(rt_pos_uv[i0].w));
            vec2 uv1 = unpackHalf2x16(floatBitsToUint(rt_pos_uv[i1].w));
            vec2 uv2 = unpackHalf2x16(floatBitsToUint(rt_pos_uv[i2].w));
            vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, false);
            vec2 huv = uv0 * (1.0 - bary.x - bary.y)
                     + uv1 * bary.x + uv2 * bary.y;

            float a = (m.base_color_tex_idx >= 0)
                ? textureLod(rt_base_color_textures[
                      nonuniformEXT(m.base_color_tex_idx)], huv,
                      RT_GI_TEX_LOD).a
                      * m.base_color_factor.a
                : m.base_color_factor.a;
            if (a >= m.alpha_cutoff) {
                rayQueryConfirmIntersectionEXT(rq);   // solid texel
            }
        }
    }

    if (rayQueryGetIntersectionTypeEXT(rq, true) ==
        gl_RayQueryCommittedIntersectionNoneEXT) {
        // Miss: the ray sees sky — the IBL radiance cubemap is the
        // light source (identical to the software path; see
        // rtGiRadiance's block comment for the estimator math).
        vec3 sky = textureLod(ggx_env_sampler, rd, RT_GI_SKY_LOD).rgb *
                   kIblIrradianceScale;
#ifndef USE_HDR
        sky = sRGBToLinear(sky);
#endif
        return sky;
    }

    const float ht = rayQueryGetIntersectionTEXT(rq, true);
    o_hit_t = ht;
    const vec3  hp = ro + rd * ht;

    // Skeleton-instance hit (custom index 1).  The software path skips
    // characters entirely (they're not in its BVH); here the hardware
    // walk finds them anyway, so shade a neutral matte bounce instead of
    // reading cluster streams the skeleton BLAS has no entries in.
    if (rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true) != 0) {
        vec3 amb;
        if (giSecondBounce(hp, -rd, amb)) {
            amb *= RT_GI_BOUNCE_GAIN;
        } else {
            vec3 sky_amb = texture(lambertian_env_sampler, -rd).rgb *
                           kIblIrradianceScale;
#ifndef USE_HDR
            sky_amb = sRGBToLinear(sky_amb);
#endif
            amb = sky_amb * RT_GI_SKY_LEAK;
        }
        return vec3(0.35) * amb;
    }

    const int  geom = rayQueryGetIntersectionGeometryIndexEXT(rq, true);
    const int  prim = rayQueryGetIntersectionPrimitiveIndexEXT(rq, true);
    const bool masked = (geom != 0);

    uint i0 = masked ? hw_rt_masked_indices[3 * prim + 0]
                     : hw_rt_opaque_indices[3 * prim + 0];
    uint i1 = masked ? hw_rt_masked_indices[3 * prim + 1]
                     : hw_rt_opaque_indices[3 * prim + 1];
    uint i2 = masked ? hw_rt_masked_indices[3 * prim + 2]
                     : hw_rt_opaque_indices[3 * prim + 2];
    const uint mat_id = masked ? hw_rt_masked_tri_mat[prim]
                               : hw_rt_opaque_tri_mat[prim];
    BindlessMaterialParams m = rt_materials[mat_id];

    vec4 p0 = rt_pos_uv[i0];
    vec4 p1 = rt_pos_uv[i1];
    vec4 p2 = rt_pos_uv[i2];

    vec4 texel = vec4(1.0);
    if (m.base_color_tex_idx >= 0) {
        vec2 uv0 = unpackHalf2x16(floatBitsToUint(p0.w));
        vec2 uv1 = unpackHalf2x16(floatBitsToUint(p1.w));
        vec2 uv2 = unpackHalf2x16(floatBitsToUint(p2.w));
        vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
        vec2 huv = uv0 * (1.0 - bary.x - bary.y)
                 + uv1 * bary.x + uv2 * bary.y;
        texel = textureLod(
            rt_base_color_textures[nonuniformEXT(m.base_color_tex_idx)],
            huv, RT_GI_TEX_LOD);
    }
    vec3 best_alb = texel.rgb * m.base_color_factor.rgb;
    vec3 best_n   = normalize(cross(p1.xyz - p0.xyz, p2.xyz - p0.xyz));

    // Bounce radiance: hit albedo lit by the sun (real occlusion ray —
    // hardware this time) + a small sky leak (see rtGiRadiance).
    vec3  hn  = (dot(best_n, rd) < 0.0) ? best_n : -best_n;
    float ndl = max(dot(hn, sun_L), 0.0);
    float vis = (ndl > 0.0)
        ? hwRtShadowRayVisible(hp + hn * RT_GI_NORMAL_BIAS, sun_L,
                               RT_SHADOW_MAX_DIST)
        : 0.0;
    // Second bounce out of the screen-probe cache (see rtGiRadiance).
    vec3 hit_amb;
    if (giSecondBounce(hp, hn, hit_amb)) {
        hit_amb *= RT_GI_BOUNCE_GAIN;
    } else {
        vec3 sky_amb = texture(lambertian_env_sampler, hn).rgb *
                       kIblIrradianceScale;
#ifndef USE_HDR
        sky_amb = sRGBToLinear(sky_amb);
#endif
        hit_amb = sky_amb * RT_GI_SKY_LEAK;
    }
    return best_alb * (sun_col * (ndl * vis / M_PI) + hit_amb);
}
#endif

// ═══ Ray-traced glass & water (window panes, river surface) ══════════
// Consumes the glass-attribute targets (bindings 12/13).  Per covered
// pixel: reconstruct the pane/surface point from its stored linear
// view depth, then trace a REFLECTION ray and a TRANSMISSION ray
// against the same cluster BVH / TLAS the shadows and GI walk:
//   glass — thin pane: the transmitted ray continues STRAIGHT (the
//           parallel offset of a few mm of glass is sub-pixel), tinted
//           by the pane colour times its authored alpha.
//   water — refract(1/1.33) bends the ray properly; the traced hit
//           distance drives Beer-Lambert absorption toward the water
//           tint, so shallow edges stay clear and the channel centre
//           reads deep.  Total internal reflection falls back to pure
//           reflection.
// Both rays shade through the same estimator the GI bounce uses
// (albedo x sun with a real occlusion ray + sky leak; sky on miss), so
// what a window reflects agrees with how the world lights.
bool glassWaterOverlay(vec2 uv, ivec2 px_dbg, float opaque_lin_z,
                       out vec3 out_color) {
    vec4 g0 = texture(gbuf_glass_nr, uv);
    vec4 g1 = texture(gbuf_glass_tint, uv);
    float kind = g1.a;
    // WATER ONLY.  Glass left this path: a thin pane's transmission is
    // exactly the rasterised scene behind it, so panes now draw as
    // plain alpha-blended forward geometry after the resolve (see
    // ObjectSceneView::drawGlassForward).  Water genuinely needs the
    // traced rays — the refracted path bends to the river bed — so the
    // overlay keeps it.
    if (kind < 0.9) return false;
    float glass_z = g0.z;
    // A pane strictly behind the opaque surface at this pixel is
    // occluded (belt and braces — the attribute pass depth-tests too).
    if (opaque_lin_z > 0.0 && glass_z > opaque_lin_z + 0.05) return false;

    // Surface point: invert the stored linear view depth back to NDC z
    // (linZ = b/(a+z)  =>  z = b/linZ - a) and unproject — the EXACT
    // inverse of how the attribute pass encoded it, and the same
    // inv_view_proj reconstruction the resolve uses for opaque pixels.
    // (The first version walked the camera ray by linZ over a
    // facing-vector cosine; any convention drift in that vector put
    // the trace origin inside the wall and both rays died in the dark.)
    float glass_ndc_z = camera_info.depth_params.y / max(glass_z, 1e-3)
                        - camera_info.depth_params.x;
    vec4 gh = camera_info.inv_view_proj *
              vec4(uv * 2.0 - 1.0, glass_ndc_z, 1.0);
    vec3 gpos = gh.xyz / gh.w;
    vec3 ray = normalize(gpos - camera_info.position);

    vec3 N = octDecode(g0.xy);
    if (dot(N, ray) > 0.0) N = -N;         // face the viewer
    float rough = g0.w;
    vec3  tint  = g1.rgb;

    vec3 L = normalize(-runtime_lights.lights[0].direction);
    vec3 sun_col = runtime_lights.lights[0].color *
                   runtime_lights.lights[0].intensity;

    // Fresnel (Schlick) — F0 2% water, 4% glass.
    float cos_t = clamp(dot(N, -ray), 0.0, 1.0);
    const float F0 = 0.02;                 // water
    float F  = F0 + (1.0 - F0) * pow(1.0 - cos_t, 5.0);

    const bool use_hw =
#ifdef HW_RT_SHADOW
        (camera_info.input_features & FEATURE_INPUT_HW_RT_SHADOW) != 0u;
#else
        false;
#endif

    // ── Reflection ray ──────────────────────────────────────────────
    vec3 rdir = normalize(reflect(ray, N));
    float refl_t;
    vec3 refl;
#ifdef HW_RT_SHADOW
    if (use_hw) {
        refl = hwRtGiRadiance(gpos + N * 0.02, rdir, L, sun_col, refl_t);
    } else
#endif
    {
        refl = rtGiRadiance(gpos + N * 0.02, rdir, L, sun_col, refl_t);
    }

    // ── Transmission ray (water) ────────────────────────────────────
    vec3 trans = vec3(0.0);
    {
        vec3 tdir = refract(ray, N, 1.0 / 1.33);
        if (dot(tdir, tdir) < 1e-4) {
            F = 1.0;                        // total internal reflection
        } else {
            tdir = normalize(tdir);
            float hit_t;
#ifdef HW_RT_SHADOW
            if (use_hw) {
                trans = hwRtGiRadiance(gpos - N * 0.02, tdir,
                                       L, sun_col, hit_t);
            } else
#endif
            {
                trans = rtGiRadiance(gpos - N * 0.02, tdir,
                                     L, sun_col, hit_t);
            }
            // Beer-Lambert toward the water tint over the refracted
            // travel distance; ~35% extinction per metre keeps a
            // half-metre shallows readable and a 5 m channel opaque.
            float travel = min(hit_t, 24.0);
            vec3 absorb = exp(-travel * 0.35 *
                              (vec3(1.05) - clamp(tint, 0.0, 1.0)));
            trans = mix(tint * 0.25, trans, absorb);
        }
    }

    // Rough glass scatters its reflection: pull the mirror term toward
    // its own luminance (cheap blur substitute — the reflection ray is
    // 1 spp and the env-mip machinery lives inside the tracer's miss).
    if (rough > 0.15) {
        float rl = dot(refl, vec3(0.2126, 0.7152, 0.0722));
        refl = mix(refl, vec3(rl), clamp((rough - 0.15) * 1.6, 0.0, 0.6));
    }

    out_color = mix(trans, refl, clamp(F, 0.0, 1.0));
    return true;
}

float ssrtShadowFactor(vec3 world_pos, vec3 world_normal, vec2 screen_pixel) {
    vec3 L = normalize(-runtime_lights.lights[0].direction);

    // Nudge off the surface along BOTH the normal and the ray so step 0
    // doesn't immediately re-hit the pixel's own surface.
    vec3 ro = world_pos + world_normal * SSRT_SURFACE_BIAS
                        + L * SSRT_SURFACE_BIAS;

    // Stratified jittered start de-bands the stepped edge (same IGN
    // dither the PCSS kernel uses).
    float jitter = csmIGN(screen_pixel);
    float t_step = SSRT_MAX_DIST / float(SSRT_STEPS);
    float t      = t_step * (0.5 + jitter);

    float a = camera_info.depth_params.x;   // proj[2][2]
    float b = camera_info.depth_params.y;   // proj[3][2]

    for (int i = 0; i < SSRT_STEPS; ++i) {
        vec3 p = ro + L * t;
        t += t_step;
        vec4 clip = camera_info.view_proj * vec4(p, 1.0);
        if (clip.w <= 1e-4) break;              // behind the camera
        vec3 ndc = clip.xyz / clip.w;
        if (ndc.z <= 0.0 || ndc.z >= 1.0) break;
        vec2 suv = ndc.xy * 0.5 + 0.5;
        if (any(lessThan(suv, vec2(0.0))) ||
            any(greaterThan(suv, vec2(1.0))))
            break;                              // ray left the screen

        float scene_z = texture(gbuf_depth, suv).r;
        if (scene_z >= 1.0) continue;           // sky behind this tap

        // Linearise both depths (Vulkan [0,1] perspective:
        // linZ = b / (a + z)) and test "ray point is behind a visible
        // surface, within its assumed thickness".
        float lin_scene = b / (a + scene_z);
        float lin_ray   = b / (a + ndc.z);
        float dz        = lin_ray - lin_scene;
        if (dz > SSRT_SURFACE_BIAS && dz < SSRT_THICKNESS) {
            return 0.0;                         // occluded — hard shadow
        }
    }
    return 1.0;
}

float shadowFactor(vec3 world_pos, vec3 world_normal, vec2 screen_pixel) {
    // Cascade selection — view-space-depth split FIRST, then PROMOTION
    // until the full PCSS sampling kernel fits inside the cascade's
    // shadow map.
    //
    // Why promotion is required: at a cascade transition the receiver
    // projects onto the outer RIM of its depth-selected cascade.  The
    // blocker-search / PCF taps (fixed WORLD radius) then land OUTSIDE
    // the cascade's [0,1] UV range; the edge-clamped reads return the
    // caster-free prefill (1.0), the blocker search finds nothing, and
    // the early-out returns fully LIT — a bright band exactly along the
    // cascade boundary that shifts whenever the camera rotates (the
    // cascade fit moves with the camera).  Successive cascade fits share
    // their boundary slab corners, so the NEXT cascade always covers the
    // rim region with interior margin — step up until the kernel fits
    // (or we're at the last cascade, where edge-clamp is the best we
    // can do).
    float view_depth = -(camera_info.view * vec4(world_pos, 1.0)).z;

    // ── Out-of-max-range guard ──────────────────────────────────────
    // Past the last split no cascade covers this receiver: the depth
    // selection below falls through to the last cascade, the projection
    // lands outside its UV/depth box, and the clamped border reads make
    // the entire far field resolve as occluded.  Fade the shadow term
    // out over the tail of the last cascade and bail out completely
    // once we are past it.
    float range_fade = csmRangeFade(view_depth);
    if (range_fade >= 1.0) return 1.0;

    int cascade = CSM_CASCADE_COUNT - 1;
    for (int i = 0; i < CSM_CASCADE_COUNT; ++i) {
        // cascade_splits is packed vec4[2]; index as [i/4][i%4].
        if (view_depth < runtime_lights.cascade_splits[i >> 2][i & 3]) {
            cascade = i;
            break;
        }
    }

    // Normal-offset bias: shift the sampled position along the surface
    // normal in world space before projecting into shadow clip.
    vec3  N     = normalize(world_normal);
    vec3  L     = normalize(-runtime_lights.lights[0].direction);
    float NdotL = clamp(dot(N, L), 0.0, 1.0);
    vec3  biased_pos = world_pos + N * ((1.0 - NdotL) * CSM_NORMAL_BIAS_SCALE);

    // Per-cascade world→UV scale.  For an orthographic projection
    // M = ortho_diag(2/w_x, 2/w_y, 1/(f-n), 1) * R * T, the first
    // column M[0] = (2/w_x * R_00, 2/w_y * R_10, 1/(f-n) * R_20, 0).
    // For typical CSM setups (sun looking down) length(M[0].xyz) is
    // dominated by 2/w, and length(M[2].xyz) by 1/(f-n).  Each cascade
    // has different w and (f-n), so we extract both factors per cascade
    // and use them to convert world-space constants into the cascade's
    // local UV (XY) and clip-Z spaces.  Without these conversions the
    // SAME constants represent different physical distances per
    // cascade, producing visible intensity / blur steps at boundaries.
    vec2  uv;
    float ref;
    float w2uv;
    for (;;) {
        vec4 lclip = runtime_lights.light_view_proj[cascade] *
                     vec4(biased_pos, 1.0);
        vec3 lndc  = lclip.xyz / lclip.w;
        uv   = lndc.xy * 0.5 + 0.5;
        ref  = lndc.z;
        w2uv = 0.5 *
            length(runtime_lights.light_view_proj[cascade][0].xyz);

        if (cascade >= CSM_CASCADE_COUNT - 1) {
            // Last cascade — nothing left to promote into.  If the
            // receiver projects outside its map or its depth slab there
            // is no shadow data for it, so return lit instead of
            // sampling clamped border texels.
            if (any(lessThan(uv, vec2(0.0))) ||
                any(greaterThan(uv, vec2(1.0))) ||
                ref < 0.0 || ref > 1.0)
                return 1.0;
            break;
        }

        // Kernel margin: the largest UV radius any tap below can use
        // (blocker search disk vs PCF cap), plus a texel of slack.
        float kernel_uv =
            max(CSM_BLOCKER_RADIUS_WORLD, CSM_MAX_PCF_RADIUS_WORLD) * w2uv
            + 1.0 / 2048.0;
        bool fits =
            all(greaterThanEqual(uv, vec2(kernel_uv))) &&
            all(lessThanEqual(uv, vec2(1.0 - kernel_uv))) &&
            ref >= 0.0 && ref <= 1.0;
        if (fits) break;
        ++cascade;   // rim receiver — the next cascade covers it interior
    }
    float z_scale = length(runtime_lights.light_view_proj[cascade][2].xyz);

    // World-space depth bias → per-cascade clip-Z bias.
    float depth_bias =
        (CSM_DEPTH_BIAS_BASE_WORLD +
         CSM_DEPTH_BIAS_SLOPE_WORLD * (1.0 - NdotL)) * z_scale;

    // Per-cascade UV radii derived from the world-space constants.
    float blocker_radius_uv = CSM_BLOCKER_RADIUS_WORLD * w2uv;
    float light_size_uv     = CSM_LIGHT_SIZE_WORLD     * w2uv;
    float min_pcf_radius_uv = CSM_MIN_PCF_RADIUS_WORLD * w2uv;
    float max_pcf_radius_uv = CSM_MAX_PCF_RADIUS_WORLD * w2uv;

    // Per-pixel rotation phase (radians).
    float phi = csmIGN(screen_pixel) * 6.28318530718;

    // ── PCSS step 1: blocker search ─────────────────────────────────
    // Sample CSM_BLOCKER_SAMPLES taps in a fixed-WORLD-radius disk;
    // accumulate depths SHALLOWER than the receiver (occluders closer
    // to the light).  Zero blockers found → fully lit, skip PCF.
    float blocker_sum   = 0.0;
    int   blocker_count = 0;
    for (int i = 0; i < CSM_BLOCKER_SAMPLES; ++i) {
        vec2 off = csmVogelDisk(i, CSM_BLOCKER_SAMPLES, phi)
                       * blocker_radius_uv;
        float d = csmSampleMap(uv + off, cascade);
        if (d < ref - depth_bias) {
            blocker_sum += d;
            ++blocker_count;
        }
    }
    if (blocker_count == 0) return 1.0;
    float avg_blocker_depth = blocker_sum / float(blocker_count);

    // ── PCSS step 2: penumbra estimate ──────────────────────────────
    // Penumbra width ∝ (d_receiver - d_blocker) / d_blocker * light_size.
    // Multiplying by the per-cascade light_size_uv gives a UV-space
    // penumbra whose underlying WORLD size matches across cascades,
    // which is what makes cascade transitions invisible.
    float penumbra = (ref - avg_blocker_depth) /
                     max(avg_blocker_depth, 1e-4);
    float pcf_radius = clamp(penumbra * light_size_uv,
                             min_pcf_radius_uv,
                             max_pcf_radius_uv);

    // ── PCSS step 3: PCF at the computed radius ─────────────────────
    // 16 Vogel-disk taps with the same per-pixel phase as the blocker
    // search — keeps adjacent pixels' patterns decorrelated, so any
    // residual banding is dithered into noise rather than visible
    // contour lines.
    float sum = 0.0;
    for (int i = 0; i < CSM_PCF_SAMPLES; ++i) {
        vec2 off = csmVogelDisk(i, CSM_PCF_SAMPLES, phi) * pcf_radius;
        float map = csmSampleMap(uv + off, cascade);
        sum += (map < 1.0 && ref > map + depth_bias) ? 0.0 : 1.0;
    }
    return mix(sum * (1.0 / float(CSM_PCF_SAMPLES)), 1.0, range_fade);
}

// ═════════════════════════════════════════════════════════════════════
//  Screen-probe GI — trace pass (pass_mode 3) and gather (in main)
// ═════════════════════════════════════════════════════════════════════

// One workgroup == one probe == 64 octahedral texels, so this scratch
// array is exactly the probe's radiance atlas for the current frame.
shared vec3 s_gi_probe_rad[GI_OCTA_TEXELS];

// pass_mode 3.  Dispatched with (probe_dim.x, probe_dim.y, 1) groups —
// NOT the pixel grid.  Traces, temporally accumulates and SH-projects
// one probe; writes nothing to hdr_out.
void giProbeTracePass() {
    ivec2 sz  = imageSize(hdr_out);
    ivec2 dim = giProbeDim(sz);
    ivec2 pid = ivec2(gl_WorkGroupID.xy);
    if (pid.x >= dim.x || pid.y >= dim.y) return;   // workgroup-uniform

    uint nprobes = uint(dim.x) * uint(dim.y);
    uint probe   = uint(pid.y) * uint(dim.x) + uint(pid.x);
    uint texel   = gl_LocalInvocationID.y * uint(GI_OCTA_RES) +
                   gl_LocalInvocationID.x;

    bool parity = (camera_info.input_features &
                   FEATURE_INPUT_RESTIR_PARITY) != 0u;
    uint frame  = (camera_info.input_features & FEATURE_INPUT_FRAME_MASK)
                      >> FEATURE_INPUT_FRAME_SHIFT;

    // ── Anchor the probe on real deferred geometry ───────────────────
    // DETERMINISTIC placement: tile centre first, then a fixed in-tile
    // ring for tiles whose centre lands on sky or on a FORWARD-shaded
    // pixel (no G-buffer normal there).  Every invocation runs the
    // identical loop, so the choice is workgroup-uniform by
    // construction.
    //
    // This used to jitter the anchor by up to 7 px per frame — Lumen
    // does that, and it does let thin geometry get sampled eventually.
    // Here it was the primary source of flicker: a tile straddling a
    // silhouette would anchor on the WALL one frame and the GROUND the
    // next, which (a) fails the probe's own plane/normal history test
    // so the probe restarts from a 1-sample estimate, and (b) fails the
    // GATHER's plane test for the pixels that were using it, dropping
    // them to the flat sky IBL — a bright/dark flip over a whole 16x16
    // block, every frame.  A static anchor makes the history test pass
    // essentially always while the camera is still, which is the case
    // where flicker is most visible.  The rays still jitter (below);
    // that is where the extra coverage comes from now.
    ivec2 org = pid * GI_PROBE_TILE;
    ivec2 ppx = ivec2(-1);
    float pz  = 1.0;
    for (int k = 0; k < 6; ++k) {
        ivec2 off = ivec2(8, 8);
        if (k == 1) off = ivec2(4, 4);
        else if (k == 2) off = ivec2(12, 12);
        else if (k == 3) off = ivec2(4, 12);
        else if (k == 4) off = ivec2(12, 4);
        else if (k == 5) off = ivec2(8, 2);
        ivec2 c = clamp(org + off, ivec2(0), sz - 1);
        vec2  cuv = (vec2(c) + 0.5) / vec2(sz);
        float cz  = textureLod(gbuf_depth, cuv, 0.0).r;
        if (cz >= 1.0) continue;                       // sky
        if (textureLod(gbuf_albedo_ao, cuv, 0.0).a < 0.5) continue;  // forward
        ppx = c;
        pz  = cz;
        break;
    }

    if (ppx.x < 0) {
        // Dead probe: zero the header (history 0 = invalid) so the
        // gather skips it and falls back to the flat sky IBL.
        gi_accum[giAtlasOfs(nprobes, parity, probe, texel)] = vec4(0.0);
        if (texel == 0u) {
            uint h = giHdrOfs(nprobes, parity, probe);
            gi_accum[h]      = vec4(0.0);
            gi_accum[h + 1u] = vec4(0.0);
            for (uint c = 0u; c < 9u; ++c)
                gi_accum[giShOfs(nprobes, parity, probe, c)] = vec4(0.0);
        }
        return;
    }

    vec2 puv   = (vec2(ppx) + 0.5) / vec2(sz);
    vec4 ndc   = vec4(puv * 2.0 - 1.0, pz, 1.0);
    vec4 wh    = camera_info.inv_view_proj * ndc;
    vec3 pwp   = wh.xyz / wh.w;
    vec3 pn    = octDecode(textureLod(gbuf_emissive_metal, puv, 0.0).xy);
    pn = (dot(pn, pn) > 1e-6) ? normalize(pn) : vec3(0.0, 1.0, 0.0);
    float plinz = camera_info.depth_params.y /
                  (camera_info.depth_params.x + pz);

    vec3 tX, tY;
    giOnb(pn, tX, tY);

    // Sub-texel jitter, rotated by the golden pair each frame: the 64
    // directions stay structured (one per octahedral cell) but do not
    // freeze on the same 64 rays, so the temporal history integrates a
    // continuum of directions instead of a fixed lattice.
    vec2 jit2 = vec2(fract(float(frame) * 0.6180339887),
                     fract(float(frame) * 0.7548776662));
    vec2 f    = (vec2(gl_LocalInvocationID.xy) + jit2) / float(GI_OCTA_RES);
    vec3 dl   = giHemiOctDecode(f);
    vec3 rd   = normalize(tX * dl.x + tY * dl.y + pn * dl.z);

    vec3 sun_L   = normalize(-runtime_lights.lights[0].direction);
    vec3 sun_col = runtime_lights.lights[0].color *
                   runtime_lights.lights[0].intensity;

    vec3  rad;
    float t_unused;
#ifdef HW_RT_SHADOW
    if ((camera_info.input_features & FEATURE_INPUT_HW_RT_SHADOW) != 0u) {
        rad = hwRtGiRadiance(pwp + pn * RT_GI_NORMAL_BIAS, rd,
                             sun_L, sun_col, t_unused);
    } else
#endif
    {
        rad = rtGiRadiance(pwp + pn * RT_GI_NORMAL_BIAS, rd,
                           sun_L, sun_col, t_unused);
    }

    // ── Temporal: reproject the PROBE, not the pixel ─────────────────
    // The probe's anchor pixel has a velocity, so last frame's screen
    // position maps to a tile, and that tile's probe is this probe's
    // history — provided it sat on the same surface.  Both tests matter:
    // the plane test catches foreground/background swaps, and the normal
    // test protects the tangent-frame atlas (the 64 texels are stored
    // relative to the probe normal, so a large normal change would
    // reinterpret every one of them).
    float hist     = 1.0;
    vec3  prev_rad = vec3(0.0);
    {
        vec2 uvp = puv - textureLod(gbuf_velocity, puv, 0.0).rg * 0.5;
        if (all(greaterThanEqual(uvp, vec2(0.0))) &&
            all(lessThan(uvp, vec2(1.0)))) {
            ivec2 qpx = clamp(ivec2(uvp * vec2(sz)), ivec2(0), sz - 1);
            ivec2 qid = clamp(qpx / GI_PROBE_TILE, ivec2(0), dim - ivec2(1));
            uint  q   = uint(qid.y) * uint(dim.x) + uint(qid.x);
            uint  qh  = giHdrOfs(nprobes, !parity, q);
            vec4  h0  = gi_accum[qh];
            vec4  h1  = gi_accum[qh + 1u];
            if (h0.w > 0.5 &&
                dot(h1.xyz, pn) > GI_PROBE_N_ACCEPT &&
                abs(dot(pwp - h0.xyz, pn)) <=
                    max(GI_PROBE_PLANE_K * plinz, 0.05)) {
                hist     = min(h0.w + 1.0, GI_PROBE_HIST_MAX);
                prev_rad = gi_accum[
                    giAtlasOfs(nprobes, !parity, q, texel)].rgb;
            }
        }
    }
    vec3 out_rad = (hist > 1.5) ? mix(prev_rad, rad, 1.0 / hist) : rad;

    gi_accum[giAtlasOfs(nprobes, parity, probe, texel)] = vec4(out_rad, 0.0);
    if (texel == 0u) {
        uint h = giHdrOfs(nprobes, parity, probe);
        gi_accum[h]      = vec4(pwp, hist);
        gi_accum[h + 1u] = vec4(pn, plinz);
    }

    // ── SH projection, in shared memory, by the tracing workgroup ────
    // Doing it here (rather than in a second dispatch) costs one barrier
    // and saves a whole pass plus its buffer hazard.  The gather then
    // reads 9 vec4 per probe instead of 64.
    s_gi_probe_rad[texel] = out_rad;
    memoryBarrierShared();
    barrier();
    if (texel == 0u) {
        vec3  c[9];
        float wc[9];              // same projection with radiance == 1
        for (int k = 0; k < 9; ++k) { c[k] = vec3(0.0); wc[k] = 0.0; }
        const float dw = (2.0 * M_PI) / float(GI_OCTA_TEXELS);
        for (int i = 0; i < GI_OCTA_TEXELS; ++i) {
            // Project along the texel's FIXED cell centre, not the
            // frame-jittered direction it was traced along.  The
            // accumulated texel value is the average radiance over its
            // cell, so the cell centre is the correct quadrature point —
            // and, more importantly, it makes the SH basis assignment
            // frame-invariant.  Using jit2 here rotated the whole basis
            // slightly every frame, which showed up as a low-amplitude
            // shimmer on top of everything else.
            vec2 ff = (vec2(float(i % GI_OCTA_RES),
                            float(i / GI_OCTA_RES)) + 0.5) /
                      float(GI_OCTA_RES);
            vec3 d  = giHemiOctDecode(ff);
            vec3 dw_ws = normalize(tX * d.x + tY * d.y + pn * d.z);
            float y[9];
            giShBasis(dw_ws, y);
            vec3 Li = s_gi_probe_rad[i];
            for (int k = 0; k < 9; ++k) {
                c[k]  += Li * (y[k] * dw);
                wc[k] +=      (y[k] * dw);
            }
        }
        // ── White-furnace normalisation ──────────────────────────────
        // The octahedral map is only APPROXIMATELY equal-area (its
        // Jacobian varies ~1.5x corner to centre), and 2nd-order SH
        // truncates energy on top of that.  Both are systematic, and
        // both are measured exactly by projecting a constant radiance
        // of 1 through the identical direction set and asking what
        // irradiance comes back: under a uniform white sky the answer
        // must be 1.  Dividing by it removes the map's directional bias
        // and the truncation loss in one scalar, so an unoccluded probe
        // reproduces the flat sky IBL instead of drifting off it.
        vec3 wcv[9];
        for (int k = 0; k < 9; ++k) wcv[k] = vec3(wc[k]);
        float w_norm = max(giShIrradiance(wcv, pn).x, 1e-3);
        for (int k = 0; k < 9; ++k)
            gi_accum[giShOfs(nprobes, parity, probe, uint(k))] =
                vec4(c[k] / w_norm, 0.0);
    }
}

// Per-pixel reconstruction: bilaterally blend the 4 screen probes around
// this pixel and evaluate their Lambert-convolved SH along N.  Returns
// false when no probe around this pixel is usable (all sky / all on a
// different surface), in which case the caller keeps the flat sky IBL.
// N_geom drives the WEIGHTS (it is what the probes stored, so it is the
// only normal the plane/facing tests can compare against); N_shade is
// what the SH is EVALUATED along, so normal-mapped detail still shapes
// the indirect diffuse the way it does in the forward IBL path.
bool giProbeGather(ivec2 px, ivec2 sz, vec3 world_pos, vec3 N,
                   vec3 N_shade, float view_lin_z, out vec3 o_E) {
    ivec2 dim     = giProbeDim(sz);
    uint  nprobes = uint(dim.x) * uint(dim.y);
    bool  parity  = (camera_info.input_features &
                     FEATURE_INPUT_RESTIR_PARITY) != 0u;

    // Probe centres are tile centres, so probe-grid space is the pixel
    // divided by the tile size, shifted half a tile.
    vec2  pf = (vec2(px) + 0.5) / float(GI_PROBE_TILE) - 0.5;
    ivec2 p0 = ivec2(floor(pf));
    vec2  fr = fract(pf);

    // Plane-distance falloff scaled to roughly one probe spacing at this
    // depth — a neighbour probe a tile-width off my tangent plane is a
    // different surface and must not bleed onto me.
    float plane_scale = 1.0 / max(GI_PROBE_PLANE_K * view_lin_z, 0.05);

    // TWO accumulators, filled in one pass:
    //   strict — bilinear x normal x plane, the correct reconstruction;
    //   loose  — bilinear over any VALID probe, plane test ignored.
    // The loose one exists because the alternative when the strict test
    // finds nothing is to fall back to the flat sky IBL, and that is a
    // huge brightness step.  A pixel near a silhouette can pass the
    // strict test one frame and fail it the next, and flipping between
    // "traced GI" and "full unoccluded skylight" over a whole tile is
    // the single most visible flicker this path can produce.  A
    // neighbouring probe on a slightly different plane is a much
    // smaller error than the open-sky cube, and it moves smoothly.
    vec3  sum   = vec3(0.0);
    float wsum  = 0.0;
    vec3  sum_l = vec3(0.0);
    float wsum_l = 0.0;
    for (int j = 0; j < 2; ++j) {
        for (int i = 0; i < 2; ++i) {
            ivec2 pc = p0 + ivec2(i, j);
            if (any(lessThan(pc, ivec2(0))) ||
                any(greaterThanEqual(pc, dim))) continue;
            uint q  = uint(pc.y) * uint(dim.x) + uint(pc.x);
            uint hb = giHdrOfs(nprobes, parity, q);
            vec4 h0 = gi_accum[hb];
            if (h0.w < 0.5) continue;                    // invalid probe
            vec4 h1 = gi_accum[hb + 1u];

            vec3 c[9];
            uint sb = giShOfs(nprobes, parity, q, 0u);
            for (int k = 0; k < 9; ++k) c[k] = gi_accum[sb + uint(k)].rgb;
            vec3 E = giShIrradiance(c, N_shade);

            // Small floor on the bilinear term so a pixel sitting
            // exactly on a probe centre still gets its neighbours if
            // that probe happens to be the invalid one.
            float wb = (i == 0 ? 1.0 - fr.x : fr.x) *
                       (j == 0 ? 1.0 - fr.y : fr.y) + 0.05;
            sum_l  += E * wb;
            wsum_l += wb;

            float wn = dot(N, h1.xyz);
            if (wn <= 0.0) continue;                     // facing away
            float pd = abs(dot(world_pos - h0.xyz, N)) * plane_scale;
            float w  = wb * (wn * wn) * exp(-pd * pd);
            if (w <= 1e-5) continue;
            sum  += E * w;
            wsum += w;
        }
    }
    if (wsum > 1e-4)   { o_E = sum   / wsum;   return true; }
    if (wsum_l > 1e-4) { o_E = sum_l / wsum_l; return true; }
    o_E = vec3(0.0);
    return false;
}

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
void main() {
    // Screen-probe GI trace runs on a completely different thread
    // mapping (one workgroup per probe) — branch out before anything
    // below interprets gl_GlobalInvocationID as a pixel.
    if (rpc.pass_mode == 3u) {
        giProbeTracePass();
        return;
    }
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(hdr_out);
    if (px.x >= sz.x || px.y >= sz.y) return;

    vec2 uv = (vec2(px) + vec2(0.5)) / vec2(sz);

    // Hi-Z debug visualisation runs BEFORE the sentinel checks below so
    // it covers every pixel on screen, not just cluster fragments.  The
    // mip level comes from input_features bits 24..27, packed by the CPU
    // each frame from the menu's Hi-Z mip slider.
    {
        uint dbg = (camera_info.input_features & FEATURE_INPUT_DEBUG_MODE_MASK)
                       >> FEATURE_INPUT_DEBUG_MODE_SHIFT;
        if (dbg == DEBUG_RENDER_MODE_HIZ) {
            uint mip = (camera_info.input_features & FEATURE_INPUT_HIZ_MIP_MASK)
                           >> FEATURE_INPUT_HIZ_MIP_SHIFT;
            float h = clamp(textureLod(hiz_pyramid, uv, float(mip)).r,
                            0.0, 1.0);

            // Linearise the Hi-Z depth so the visualisation actually
            // shows world-space distance, not perspective-compressed Z
            // (which packs every visible scene depth into the [0.95, 1.0]
            // tail and makes a raw greyscale display look uniformly
            // bright).  For Vulkan's [0,1] depth perspective:
            //   linearZ = b / (a + ndc_z)
            // where a = proj[2][2], b = proj[3][2] — already stashed by
            // ViewCamera::updateViewCameraInfo into depth_params.x/.y.
            // h == 1.0 corresponds to the far plane: linearZ = far,
            // so sky / never-written pixels show as white at the
            // chosen kVizFarRange.
            float a = camera_info.depth_params.x;
            float b = camera_info.depth_params.y;
            float linZ = b / (a + h);

            // Map linearZ to greyscale over a useful viewing band.  50 m
            // is "near-mid scene"; tweak if your level is bigger or
            // smaller.  Beyond this distance pixels saturate to white
            // — they're behind everything visible anyway.
            const float kVizFarRange = 50.0;
            float vis = clamp(linZ / kVizFarRange, 0.0, 1.0);

            imageStore(hdr_out, px, vec4(linearTosRGB(vec3(vis)), 1.0));
            return;
        }
    }

    // ── Render-path debug: WHO shaded this pixel ────────────────────
    // Runs before the sentinel early-outs below, because the whole point
    // is to report on the pixels this pass would otherwise SKIP.
    //
    // The test is the engine's own forward/deferred sentinel: the
    // cluster G-buffer is cleared to alpha 0 and every GBUFFER_OUTPUT
    // branch writes albedo_ao.a >= 0.5, so alpha < 0.5 on a pixel that
    // HAS depth means "no G-buffer fragment here — a forward writer owns
    // this pixel and its colour is already in hdr_out".
    //
    // Why this matters: only the deferred side runs RT GI, traced sky
    // visibility and ReSTIR.  Anything red in this view is lit by the
    // raw IBL cubes with no occlusion at all, which is the difference
    // between a room that goes dark indoors and one that renders as
    // bright as the lawn outside.
    {
        uint dbg_path =
            (camera_info.input_features & FEATURE_INPUT_DEBUG_MODE_MASK)
                >> FEATURE_INPUT_DEBUG_MODE_SHIFT;
        bool path_view = (dbg_path == DEBUG_RENDER_MODE_RENDER_PATH);
        bool hide_fwd =
            (camera_info.input_features & FEATURE_INPUT_HIDE_FORWARD) != 0u;
        bool hide_def =
            (camera_info.input_features & FEATURE_INPUT_HIDE_DEFERRED) != 0u;
        if (path_view || hide_fwd || hide_def) {
            float z_path = texture(gbuf_depth, uv).r;
            // Glass/water pixels first: CYAN in the path view, so "are
            // the attributes even being written" is answerable at a
            // glance (a black window with no cyan here means the
            // glass-attribute pass never covered it).
            if (path_view) {
                float dbg_kind = texture(gbuf_glass_tint, uv).a;
                if (dbg_kind > 0.1) {
                    vec3 c = dbg_kind > 0.9 ? vec3(0.15, 0.55, 0.95)
                                            : vec3(0.10, 0.95, 0.90);
                    imageStore(hdr_out, px, vec4(linearTosRGB(c), 1.0));
                    return;
                }
            }
            if (z_path < 1.0) {                       // sky stays untouched
                vec4 aa_path = texture(gbuf_albedo_ao, uv);
                bool is_forward = aa_path.a < 0.5;
                if (is_forward) {
                    if (hide_fwd) {
                        imageStore(hdr_out, px, vec4(0.0, 0.0, 0.0, 1.0));
                        return;
                    }
                    if (path_view) {
                        // No G-buffer to shade with, so shape comes from
                        // depth: nearer reads brighter.  Flat-ish red is
                        // deliberate — this pixel is the problem case.
                        float linz = camera_info.depth_params.y /
                                     (camera_info.depth_params.x + z_path);
                        float sh = clamp(1.0 - linz / 300.0, 0.30, 1.0);
                        imageStore(hdr_out, px,
                                   vec4(linearTosRGB(
                                       vec3(0.95, 0.16, 0.12) * sh), 1.0));
                        return;
                    }
                } else {
                    if (hide_def) {
                        imageStore(hdr_out, px, vec4(0.0, 0.0, 0.0, 1.0));
                        return;
                    }
                    if (path_view) {
                        // G-buffer albedo gives this side real surface
                        // detail, so the two halves are told apart by hue
                        // AND by texture, not hue alone.
                        float luma = dot(aa_path.rgb,
                                         vec3(0.2126, 0.7152, 0.0722));
                        float sh = 0.35 + 0.65 * clamp(luma, 0.0, 1.0);
                        imageStore(hdr_out, px,
                                   vec4(linearTosRGB(
                                       vec3(0.18, 0.95, 0.34) * sh), 1.0));
                        return;
                    }
                }
            }
        }
    }

    // Sky / empty pixels: depth was never written by the cluster G-buffer
    // pass.  Skip — sky envmap pass paints these later in drawScene.
    // In GEN mode store the INVALID sentinel (see RT_SMOOTH_INVALID) so
    // the à-trous pass neither smears uninitialised texels across
    // geometry edges nor treats this pixel as a real measurement.
    float z = texture(gbuf_depth, uv).r;
    if (z >= 1.0) {
        if (rpc.pass_mode == 1u) {
            imageStore(rt_raw_out, px, vec4(RT_SMOOTH_INVALID));
            return;
        }
        // Glass/water over open sky (a pane against the horizon, the
        // far reach of the river): nothing opaque behind, so the
        // transmission ray's miss-to-sky IS the correct background.
        {
            vec3 gcol;
            if (glassWaterOverlay(uv, px, -1.0, gcol)) {
                imageStore(hdr_out, px, vec4(sceneTonemap(gcol), 1.0));
            }
        }
        return;
    }

    vec4 albedo_ao = texture(gbuf_albedo_ao, uv);
    // Cluster G-buffer is CLEARed to (0,0,0,0) before the pass and the
    // GBUFFER_OUTPUT branch always writes albedo_ao.a = 1.0 — so an
    // alpha sentinel of < 0.5 means "no cluster fragment hit this pixel".
    // Forward base (terrain/grass/hair/...) already lit these pixels in
    // its own forward pass; leave their colour alone.
    if (albedo_ao.a < 0.5) {
        if (rpc.pass_mode == 1u) {
            // INVALID, not "lit and open".  This pixel belongs to a
            // FORWARD writer (grass, hair, ground clutter, water) and
            // no shadow ray was traced for it — see RT_SMOOTH_INVALID.
            imageStore(rt_raw_out, px, vec4(RT_SMOOTH_INVALID));
            return;
        }
        // THE glass path: a window pane / water surface wrote depth in
        // its forward pass, so the pixel has depth but no G-buffer —
        // and the attribute pass tagged it.  Both secondary rays are
        // traced from the surface point; the traced transmission sees
        // the room behind the window and the river bed under the
        // water, neither of which the screen has.
        {
            float fwd_lin_z = camera_info.depth_params.y /
                              (camera_info.depth_params.x + z);
            vec3 gcol;
            if (glassWaterOverlay(uv, px, fwd_lin_z * 1.02, gcol)) {
                imageStore(hdr_out, px, vec4(sceneTonemap(gcol), 1.0));
            }
        }
        return;
    }

    vec4 nr          = texture(gbuf_normal_rough, uv);
    vec4 em          = texture(gbuf_emissive_metal, uv);

    vec3  albedo    = albedo_ao.rgb;
    float ao        = albedo_ao.a;
    vec3  N         = octDecode(nr.xy);
    // Geometric (un-perturbed) normal — encoded into em.xy by the GBuffer
    // writer in cluster_bindless.frag.  See the comment there for why it
    // was packed into the emissive slot's RG channels.  Used by the
    // GEOMETRIC_NORMAL debug visualisation below; without it that mode
    // would be identical to the NORMAL mode (the only normal in the
    // GBuffer would be the perturbed one).
    vec3  N_geom    = octDecode(em.xy);
    // (roughness in nr.z and metallic in em.a are reserved for the eventual
    // GGX path; the current resolve uses Blinn-Phong to match the legacy
    // forward output 1:1, so they're sampled but not yet consumed here.)
    // em.b is reserved for emissive intensity once cluster materials
    // start authoring it; for now treat emissive as zero.
    vec3  emissive  = vec3(0.0);

    // Reconstruct world position from depth + inv_view_proj.
    vec4 ndc = vec4(uv * 2.0 - 1.0, z, 1.0);
    vec4 world_h = camera_info.inv_view_proj * ndc;
    vec3 world_pos = world_h.xyz / world_h.w;

    vec3 V = normalize(camera_info.position - world_pos);

    // ── Face-forward the G-buffer normals ────────────────────────────
    // A VISIBLE opaque fragment cannot have its geometric normal
    // pointing away from the camera: if it does, the normal is
    // inverted (wrong winding, a two-sided wall slab whose back face
    // won the depth test, a mirrored instance transform).  This matters
    // far more than it sounds, because N_geom is what launches every RT
    // GI ray: an inverted normal starts the ray BEHIND the surface and
    // fires the whole cosine hemisphere INTO the object, so every
    // sample hits interior geometry and the estimator returns ~0.  That
    // is a white wall shading pure black while its forward-rendered
    // trim beside it looks correct — which is exactly the symptom this
    // was found from.  One dot product; correct for single- and
    // double-sided geometry alike.
    if (dot(N_geom, V) < 0.0) {
        N_geom = -N_geom;
        if (dot(N, V) < 0.0) N = -N;
    }

    vec3 L = normalize(-runtime_lights.lights[0].direction);
    vec3 light_col = runtime_lights.lights[0].color *
                     runtime_lights.lights[0].intensity;
    float NdotL = max(dot(N, L), 0.0);

    // ── ReSTIR direct lighting (sun as area light + point lights) ────
    // Replaces the single-sun direct term entirely; ambient IBL and the
    // RT-AO logic below still apply.  The winner's visibility feeds the
    // SHADOW debug view via `shad`.
    bool restir_active =
        (camera_info.input_features & FEATURE_INPUT_RESTIR) != 0u;
    vec3 restir_direct = vec3(0.0);

    float shad = 1.0;
    if (rpc.pass_mode == 2u) {
        // APPLY pass: shadow + AO were traced by the GEN dispatch and
        // smoothed by rt_filter.comp — no tracing here.  Values are
        // consumed after the AO block below.
    } else if (restir_active) {
        restir_direct = restirDirectLighting(
            px, sz, uv, world_pos, N, N_geom, albedo, V, shad);
    } else
#ifdef HW_RT_SHADOW
    if ((camera_info.input_features & FEATURE_INPUT_HW_RT_SHADOW) != 0u) {
        // Hardware ray query vs the cluster TLAS (cone-jittered soft
        // shadow).  Same facing-away early-out as the software path.
        shad = (dot(N_geom, L) <= 0.0)
                   ? 0.0
                   : hwRtShadowFactor(world_pos, N_geom, vec2(px));
    } else
#endif
    if ((camera_info.input_features & FEATURE_INPUT_RT_SHADOW) != 0u) {
        // World-space software raytraced shadows (cluster BVH traversal,
        // cone-jittered soft shadow).
        // Surfaces facing away from the sun are geometrically
        // self-shadowed — skip the (expensive) BVH walk entirely.
        // Kills the trace for roughly the back half of the scene's
        // pixels at zero visual cost (diffuse/spec are ~0 there anyway).
        shad = (dot(N_geom, L) <= 0.0)
                   ? 0.0
                   : rtShadowFactor(world_pos, N_geom, vec2(px));
    } else if ((camera_info.input_features & FEATURE_INPUT_SSRT_SHADOW) != 0u) {
        // Software screen-space raytraced shadows — checked BEFORE the
        // disabled flag: the app sets SHADOW_DISABLED alongside SSRT to
        // silence CSM sampling in the forward shaders, but the deferred
        // pixels still get ray-marched shadows here.
        shad = ssrtShadowFactor(world_pos, N_geom, vec2(px));
    } else if ((camera_info.input_features & FEATURE_INPUT_SHADOW_DISABLED) == 0u) {
        // Use the geometric (un-perturbed) normal for shadow biasing —
        // normal-mapped perturbations can give inconsistent bias at
        // texel-detail scale and re-introduce acne on bumpy surfaces.
        // Pass the compute-shader pixel coordinate as the dither key
        // so adjacent pixels get decorrelated Vogel-disk rotations.
        shad = shadowFactor(world_pos, N_geom, vec2(px));
    }

    // Ray-traced AO — replaces the screen-space SSAO post pass while an
    // RT shadow mode is active (the app skips that pass and raises
    // FEATURE_INPUT_RT_AO instead; every other mode keeps SSAO).
    // Folded into the AMBIENT term only: direct sun light is already
    // occlusion-tested per pixel by the shadow rays above, so darkening
    // it again would double-occlude.
    float rt_ao = 1.0;
    if (rpc.pass_mode != 2u &&
        (camera_info.input_features & FEATURE_INPUT_RT_AO) != 0u) {
#ifdef HW_RT_SHADOW
        if ((camera_info.input_features &
             FEATURE_INPUT_HW_RT_SHADOW) != 0u) {
            rt_ao = hwRtAoFactor(world_pos, N_geom, vec2(px));
        } else
#endif
        if ((camera_info.input_features &
             (FEATURE_INPUT_RT_SHADOW | FEATURE_INPUT_RESTIR)) != 0u) {
            rt_ao = rtAoFactor(world_pos, N_geom, vec2(px));
        }
    }

    // ── Smooth-pass routing ──────────────────────────────────────────
    // GEN: hand the RAW (pre-shaping) shadow + AO to the filter chain and
    // stop — the APPLY dispatch does the shading.  APPLY: pick up the
    // bilateral-filtered pair.  The AO response curve applies AFTER the
    // filter either way, so smoothing operates in linear visibility.
    if (rpc.pass_mode == 1u) {
        imageStore(rt_raw_out, px, vec4(shad, rt_ao, 0.0, 0.0));
        return;
    }
    if (rpc.pass_mode == 2u) {
        vec2 f = imageLoad(rt_filtered_in, px).rg;
        shad  = clamp(f.r, 0.0, 1.0);
        rt_ao = clamp(f.g, 0.0, 1.0);
    }

    rt_ao = pow(clamp(rt_ao, 0.0, 1.0), RT_AO_POWER);

    // ── PBR metal-rough shading (GGX) ────────────────────────────────
    // Replaces the legacy Lambert + fixed-exponent Blinn-Phong.  The
    // G-buffer's roughness (nr.z — real material roughness for terrain,
    // per-material-class default for clusters) and metallic (em.a) now
    // actually drive the BRDF, and the ambient term gains the GGX
    // specular IBL that the forward PBR shaders (base.frag / tile.frag)
    // always had.  Under ReSTIR the direct term still comes fully from
    // the reservoir winner; ambient IBL applies either way.
    float perceptual_rough = clamp(nr.z, 0.045, 1.0);
    float alpha_rough      = perceptual_rough * perceptual_rough;
    float metallic         = clamp(em.a, 0.0, 1.0);
    vec3  f0               = mix(vec3(0.04), albedo, metallic);
    vec3  c_diff           = albedo * (1.0 - metallic);

    // Same mip count the forward IBL path assumes for the GGX env cube.
    const float kIblMipCount = 10.0;

    // ── Ambient diffuse: traced 1-bounce GI, or the flat sky IBL ─────
    // The flat lambertian cube delivers FULL skylight to every pixel —
    // under a canopy, inside a courtyard, at the bottom of a valley —
    // which is a large part of the scene reading over-bright.  With
    // RT GI active, one cosine ray per pixel replaces it: sky radiance
    // only where sky is actually visible, sunlit bounce colour where
    // it is not, temporally accumulated (reprojected by the velocity
    // buffer, ReSTIR-style parity ping-pong) so 1 spp converges.
    // Unoccluded sky irradiance at this normal — both the no-GI value
    // and, scaled by RT_GI_AMBIENT_FLOOR below, the floor under every
    // traced estimate.
    vec3 ambient_flat    = getIBLRadianceLambertian(N, c_diff) * ao;
    vec3 ambient_diffuse = ambient_flat * rt_ao;
    // Traced sky visibility for the OTHER ambient terms (specular IBL).
    // 1.0 when RT GI is off (flat-IBL behaviour unchanged); under RT GI
    // it becomes the ratio of the traced irradiance estimate to the flat
    // "full open sky" lambertian estimate at the same normal — ~1 in the
    // open, ~0 inside an enclosed room, in between at windows/doorways.
    float traced_sky_vis = 1.0;
    // Raw estimate kept aside for DEBUG_RENDER_MODE_INDIRECT.  Seeded
    // with the flat-IBL value so the view still reads correctly when RT
    // GI is off entirely.
    vec3 gi_debug_E = texture(lambertian_env_sampler, N).rgb *
                      kIblIrradianceScale;
#ifndef USE_HDR
    gi_debug_E = sRGBToLinear(gi_debug_E);
#endif
    gi_debug_E *= (ao * rt_ao);
    if ((camera_info.input_features &
         (FEATURE_INPUT_RT_GI | FEATURE_INPUT_GI_SCREEN_PROBE)) ==
        (FEATURE_INPUT_RT_GI | FEATURE_INPUT_GI_SCREEN_PROBE)) {
        // ── Lumen-style screen probe gather ──────────────────────────
        // All the tracing already happened in the pass_mode 3 dispatch
        // (0.25 rays/pixel, coherent, one probe per 16x16 tile).  What
        // is left here is a 4-tap bilateral blend of pre-integrated SH —
        // no rays, no per-pixel history, nothing that scales with ray
        // cost.  Falls back to the flat sky IBL only where every
        // neighbouring probe is unusable.
        float view_lin_z =
            camera_info.depth_params.y / (camera_info.depth_params.x + z);
        vec3 gi_E;
        if (giProbeGather(px, sz, world_pos, N_geom, N, view_lin_z, gi_E)) {
            gi_debug_E      = gi_E;
            ambient_diffuse = c_diff * gi_E * ao;
            vec3 flat_sky = texture(lambertian_env_sampler, N).rgb *
                        kIblIrradianceScale;
#ifndef USE_HDR
            flat_sky = sRGBToLinear(flat_sky);
#endif
            traced_sky_vis = clamp(
                restirLuma(gi_E) / max(restirLuma(flat_sky), 1e-4),
                0.0, 1.0);
        }
    } else if ((camera_info.input_features & FEATURE_INPUT_RT_GI) != 0u) {
        uint  gi_w    = uint(sz.x);
        uint  gi_half = uint(sz.x) * uint(sz.y);
        bool  gi_par  =
            (camera_info.input_features & FEATURE_INPUT_RESTIR_PARITY) != 0u;
        uint  gi_wofs = gi_par ? gi_half : 0u;
        uint  gi_rofs = gi_par ? 0u : gi_half;
        float gi_frame = float(
            (camera_info.input_features & FEATURE_INPUT_FRAME_MASK)
                >> FEATURE_INPUT_FRAME_SHIFT);
        // Frame-rotated interleaved-gradient pair → cosine direction.
        vec2 xi = vec2(
            fract(csmIGN(vec2(px)) + gi_frame * 0.6180339887),
            fract(csmIGN(vec2(px) + vec2(37.0, 17.0)) +
                  gi_frame * 0.7548776662));
        vec3 gi_dir = rtCosHemisphereDir(N_geom, xi);
        // Hardware TLAS closest-hit when this variant has it and the
        // AS is armed — the software-BVH closest-hit walk is orders of
        // magnitude slower and was serialising the whole resolve.
        vec3 gi_s;
#ifdef HW_RT_SHADOW
        if ((camera_info.input_features & FEATURE_INPUT_HW_RT_SHADOW)
            != 0u) {
            float gi_t_unused;
            gi_s = hwRtGiRadiance(
                world_pos + N_geom * RT_GI_NORMAL_BIAS, gi_dir,
                L, light_col, gi_t_unused);
        } else
#endif
        {
            float gi_t_unused;
            gi_s = rtGiRadiance(
                world_pos + N_geom * RT_GI_NORMAL_BIAS, gi_dir,
                L, light_col, gi_t_unused);
        }

        // Temporal accumulation with velocity reprojection.
        //
        // Disocclusion rejection: the reprojected texel can belong to a
        // DIFFERENT surface (an edge revealed by camera/object motion),
        // and blending 90%+ of a wrong-surface history is exactly the
        // ghost trail the accumulation used to smear across depth edges.
        // The accumulator's .w now packs (history, linear view depth) as
        // 2x16-bit halves; history survives only when the stored depth
        // matches this pixel's depth within RT_GI_DEPTH_REJECT — else we
        // fall back to the fresh 1-spp sample (hist = 1).  Old-format /
        // zero-cleared texels unpack to history 0 and self-reject, so no
        // buffer versioning is needed.  Vulkan [0,1] perspective:
        // linZ = b / (a + z), a/b prestashed in depth_params (see the
        // SSRT + Hi-Z paths above).
        float view_lin_z =
            camera_info.depth_params.y / (camera_info.depth_params.x + z);
        vec3  gi_E  = gi_s;
        float hist  = 1.0;
        vec2  uv_prev = uv - texture(gbuf_velocity, uv).rg * 0.5;
        if (all(greaterThanEqual(uv_prev, vec2(0.0))) &&
            all(lessThan(uv_prev, vec2(1.0)))) {
            ivec2 pp = clamp(ivec2(uv_prev * vec2(sz)),
                             ivec2(0), sz - 1);
            vec4 prev = gi_accum[gi_rofs + uint(pp.y) * gi_w + uint(pp.x)];
            vec2 prev_hd = unpackHalf2x16(floatBitsToUint(prev.w));
            bool same_surface =
                prev_hd.x > 0.5 &&
                abs(prev_hd.y - view_lin_z) <=
                    RT_GI_DEPTH_REJECT * max(view_lin_z, 1e-3);
            if (same_surface) {
                hist = min(prev_hd.x + 1.0, RT_GI_HIST_MAX);
                gi_E = mix(prev.rgb, gi_s, 1.0 / hist);
            }
        }
        // Depth clamped under half-float max so far-field pixels never
        // pack to +inf (which would poison the compare next frame).
        gi_accum[gi_wofs + uint(px.y) * gi_w + uint(px.x)] =
            vec4(gi_E, uintBitsToFloat(packHalf2x16(
                vec2(hist, min(view_lin_z, 65000.0)))));
        // Cosine-sampled estimator: E[L(dir)] IS irradiance/PI, so the
        // diffuse ambient is simply c_diff * estimate.  Micro-AO from
        // the G-buffer still applies; rt_ao does NOT (the trace already
        // measured the occlusion rt_ao approximates).
        gi_debug_E = gi_E;
        ambient_diffuse = c_diff * gi_E * ao;

        // Derive the sky-visibility scale for the specular IBL from the
        // SAME traced result: luma(traced estimate) / luma(flat-sky
        // estimate at N).  Enclosed pixels (gi_E ~ 0 while the cube says
        // "full sky") drive this to 0; open pixels to ~1; bounce-lit
        // pixels can exceed the flat estimate, hence the clamp.  This
        // reuses the accumulated gi_E, so the scale is temporally smooth
        // for free — no extra rays.
        vec3 flat_sky = texture(lambertian_env_sampler, N).rgb *
                        kIblIrradianceScale;
#ifndef USE_HDR
        flat_sky = sRGBToLinear(flat_sky);
#endif
        traced_sky_vis = clamp(
            restirLuma(gi_E) / max(restirLuma(flat_sky), 1e-4), 0.0, 1.0);
    }

    // Specular (GGX) IBL was the last UNGATED enclosed-pixel light term:
    // rt_ao is 1.0 whenever RT AO is toggled off, and even when on its
    // 2 m hemisphere rays read most of a room-sized interior as "open" —
    // either way the environment cube delivered full skylight to fully
    // enclosed pixels, which is why closed interiors rendered as bright
    // as outdoors.  Scale it by the traced sky visibility so it follows
    // the same architecture the GI diffuse uses: dark inside, lit at
    // real openings.
    // ── Floor the traced estimate ────────────────────────────────────
    // See RT_GI_AMBIENT_FLOOR.  A no-op when GI is off (the flat value
    // is already above its own fraction) and a no-op wherever the
    // tracer returns a healthy estimate; it only catches the pixels the
    // estimator gave up on.  traced_sky_vis is floored with it so the
    // specular IBL cannot be driven to zero on the same pixels either.
    ambient_diffuse = max(ambient_diffuse,
                          ambient_flat * RT_GI_AMBIENT_FLOOR);
    traced_sky_vis  = max(traced_sky_vis, RT_GI_AMBIENT_FLOOR);

    // ── DEBUG: raw indirect diffuse, albedo NOT applied ──────────────
    // Answers the one question a black wall cannot answer by itself:
    // is no light arriving, or is the material dark?  Bright here means
    // the GI estimator is working and the surface is simply dark;
    // black here means the bounce path is delivering nothing.
    {
        uint dbg_gi =
            (camera_info.input_features & FEATURE_INPUT_DEBUG_MODE_MASK)
                >> FEATURE_INPUT_DEBUG_MODE_SHIFT;
        if (dbg_gi == DEBUG_RENDER_MODE_INDIRECT && rpc.pass_mode != 1u) {
            imageStore(hdr_out, px, vec4(sceneTonemap(gi_debug_E), 1.0));
            return;
        }
    }

    vec3 ambient = ambient_diffuse +
        getIBLRadianceGGX(N, V, perceptual_rough, f0, kIblMipCount) *
            (ao * rt_ao * traced_sky_vis);

    vec3 diffuse = restir_active
        ? restir_direct
        : c_diff * light_col * (NdotL * shad / M_PI);

    vec3 specular = vec3(0.0);
    if (!restir_active && NdotL > 0.0) {
        float NdotV = clampedDot(N, V);
        vec3  H     = normalize(L + V);
        float NdotH = clampedDot(N, H);
        float VdotH = clampedDot(V, H);
        vec3  F     = F_Schlick(f0, vec3(1.0), VdotH);
        float Vis   = V_GGX(NdotL, NdotV, alpha_rough);
        float D     = D_GGX(NdotH, alpha_rough);
        specular    = light_col * (F * (Vis * D) * NdotL * shad);
    }

    // Thin-leaf subsurface scattering.  The G-buffer writer set
    // normal_rough.w = 1.0 for materials flagged BINDLESS_MAT_FOLIAGE_SSS
    // (leaf materials, tagged by name at cluster upload).  Identical
    // term to the forward branch in cluster_bindless.frag so a tree
    // shades the same before and after its clusters finalize.  Under
    // ReSTIR the sun term is reservoir-driven, but the translucency
    // stays sun-only — an approximation, and a stable one, since the
    // sun dominates every outdoor pixel this flag ever touches.
    vec3 sss = vec3(0.0);
    if (nr.w > 0.5) {
        sss = foliageTranslucency(N, V, L, albedo, light_col, shad);
    }

    // RT AO partially dims the direct terms too (RT_AO_DIRECT_FRACTION)
    // for parity with the screen-space SSAO look, which multiplied the
    // final colour.  rt_ao is 1.0 whenever RT AO is inactive.
    vec3 color = ambient +
                 (diffuse + specular + sss) *
                     mix(1.0, rt_ao, RT_AO_DIRECT_FRACTION) +
                 emissive;

    // Render-debug overrides — same modes/codes as the forward path so
    // toggling deferred mode in the menu stays consistent for debugging.
    uint dbg_mode =
        (camera_info.input_features & FEATURE_INPUT_DEBUG_MODE_MASK)
            >> FEATURE_INPUT_DEBUG_MODE_SHIFT;
    if (dbg_mode == DEBUG_RENDER_MODE_ALBEDO) {
        color = albedo;
    } else if (dbg_mode == DEBUG_RENDER_MODE_NORMAL) {
        color = N * 0.5 + 0.5;
    } else if (dbg_mode == DEBUG_RENDER_MODE_GEOMETRIC_NORMAL) {
        color = N_geom * 0.5 + 0.5;
    } else if (dbg_mode == DEBUG_RENDER_MODE_DIFFUSE) {
        color = ambient + diffuse;
    } else if (dbg_mode == DEBUG_RENDER_MODE_SPECULAR) {
        color = specular;
    } else if (dbg_mode == DEBUG_RENDER_MODE_SHADOW) {
        color = vec3(shad);
    } else if (dbg_mode == DEBUG_RENDER_MODE_ROUGHNESS) {
        color = vec3(nr.z);
    } else if (dbg_mode == DEBUG_RENDER_MODE_METALLIC) {
        color = vec3(em.a);
    } else if (dbg_mode == DEBUG_RENDER_MODE_VELOCITY) {
        // Visualise the screen-space NDC delta the cluster G-buffer pass
        // wrote into RT3.  Scale by 50 so the typical (small) per-frame
        // motion is visible — pan the camera fast and individual pixels
        // start to saturate the [0,1] colour range.  Encoding:
        //   grey  = no motion             (0,0)
        //   red   = +X NDC motion         (camera panning left)
        //   cyan  = -X NDC motion         (camera panning right)
        //   green = +Y NDC motion         (camera tilting down)
        //   magenta= -Y NDC motion        (camera tilting up)
        // Sky / forward-base pixels stayed at the (0,0) clear → grey.
        const float kVelocityViewScale = 50.0;
        vec2 v = texture(gbuf_velocity, uv).rg * kVelocityViewScale;
        color = vec3(v * 0.5 + 0.5, 0.5);
    } else if (dbg_mode == DEBUG_RENDER_MODE_SSAO) {
        // Output pure white; ssao_apply.comp runs after this pass and
        // multiplies in the AO factor, so the screen ends up showing
        // vec3(ao) — raw AO factor as a grayscale image.  See
        // cluster_bindless.frag's matching branch + SSAO::render's
        // force_run gate when this mode is active.
        color = vec3(1.0);
    }

    // ── Soft highlight compression ───────────────────────────────────
    // The PBR path lights with full sun + sky-IBL energy, and on bright
    // albedo (snow, white plaster) the sum sits well above 1.0 — without
    // compression the whole surface clips to flat white and the CSM/RT
    // shadow term becomes invisible (a 0.85 shadowed pixel vs a 1.3
    // clipped one both display ~white).  Piecewise curve: linear (i.e.
    // untouched) below the knee, Reinhard-style rolloff above it with an
    // asymptote at 1.0.  Applied on luminance so hue is preserved, and
    // ONLY above the knee so mid-tones and dark pixels are bit-identical
    // to the uncompressed output.  Debug views skip it (dbg_mode gate) so
    // ROUGHNESS/SHADOW/etc. stay raw data.
    // Scene tonemap (sceneTonemap in functions.glsl.h): exposure + ACES
    // filmic, shared with every forward writer.  Replaces the old
    // luminance-knee compressor — the knee only rolled off above 0.8 and
    // still left the frame reading blown-out; ACES at kSceneExposure
    // keeps mid-tones in place and gives highlights a proper filmic
    // shoulder.  Debug views (dbg_mode != 0) stay raw linearTosRGB so
    // ROUGHNESS/SHADOW/etc. remain readable data, not display imagery.
    if (dbg_mode == 0u) {
        // Glass/water overlay for pixels whose opaque background this
        // dispatch just shaded: only applies when the tagged surface is
        // nearer than the opaque depth (see glassWaterOverlay's guard).
        float opq_lin_z = camera_info.depth_params.y /
                          (camera_info.depth_params.x + z);
        vec3 gcol;
        if (rpc.pass_mode != 1u &&
            glassWaterOverlay(uv, px, opq_lin_z, gcol)) {
            imageStore(hdr_out, px, vec4(sceneTonemap(gcol), 1.0));
        } else {
            imageStore(hdr_out, px, vec4(sceneTonemap(color), 1.0));
        }
    } else {
        imageStore(hdr_out, px, vec4(linearTosRGB(color), 1.0));
    }
}
