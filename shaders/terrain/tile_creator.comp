#version 460
#extension GL_ARB_separate_shader_objects : enable
#include "..\global_definition.glsl.h"
#include "tile_common.glsl.h"

layout(push_constant) uniform TileUniformBufferObject {
  TileCreateParams tile_params;
};

layout(set = 0, binding = SRC_DEPTH_TEX_INDEX) uniform sampler2D heightmap_tex;
layout(set = 0, binding = ROCK_LAYER_BUFFER_INDEX, r16f) uniform writeonly image2D rock_layer;
layout(set = 0, binding = SOIL_WATER_LAYER_BUFFER_INDEX, rg16) uniform writeonly image2D soil_water_layer;
layout(set = 0, binding = ORTHER_INFO_LAYER_BUFFER_INDEX, rgba8) uniform writeonly image2D orther_info_layer;
// Standing-water surface height (the PCG rivers step's basin fill),
// same u16/kTerrainHeightAmpMeters encoding as the heightmap.  Bound
// to a 1x1 ZERO texel when no hydrology sidecar exists — pond == 0,
// no water, no dig.  (It used to fall back to the heightmap itself;
// under WATER_SURFACE_STATIC that read pond == ground and the dig
// below self-flooded every hollow where bilinear pond crossed the
// bicubic ground by a few centimetres.)
layout(set = 0, binding = SRC_WATER_LEVEL_TEX_INDEX) uniform sampler2D water_level_tex;

// Catmull-Rom bicubic sample of the heightmap.  The 2048px map covers the
// whole 16 km world (~8 m per texel); plain bilinear upsampling into the
// 8192px rock layer leaves C0 derivative creases at every source texel —
// visible as faceted "steps" on slope transitions.  The 9-tap optimized
// Catmull-Rom (bilinear-fetch trick) is C1: smooth transitions, ridges
// stay sharp.
float sampleHeightmapSmooth(vec2 uv)
{
    vec2 tex_size = vec2(textureSize(heightmap_tex, 0));
    vec2 sample_pos = uv * tex_size;
    vec2 tex_pos1 = floor(sample_pos - 0.5f) + 0.5f;
    vec2 f = sample_pos - tex_pos1;

    vec2 w0 = f * (-0.5f + f * (1.0f - 0.5f * f));
    vec2 w1 = 1.0f + f * f * (-2.5f + 1.5f * f);
    vec2 w2 = f * (0.5f + f * (2.0f - 1.5f * f));
    vec2 w3 = f * f * (-0.5f + 0.5f * f);

    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / w12;

    vec2 tex_pos0  = (tex_pos1 - 1.0f) / tex_size;
    vec2 tex_pos3  = (tex_pos1 + 2.0f) / tex_size;
    vec2 tex_pos12 = (tex_pos1 + offset12) / tex_size;

    float result = 0.0f;
    result += texture(heightmap_tex, vec2(tex_pos0.x,  tex_pos0.y)).x  * w0.x  * w0.y;
    result += texture(heightmap_tex, vec2(tex_pos12.x, tex_pos0.y)).x  * w12.x * w0.y;
    result += texture(heightmap_tex, vec2(tex_pos3.x,  tex_pos0.y)).x  * w3.x  * w0.y;
    result += texture(heightmap_tex, vec2(tex_pos0.x,  tex_pos12.y)).x * w0.x  * w12.y;
    result += texture(heightmap_tex, vec2(tex_pos12.x, tex_pos12.y)).x * w12.x * w12.y;
    result += texture(heightmap_tex, vec2(tex_pos3.x,  tex_pos12.y)).x * w3.x  * w12.y;
    result += texture(heightmap_tex, vec2(tex_pos0.x,  tex_pos3.y)).x  * w0.x  * w3.y;
    result += texture(heightmap_tex, vec2(tex_pos12.x, tex_pos3.y)).x  * w12.x * w3.y;
    result += texture(heightmap_tex, vec2(tex_pos3.x,  tex_pos3.y)).x  * w3.x  * w3.y;
    return result;
}

layout(local_size_x = 8, local_size_y = 8) in;
void main()
{
  // get index in global work group i.e x,y position
  ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
  if (all(lessThan(pixel_coords, uvec2(tile_params.width_pixel_count)))) {
    float inv_segment_count = 1.0f / tile_params.width_pixel_count;
    vec2 tile_step = tile_params.world_range * inv_segment_count;

    vec2 map_coords = tile_params.world_min + (pixel_coords + 0.25f) * tile_step;
    vec2 map_coords1 = map_coords + 0.5f * tile_step;

    ivec2 scoord_0 = pixel_coords * 2;
    ivec2 scoord_1 = pixel_coords * 2 + ivec2(1, 0);
    ivec2 scoord_2 = pixel_coords * 2 + ivec2(0, 1);
    ivec2 scoord_3 = pixel_coords * 2 + ivec2(1, 1);

    // NOTE: the analytic FBM (terrainMap * 0.2) previously mixed in here
    // is GONE — the runtime 1 m detail tiles (terrain_detail_worker.py)
    // provide the high-frequency relief, and the base rock layer must
    // agree with them at the detail fade boundary.
    // Underwater DIG (render-side): wherever the authored water
    // surface stands above the ground, push the bed further down so a
    // FLAT surface always has real depth beneath it — shallow bumps a
    // few centimetres under the plane otherwise poke through as dark
    // mounds.  Feathered: barely-submerged shore ground dips a little,
    // anything half a metre under goes to the full 2.5 m floor.  Maps
    // whose PCG dig already ran are simply already below the cap.
    float heightmap_00 = sampleHeightmapSmooth((scoord_0 + 0.5f) * inv_segment_count * 0.5f) * kTerrainHeightAmpMeters;
    float heightmap_10 = sampleHeightmapSmooth((scoord_1 + 0.5f) * inv_segment_count * 0.5f) * kTerrainHeightAmpMeters;
    float heightmap_01 = sampleHeightmapSmooth((scoord_2 + 0.5f) * inv_segment_count * 0.5f) * kTerrainHeightAmpMeters;
    float heightmap_11 = sampleHeightmapSmooth((scoord_3 + 0.5f) * inv_segment_count * 0.5f) * kTerrainHeightAmpMeters;
#if WATER_SURFACE_STATIC
    {
        float pond_c = texture(
            water_level_tex,
            (pixel_coords + 0.5f) * inv_segment_count).x *
            kTerrainHeightAmpMeters + kWaterLevelAdjustM;
        // Dig ONLY under a surface that stands meaningfully above the
        // ground (+0.25 m — the water-level maps keep the same floor).
        // Firing at pond ~= ground turned interpolation noise into
        // draped 0.4 m water skins on every bump ("tents").
        if (pond_c > 0.5f) {
            float dig0 = clamp(0.4f + (pond_c - heightmap_00) * 4.0f,
                               0.0f, 2.5f);
            float dig1 = clamp(0.4f + (pond_c - heightmap_10) * 4.0f,
                               0.0f, 2.5f);
            float dig2 = clamp(0.4f + (pond_c - heightmap_01) * 4.0f,
                               0.0f, 2.5f);
            float dig3 = clamp(0.4f + (pond_c - heightmap_11) * 4.0f,
                               0.0f, 2.5f);
            if (pond_c > heightmap_00 + 0.25f)
                heightmap_00 = min(heightmap_00, pond_c - dig0);
            if (pond_c > heightmap_10 + 0.25f)
                heightmap_10 = min(heightmap_10, pond_c - dig1);
            if (pond_c > heightmap_01 + 0.25f)
                heightmap_01 = min(heightmap_01, pond_c - dig2);
            if (pond_c > heightmap_11 + 0.25f)
                heightmap_11 = min(heightmap_11, pond_c - dig3);
        }
    }
#endif
    const float kWaterInitLevel = 1.0f;
    const float kSoilInitLevel = 5.0f;

    // ── Rock layer ───────────────────────────────────────────────────
    // NOTE (2026-08-30): tile.vert draws the terrain tile as SOIL_PASS,
    // so the rendered vertex is rock + soil.x, and this seeds soil at
    // kSoilInitLevel.  Read statically that says the ground draws 5 m
    // above the authored heightmap, which would explain placed objects
    // sitting low -- and subtracting the seed here was tried on exactly
    // that reasoning.  IT IS WRONG: in a live session every placed
    // object (trees especially, whose trunks are unmistakable) then
    // floated ~5 m clear of the ground, which is direct evidence that
    // the soil thickness the renderer actually samples is nowhere near
    // the 5 m seeded here -- tile_update / tile_flow_update rewrite the
    // layer before it is ever drawn.
    //
    // So: rock is the authored heightmap, and anything chasing a
    // vertical mismatch has to MEASURE the runtime soil layer rather
    // than reason from this constant.
    imageStore(rock_layer, scoord_0, vec4(heightmap_00));
    imageStore(rock_layer, scoord_1, vec4(heightmap_10));
    imageStore(rock_layer, scoord_2, vec4(heightmap_01));
    imageStore(rock_layer, scoord_3, vec4(heightmap_11));

    // ── Water init: FILL TO THE HYDROLOGY'S SURFACE ──────────────────
    // The uniform 1 m init spread over a basin the rivers step carved
    // 5-8 m deep leaves the lake surface far below its banks (the
    // "water level is too low" report).  Where the basin-fill map says
    // standing water stands ABOVE the ground, initialize the layer
    // with exactly the depth that puts the surface AT that level; both
    // maps share the heightmap's u16/kTerrainHeightAmpMeters encoding,
    // and the soil layer is a uniform offset on both sides of the
    // comparison, so pond - rock is the thickness in metres directly.
    // Clamped to what the rg16 layer can carry.  Under
    // WATER_SURFACE_STATIC land starts DRY — see the branch below.
    float h_avg = 0.25f * (heightmap_00 + heightmap_10 +
                           heightmap_01 + heightmap_11);
    float pond_m = texture(
        water_level_tex,
        (pixel_coords + 0.5f) * inv_segment_count).x *
        kTerrainHeightAmpMeters + kWaterLevelAdjustM;
#if WATER_SURFACE_STATIC
    // STATIC water surface: LAND IS DRY.  The uniform 1 m ambient
    // existed to feed the drainage sim, which used to carry it
    // downhill over the first minutes of a session; with the water
    // column pinned (tile_flow_update) that sheet can never drain,
    // so it rendered the ENTIRE world as a metre-deep water surface.
    // Only pixels the water-level map marks hold water now — and only
    // where the surface stands a real 0.25 m above the (dug) ground,
    // matching the dig gate above so interpolation noise at the
    // waterline never seeds stray water.
    float water_init = 0.0f;
    if (pond_m > 0.5f && pond_m > h_avg + 0.25f) {
        water_init = clamp(pond_m - h_avg, 0.35f,
                           SOIL_WATER_LAYER_MAX_THICKNESS -
                               kSoilInitLevel - 1.0f);
    }
#else
    float water_init = kWaterInitLevel;
    if (pond_m > h_avg + 0.05f) {
        water_init = clamp(pond_m - h_avg, kWaterInitLevel,
                           SOIL_WATER_LAYER_MAX_THICKNESS -
                               kSoilInitLevel - 1.0f);
    }
#endif

    imageStore(
        soil_water_layer,
        pixel_coords,
        vec4(
            kSoilInitLevel / SOIL_WATER_LAYER_MAX_THICKNESS,
            water_init / SOIL_WATER_LAYER_MAX_THICKNESS,
            0, 0));

    if (((pixel_coords.x | pixel_coords.y) & 0x01) == 0) {
        imageStore(orther_info_layer, pixel_coords / 2, vec4(0.5f / SNOW_LAYER_MAX_THICKNESS));
    }
  }
}