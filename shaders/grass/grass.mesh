#version 460
#extension GL_EXT_mesh_shader : enable
#include "..\global_definition.glsl.h"
#include "..\terrain\tile_common.glsl.h"
#include "..\noise.glsl.h"
#include "..\weather\wind_field.glsl.h"
#include "grass_common.glsl.h"

out gl_MeshPerVertexEXT {
    vec4  gl_Position;
} gl_MeshVerticesEXT[];

layout(push_constant) uniform TileUniformBufferObject {
    TileParams tile_params;
};

layout(std430, set = VIEW_PARAMS_SET, binding = VIEW_CAMERA_BUFFER_INDEX) readonly buffer CameraInfoBuffer {
	ViewCameraInfo camera_info;
};

layout(set = TILE_PARAMS_SET, binding = ROCK_LAYER_BUFFER_INDEX) uniform sampler2D rock_layer;
layout(set = TILE_PARAMS_SET, binding = SOIL_WATER_LAYER_BUFFER_INDEX) uniform sampler2D soil_water_layer;
// Built-ground (flatten) mask: 1 on graded house pads and road slabs,
// 0 on natural ground.  See kGrassBuiltRelocate in grass_common.glsl.h.
layout(set = TILE_PARAMS_SET, binding = TERRAIN_FLAT_MASK_INDEX) uniform sampler2D terrain_flat_mask;
// Runtime 1 m detail relief.  Declares detail_height_tiles +
// detail_slot_map and must follow the two samplers above, exactly as
// tile.vert includes it after its own layer bindings.
#include "..\terrain\tile_detail.glsl.h"
// Local wind patch — the same two tile-res bindings the water waves and
// grass.vert read.  The sway used to exist ONLY in grass.vert, which is
// the pre-mesh-shader fallback path: with USE_MESH_SHADER on (it is),
// nothing ever bent a blade, and perfectly still grass is one of the
// loudest tells that a field is not real.
layout(set = TILE_PARAMS_SET, binding = WIND_TEX_INDEX) uniform sampler2D wind_patch_tex;
layout(std430, set = TILE_PARAMS_SET, binding = WIND_REGION_BUFFER_INDEX) readonly buffer WindRegionBuf {
    vec4 wind_region;
};

layout(location = 0) out GrassVsPsData {
    vec4 pos_ws_v;   // xyz = world position, w = height fraction (0 root, 1 tip)
    vec4 nrm_hash;   // xyz = world normal,   w = per-blade hash
    vec4 attribs;    // x = dryness, y = signed edge coord, z = blade height, w = unused
} out_data[];

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices=256, max_primitives=256) out;

// ── The RENDERED surface height at one point ────────────────────────
// The same terms tile.vert's SOIL_PASS evaluates at a mesh vertex:
// base rock mixed toward the streamed 1 m detail (with the
// submerged-bed suppression), plus the soil layer.  Called for GRID
// VERTICES only -- see grassGroundHeight below for why blades never
// sample it directly at their own root.
float grassVertexHeight(vec2 pos_ws) {
    vec2 uv = (pos_ws - tile_params.world_min) * tile_params.inv_world_range;
    float h = texture(rock_layer, uv).x;
    vec2 sw = texture(soil_water_layer, uv).xy * SOIL_WATER_LAYER_MAX_THICKNESS;
    float fade = terrainDetailFade(pos_ws, camera_info.position.xyz);
    fade *= 1.0f - clamp(sw.y * 2.0f, 0.0f, 1.0f);
    return terrainDetailHeight(pos_ws, h, fade) + sw.x;
}

// Root height = the surface the terrain MESH actually draws, not the
// raw height field.  tile.vert evaluates heights only at this tile's
// LOD-grid vertices (drawGrass pushes the tile's REAL per-LOD segment
// count) and the rasteriser interpolates linearly between them, so a
// blade that samples the height field AT ITS OWN ROOT reintroduces
// every feature the mesh grid cannot carry.  Over the 1 m detail
// relief and the carved river banks that error is METRES on the 4-8 m
// grids, and it is signed: blades hovering in mid-air on every knoll
// and crest -- against the open sky wherever the crest is a skyline --
// and buried to the tip in every gully.  Evaluating the 4 surrounding
// grid vertices and bilerping reproduces the drawn surface (the
// quad's triangle split and coarser-neighbour edge snapping can still
// differ by centimetres; the root sinks a little extra per grid cell
// to keep that residue underground).
float grassGroundHeight(vec2 root_xz) {
    float seg = float(tile_params.segment_count);
    vec2 cell = tile_params.range * tile_params.inv_segment_count;
    vec2 grid = clamp((root_xz - tile_params.min) / tile_params.range,
                      0.0f, 1.0f) * seg;
    vec2 g0 = min(floor(grid), vec2(seg - 1.0f));
    vec2 gf = grid - g0;
    vec2 p00 = tile_params.min + g0 * cell;
    float h00 = grassVertexHeight(p00);
    float h10 = grassVertexHeight(p00 + vec2(cell.x, 0.0f));
    float h01 = grassVertexHeight(p00 + vec2(0.0f, cell.y));
    float h11 = grassVertexHeight(p00 + cell);
    return mix(mix(h00, h10, gf.x), mix(h01, h11, gf.x), gf.y)
           - 0.02f * cell.x;
}

void main()
{
    uint blade_idx = gl_GlobalInvocationID.x;
    uint local_idx = gl_LocalInvocationID.x;

    const uint num_vertex    = 16 * uint(kGrassBladeVerts);
    const uint num_primitive = 16 * uint(kGrassBladeTris);
    SetMeshOutputsEXT(num_vertex, num_primitive);

    // Two independent draws: one per TUFT (shared root) and one per
    // BLADE (its own size, facing, lean and phase within the tuft).
    uint tuft_idx = uint(float(blade_idx) * (1.0f / kGrassTuftBlades));
    vec4 h_tuft  = clamp(hash43(vec3(tile_params.min, float(tuft_idx))),
                         0.0f, 1.0f);
    vec4 h_blade = clamp(hash43(vec3(tile_params.min + vec2(17.13f, 41.77f),
                                     float(blade_idx))), 0.0f, 1.0f);

    // ── Root placement with waterline rejection ─────────────────────
    // .y of the soil-water layer is the WATER column standing over the
    // root — the same value tile_water.frag culls its surface by.  A
    // wet tuft re-hashes its position (kGrassWaterRelocates tries)
    // before it is allowed to give up, so river beds shed their grass
    // onto the surrounding banks instead of just going bald (see
    // grass_common.glsl.h).
    // Built ground is rejected on the SAME budget and the same salt: a
    // tuft that lands on a house pad or a road is re-seated onto the
    // grass beside it, and only a tuft that is still on graded ground
    // after the last retry is shrunk away.
    vec2  root_xz;
    vec2  world_map_uv;
    vec2  soil_water_thickness;
    float built;
    for (int attempt = 0; ; ++attempt) {
        root_xz = grassRootXZ(tile_params.min, tile_params.range,
                              h_tuft, h_blade);
        world_map_uv = (root_xz - tile_params.world_min) *
                       tile_params.inv_world_range;
        soil_water_thickness =
            texture(soil_water_layer, world_map_uv).xy *
            SOIL_WATER_LAYER_MAX_THICKNESS;
        built = texture(terrain_flat_mask, world_map_uv).x;
        bool rejected = soil_water_thickness.y > kGrassWaterFadeStartM ||
                        built > kGrassBuiltRelocate;
        if (!rejected || attempt >= kGrassWaterRelocates) {
            break;
        }
        // Same salt for every blade of the tuft — the clump moves whole.
        h_tuft = clamp(hash43(vec3(
            tile_params.min + vec2(7.31f, -3.77f) * float(attempt + 1),
            float(tuft_idx))), 0.0f, 1.0f);
    }

    // Ground height under THIS blade (not the tuft centre) so a clump on
    // a slope plants every blade in the dirt instead of leaving the
    // downhill ones hovering.
    // MUST match tile.vert's SOIL_PASS height exactly, term for term.
    // The terrain is drawn as base rock MIXED TOWARD the streamed 1 m
    // detail relief (terrainDetailHeight replaces the height, it does
    // not offset it) over kDetailFadeStart/EndMeters of camera
    // distance.  Sampling the base map alone -- which is all this did
    // -- left every blade rooted on a surface the terrain no longer
    // occupied anywhere inside the detail ring, i.e. across the whole
    // range where grass is drawn at all: metres of error at the
    // camera, fading to zero only out where the blades already have.
    // That is the grass standing in mid-air, and the same error with
    // the opposite sign is grass buried to the tip.
    float ground_height = grassGroundHeight(root_xz);
    // Still wet after every retry (mid-lake tiles): shrink to nothing.
    float water_k = 1.0f - smoothstep(kGrassWaterFadeStartM,
                                      kGrassWaterFadeEndM,
                                      soil_water_thickness.y);
    // Still on graded ground after every retry (deep inside a town):
    // same treatment.  Multiplied into the same height/width pair, so
    // a blade that is both wet and paved cannot come back.
    water_k *= 1.0f - smoothstep(kGrassBuiltFadeStart,
                                 kGrassBuiltFadeEnd, built);

    float dry = grassDryField(root_xz);
    GrassBlade blade = grassMakeBlade(root_xz, h_blade, dry);
    blade.root_ws.y = ground_height - 0.01f;   // sink the sheath slightly
    blade.height *= water_k;
    blade.width  *= water_k;

    // ── View-distance fade + widen (see grass_common.glsl.h) ────────
    // TRUE 3D distance, not XZ: projected size is what decides whether
    // a blade can be drawn, and from an aerial camera the altitude IS
    // most of the distance — an XZ metric told a camera 400 m straight
    // up that the grass below it was at arm's length.
    {
        float cam_dist = distance(camera_info.position, blade.root_ws);
        // Widen toward ~pixel coverage first, then fade everything out.
        blade.width *= 1.0f + (kGrassWidenMax - 1.0f) *
            smoothstep(kGrassWidenStartM, kGrassViewFadeStartM, cam_dist);
        float k = 1.0f - smoothstep(kGrassViewFadeStartM,
                                    kGrassViewFadeEndM, cam_dist);
        blade.height *= k;
        blade.width  *= k;
    }

    // ── Wind sway ───────────────────────────────────────────────────
    // Quadratic in height (the root is planted, the tip carries the
    // travel) — that is already how grassBladeVertex spends `arc`, so
    // the wind simply adds to it.  A small flutter at the blade's own
    // hashed phase keeps a field from swaying in lockstep.  Outside the
    // patch (weight 0) grass stands still: the coarse tier is
    // kilometre-scale weather and has nothing to say about one blade.
    {
        float wf_w;
        vec2  wv = sampleWindFine(wind_patch_tex, wind_region, root_xz, wf_w);
        float spd = length(wv);
        if (wf_w * spd > 1e-3f) {
            vec2  dir  = wv / max(spd, 1e-4f);
            float lean = min(spd * 0.055f, 0.40f) * blade.height;
            float flutter = 0.05f * min(spd, 8.0f) * blade.height *
                sin(tile_params.time * (3.0f + 2.0f * h_blade.w) +
                    h_blade.z * 6.2831853f);
            blade.arc += vec3(dir.x, 0.0f, dir.y) * ((lean + flutter) * wf_w);
        }
    }

    for (int i_ring = 0; i_ring < kGrassRings; i_ring++) {
        uint v_idx = local_idx * uint(kGrassBladeVerts) + uint(i_ring) * 2u;
        for (int i_side = 0; i_side < 2; i_side++) {
            float side_sign = (i_side == 0) ? 1.0f : -1.0f;
            vec3  p_ws; vec3 n_ws; float v;
            grassBladeVertex(blade, i_ring, side_sign, p_ws, n_ws, v);

            uint o = v_idx + uint(i_side);
            gl_MeshVerticesEXT[o].gl_Position =
                camera_info.view_proj * vec4(p_ws, 1.0f);
            out_data[o].pos_ws_v = vec4(p_ws, v);
            out_data[o].nrm_hash = vec4(n_ws, blade.hash);
            out_data[o].attribs  =
                vec4(dry, side_sign * kGrassProfile[i_ring].x,
                     blade.height, 0.0f);
        }
    }

    for (int i_poly = 0; i_poly < kGrassBladeTris; i_poly++) {
        gl_PrimitiveTriangleIndicesEXT[local_idx * uint(kGrassBladeTris) + uint(i_poly)] =
            uvec3(local_idx * uint(kGrassBladeVerts) + uint(i_poly),
                  local_idx * uint(kGrassBladeVerts) + uint(i_poly) + 1u,
                  local_idx * uint(kGrassBladeVerts) + uint(i_poly) + 2u);
    }
}
