#version 460
#extension GL_EXT_mesh_shader : enable
#include "..\global_definition.glsl.h"
#include "..\terrain\tile_common.glsl.h"
#include "..\noise.glsl.h"
#include "..\weather\wind_field.glsl.h"
#include "grass_common.glsl.h"

out gl_MeshPerVertexEXT {
    vec4  gl_Position;
} gl_MeshVerticesEXT[];

layout(push_constant) uniform TileUniformBufferObject {
    TileParams tile_params;
};

layout(std430, set = VIEW_PARAMS_SET, binding = VIEW_CAMERA_BUFFER_INDEX) readonly buffer CameraInfoBuffer {
	ViewCameraInfo camera_info;
};

layout(set = TILE_PARAMS_SET, binding = ROCK_LAYER_BUFFER_INDEX) uniform sampler2D rock_layer;
layout(set = TILE_PARAMS_SET, binding = SOIL_WATER_LAYER_BUFFER_INDEX) uniform sampler2D soil_water_layer;
// Built-ground (flatten) mask: 1 on graded house pads and road slabs,
// 0 on natural ground.  See kGrassBuiltRelocate in grass_common.glsl.h.
layout(set = TILE_PARAMS_SET, binding = TERRAIN_FLAT_MASK_INDEX) uniform sampler2D terrain_flat_mask;
// Macro colour map -- the vegetation signal the blade density follows
// (grassCoverField).  The binding's stage flags include the mesh and
// vertex stages since the cover gate (terrain.cpp, SRC_MAP_MASK_INDEX).
layout(set = TILE_PARAMS_SET, binding = SRC_MAP_MASK_INDEX) uniform sampler2D src_map_mask;
// Runtime 1 m detail relief.  Declares detail_height_tiles +
// detail_slot_map and must follow the two samplers above, exactly as
// tile.vert includes it after its own layer bindings.
#include "..\terrain\tile_detail.glsl.h"
// Local wind patch — the same two tile-res bindings the water waves and
// grass.vert read.  The sway used to exist ONLY in grass.vert, which is
// the pre-mesh-shader fallback path: with USE_MESH_SHADER on (it is),
// nothing ever bent a blade, and perfectly still grass is one of the
// loudest tells that a field is not real.
layout(set = TILE_PARAMS_SET, binding = WIND_TEX_INDEX) uniform sampler2D wind_patch_tex;
layout(std430, set = TILE_PARAMS_SET, binding = WIND_REGION_BUFFER_INDEX) readonly buffer WindRegionBuf {
    vec4 wind_region;
};

layout(location = 0) out GrassVsPsData {
    vec4 pos_ws_v;   // xyz = world position, w = height fraction (0 root, 1 tip)
    vec4 nrm_hash;   // xyz = world normal,   w = per-blade hash
    vec4 attribs;    // x = dryness, y = signed edge coord, z = blade height, w = unused
} out_data[];

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices=256, max_primitives=256) out;

// ── Workgroup frustum cull ───────────────────────────────────────────
// Every blade of the tile used to be built and emitted whether or not
// it was in view — a 128 m tile under the camera is 400k roots at the
// near boost, and the half behind the camera cost exactly as much as
// the half in front.  Each invocation tests its own root against the
// camera frustum (a sphere padded by the blade height); a workgroup
// whose 16 blades are all outside emits nothing, and an invisible blade
// inside a visible workgroup collapses to a degenerate (zero-size)
// strip so it rasterises no fragments.
// ── Output compaction ────────────────────────────────────────────────
// Culled blades used to stay in the output as degenerate strips (the
// output counts were the full 16 blades whenever ONE blade survived),
// so every hidden blade still cost 16 vertices + 14 triangles of
// primitive setup.  Survivors are now packed to the front in lane
// order (deterministic: the same blade always lands in the same slot
// for the same survivor set) and the group declares only their count.
shared uint s_blade_vis[16];

#ifdef GRASS_HIZ
// ── GPU occlusion (G-buffer pass) ────────────────────────────────────
// The same Hi-Z pyramid the cluster and plant culls test against: built
// this frame from the PROJECTED (frame-ahead) depth, i.e. last frame's
// depth reprojected to this frame's camera (depth_predict.comp -> Hi-Z
// build), so it costs the grass nothing extra.  It holds the FARTHEST
// depth per texel: a blade is dropped only when every texel its screen
// box touches has something strictly nearer.
layout(set = 3, binding = 0) uniform sampler2D grass_hiz;

bool grassHiZOccluded(vec3 lo, vec3 hi) {
    const mat4 M = camera_info.view_proj;
    vec2  ndc_min = vec2( 1.0f);
    vec2  ndc_max = vec2(-1.0f);
    float ndc_z_near = 1.0f;
    for (int i = 0; i < 8; ++i) {
        const vec3 cw = vec3(((i & 1) != 0) ? hi.x : lo.x,
                             ((i & 2) != 0) ? hi.y : lo.y,
                             ((i & 4) != 0) ? hi.z : lo.z);
        const vec4 cc = M * vec4(cw, 1.0f);
        if (cc.w <= 1e-4f) return false;          // crosses the eye plane
        const vec3 nd = cc.xyz / cc.w;
        ndc_min = min(ndc_min, nd.xy);
        ndc_max = max(ndc_max, nd.xy);
        ndc_z_near = min(ndc_z_near, nd.z);
    }
    if (ndc_z_near < 0.0f) return false;
    const vec2 uv_min = max(ndc_min * 0.5f + 0.5f, vec2(0.0f));
    const vec2 uv_max = min(ndc_max * 0.5f + 0.5f, vec2(1.0f));
    if (uv_max.x <= uv_min.x || uv_max.y <= uv_min.y) return false;
    const vec2  hiz_size = vec2(textureSize(grass_hiz, 0));
    const float hiz_mips = float(textureQueryLevels(grass_hiz));
    const vec2  box_px = (uv_max - uv_min) * hiz_size;
    const float max_dim = max(box_px.x, box_px.y);
    const float mip = clamp(ceil(log2(max(max_dim * 0.5f, 1.0f))),
                            0.0f, hiz_mips - 1.0f);
    const float far_z = max(
        max(textureLod(grass_hiz, vec2(uv_min.x, uv_min.y), mip).r,
            textureLod(grass_hiz, vec2(uv_min.x, uv_max.y), mip).r),
        max(textureLod(grass_hiz, vec2(uv_max.x, uv_min.y), mip).r,
            textureLod(grass_hiz, vec2(uv_max.x, uv_max.y), mip).r));
    const float bias = 1e-5f + ndc_z_near * 1e-4f;
    return far_z < 0.99999f && ndc_z_near > far_z + bias;
}
#endif

bool grassRootVisible(vec3 root_ws, float radius_m) {
    const mat4 vp = camera_info.view_proj;
    vec4 planes[6];
    planes[0] = vec4(vp[0][3] + vp[0][0], vp[1][3] + vp[1][0], vp[2][3] + vp[2][0], vp[3][3] + vp[3][0]);
    planes[1] = vec4(vp[0][3] - vp[0][0], vp[1][3] - vp[1][0], vp[2][3] - vp[2][0], vp[3][3] - vp[3][0]);
    planes[2] = vec4(vp[0][3] + vp[0][1], vp[1][3] + vp[1][1], vp[2][3] + vp[2][1], vp[3][3] + vp[3][1]);
    planes[3] = vec4(vp[0][3] - vp[0][1], vp[1][3] - vp[1][1], vp[2][3] - vp[2][1], vp[3][3] - vp[3][1]);
    planes[4] = vec4(vp[0][2], vp[1][2], vp[2][2], vp[3][2]);
    planes[5] = vec4(vp[0][3] - vp[0][2], vp[1][3] - vp[1][2], vp[2][3] - vp[2][2], vp[3][3] - vp[3][2]);
    for (int i = 0; i < 6; ++i) {
        float len = length(planes[i].xyz);
        if (len > 1e-6f) planes[i] /= len;
        if (dot(planes[i].xyz, root_ws) + planes[i].w < -radius_m) {
            return false;
        }
    }
    return true;
}

// ── The RENDERED surface height at one point ────────────────────────
// The same terms tile.vert's SOIL_PASS evaluates at a mesh vertex:
// base rock mixed toward the streamed 1 m detail (with the
// submerged-bed suppression), plus the soil layer.  Called for GRID
// VERTICES only -- see grassGroundHeight below for why blades never
// sample it directly at their own root.
float grassVertexHeight(vec2 pos_ws) {
    vec2 uv = (pos_ws - tile_params.world_min) * tile_params.inv_world_range;
    float h = texture(rock_layer, uv).x;
    vec2 sw = texture(soil_water_layer, uv).xy * SOIL_WATER_LAYER_MAX_THICKNESS;
    float fade = terrainDetailFade(pos_ws, camera_info.position.xyz);
    fade *= 1.0f - clamp(sw.y * 2.0f, 0.0f, 1.0f);
    return terrainDetailHeight(pos_ws, h, fade) + sw.x;
}

// Snap an edge parameter onto a coarser neighbour's vertex grid.
// VERBATIM the same function tile.vert applies to its edge vertices --
// if the two ever disagree the blades along that edge sit on a surface
// the terrain does not draw.
float grassSnapToGrid(float t, float nseg) {
    return floor(t * nseg + 0.5f) / nseg;
}

// World XZ of terrain grid vertex (gx, gy), INCLUDING the LOD edge
// stitch.  tile.vert moves any vertex on an edge shared with a COARSER
// neighbour onto that neighbour's grid, which turns the edge into a
// chord across the coarse cell.  Reconstructing the unsnapped fine grid
// instead left a one-cell band of blades along every LOD boundary
// standing on a surface with the full sagitta of the terrain under it.
// Needs tile_params.offset, which drawGrass must now push (it used to
// send 0).
vec2 grassGridPos(vec2 g, float seg) {
    vec2 f = g * (1.0f / seg);
    if ((tile_params.pad_0 & 1u) != 0u) {
        // Packed surface vertices replace the regular grid AFTER edge
        // stitching in tile.vert. Match their 15-bit coordinates exactly.
        f = floor(f * 32767.0f + 0.5f) / 32767.0f;
        return tile_params.min + f * tile_params.range;
    }
    uint elods = tile_params.offset;
    if (g.x == 0.0f) {
        float ns = float(elods & 0xFFu);
        if (ns > 0.0f && ns < seg) f.y = grassSnapToGrid(f.y, ns);
    } else if (g.x == seg) {
        float ns = float((elods >> 8) & 0xFFu);
        if (ns > 0.0f && ns < seg) f.y = grassSnapToGrid(f.y, ns);
    }
    if (g.y == 0.0f) {
        float ns = float((elods >> 16) & 0xFFu);
        if (ns > 0.0f && ns < seg) f.x = grassSnapToGrid(f.x, ns);
    } else if (g.y == seg) {
        float ns = float((elods >> 24) & 0xFFu);
        if (ns > 0.0f && ns < seg) f.x = grassSnapToGrid(f.x, ns);
    }
    return tile_params.min + f * tile_params.range;
}

// Root height = the surface the terrain MESH actually draws, not the
// raw height field.  tile.vert evaluates heights only at this tile's
// LOD-grid vertices (drawGrass pushes the tile's REAL per-LOD segment
// count) and the rasteriser interpolates linearly between them, so a
// blade that samples the height field AT ITS OWN ROOT reintroduces
// every feature the mesh grid cannot carry.  Over the 1 m detail
// relief and the carved river banks that error is METRES on the 4-8 m
// grids, and it is signed: blades hovering in mid-air on every knoll
// and crest -- against the open sky wherever the crest is a skyline --
// and buried to the tip in every gully.
//
// The first version of this evaluated the 4 surrounding grid vertices
// and BILERPED them, which is still not the drawn surface: a quad is
// rasterised as TWO TRIANGLES, and a bilinear patch differs from that
// pair by the quad's twist term, fx*fy*(h00-h10-h01+h11), signed and
// up to a quarter of the twist at the cell centre.  On the 4 m and 8 m
// LOD grids the twist over 1 m detail relief is metres, so half of
// every quad -- the half on the low side of the split -- still had its
// blades hanging up to ~0.5 m off the ground, in triangular patches.
// generateTileMeshIndex emits (i00,i10,i01) and (i10,i11,i01), i.e. the
// diagonal runs from (x,y+1) to (x+1,y): the split is fx + fy = 1.
// Evaluate the plane of whichever triangle the root actually lands in
// and the reconstruction is EXACT except for the interpolation of the
// snapped edge quads, which are no longer axis aligned.
float grassGroundHeight(vec2 root_xz) {
    float seg = float(tile_params.segment_count);
    vec2 grid = clamp((root_xz - tile_params.min) / tile_params.range,
                      0.0f, 1.0f) * seg;
    vec2 g0 = min(floor(grid), vec2(seg - 1.0f));
    vec2 gf = grid - g0;
    if ((tile_params.pad_0 & 1u) != 0u) {
        vec2 lo = grassGridPos(g0, seg);
        vec2 hi = grassGridPos(g0 + vec2(1.0f), seg);
        gf = clamp((root_xz - lo) / (hi - lo), 0.0f, 1.0f);
    }

    float h00 = grassVertexHeight(grassGridPos(g0,                    seg));
    float h10 = grassVertexHeight(grassGridPos(g0 + vec2(1.0f, 0.0f), seg));
    float h01 = grassVertexHeight(grassGridPos(g0 + vec2(0.0f, 1.0f), seg));
    float h11 = grassVertexHeight(grassGridPos(g0 + vec2(1.0f, 1.0f), seg));

    float h;
    if (gf.x + gf.y <= 1.0f) {
        // Triangle (h00, h01, h10).
        h = h00 + (h10 - h00) * gf.x + (h01 - h00) * gf.y;
    } else {
        // Triangle (h01, h11, h10).
        h = h11 + (h01 - h11) * (1.0f - gf.x)
                + (h10 - h11) * (1.0f - gf.y);
    }
    // Root offset is applied once below, in metres. Scaling burial by
    // the LOD cell size hid short/fading blades as the grid grew coarser.
    return h;
}

// ── Patch mode (tile_params.pad_0 bit 1) ─────────────────────────────
// The tile is cut into kGrassPatchGrid x kGrassPatchGrid patches (8 m on
// a 128 m tile) and the dispatch is 2D: gl_WorkGroupID.y = patch,
// gl_WorkGroupID.x = the group within it (tile_params.vt_normal_id
// groups per patch; grass never samples the VT, so the two VT id fields
// carry the patch sizing -- vt_mr_ao_id = floatBits(tufts per patch at
// keep 1)).  Every tuft of a patch roots INSIDE the patch, so a whole
// group can be rejected -- frustum, Hi-Z, empty -- before any blade is
// placed, which is where the grass time went (a dozen height fetches per
// blade, paid by every dispatched blade whether it was seen or not).
//
// Density is the same law as before, one level finer: a patch carries
// tufts_full * keep_eff(d_min of the PATCH) tufts and the lottery keeps
// keep_eff(d) / keep_eff(d_min) of them.  keep_eff folds in the near
// re-seating the tile mode does by moving dropped tufts into the near
// disc (that needs tufts to leave their patch): the underfoot disc gets
// its extra tufts directly, as density, with the same grow-in band.
// Tuft ids are (patch << 16) | index-in-patch, so raising a patch's
// count only ADDS tufts; nothing already standing moves.
const uint kGrassPatchGrid = 16u;

float grassNearSeatBand(float d) {
    return 1.0f - smoothstep(kGrassNearSeatM - kGrassNearSeatBandM,
                             kGrassNearSeatM, d);
}
float grassKeepLaw(float d, bool patched) {
    return patched ? grassKeepAtDistance(d) * (1.0f + grassNearSeatBand(d))
                   : grassKeepAtDistance(d);
}
float grassKeepWeight(float h, float d, float keep_ref, bool patched) {
    return clamp(1.0f + (grassKeepLaw(d, patched) / max(keep_ref, 1e-4f) - h)
                        / kGrassDenseSoft, 0.0f, 1.0f);
}

shared float s_patch_h[9];

void main()
{
    uint blade_idx = gl_GlobalInvocationID.x;
    uint local_idx = gl_LocalInvocationID.x;
    const bool patched = (tile_params.pad_0 & 2u) != 0u;

    // SetMeshOutputsEXT is deferred until the cull below has counted
    // the surviving blades (output compaction).

    // Two independent draws: one per TUFT (shared root) and one per
    // BLADE (its own size, facing, lean and phase within the tuft).
    // Integer division, not the float multiply this used: at the near
    // tile's indices float(blade_idx) * (1/6) lands a hair under an
    // integer often enough to file a blade under the previous tuft.
    const uint  blades_per_tuft = uint(kGrassTuftBlades);
    uint tuft_idx  = blade_idx / blades_per_tuft;
    uint blade_in  = blade_idx - tuft_idx * blades_per_tuft;
    uint blade_key = blade_idx;
    // Integer hashes (grassHash4) -- see grass_common.glsl.h for why
    // the float hash43 draws put the near field on a lattice.
    const uvec2 tile_key = floatBitsToUint(tile_params.min);

    // Where this group's tufts may root, and the distance-law reference
    // the lottery divides by (tile mode: the tile; patch mode: the patch).
    vec2  place_min   = tile_params.min;
    vec2  place_range = tile_params.range;
    float keep_ref    = grassKeepAtDistance(grassTileMinDist(
        camera_info.position.xz, tile_params.min, tile_params.range));
    bool  slot_live   = true;
    if (patched) {
        const uint  patch_id   = gl_WorkGroupID.y;
        const uint  k_group = gl_WorkGroupID.x;
        const vec2  psize   = tile_params.range / float(kGrassPatchGrid);
        place_min   = tile_params.min +
            vec2(float(patch_id % kGrassPatchGrid), float(patch_id / kGrassPatchGrid)) * psize;
        place_range = psize;
        const float d_min_p = grassTileMinDist(camera_info.position.xz,
                                               place_min, place_range);
        keep_ref = grassKeepLaw(d_min_p, true);
        // Tufts in this patch: tufts_full * keep_ref, the fraction as a
        // hashed coin (monotonic in the distance, so no flicker).
        const float want = uintBitsToFloat(tile_params.vt_mr_ao_id) * keep_ref;
        const float coin = grassHash4(tile_key, patch_id, 7u).x;
        const uint  n_tufts = uint(want) + ((coin < fract(want)) ? 1u : 0u);
        const uint  n_blades = n_tufts * blades_per_tuft;
        // ── Whole-group rejects: empty slice, past the fade ──────────
        if (k_group * 16u >= n_blades ||
            d_min_p > kGrassViewFadeEndM) {
            SetMeshOutputsEXT(0u, 0u);
            return;
        }
        // ── Patch box: frustum (+ Hi-Z) before any blade is placed ───
        // Ground range from a 3x3 sample of the rendered height (one
        // lane each), padded for the surface between samples; blades
        // lean up to ~2.5 m and stand up to ~2 m.
        if (local_idx < 9u) {
            const vec2 f = vec2(float(local_idx % 3u), float(local_idx / 3u)) * 0.5f;
            s_patch_h[local_idx] = grassVertexHeight(place_min + f * psize);
        }
        barrier();
        float h_lo = s_patch_h[0], h_hi = s_patch_h[0];
        for (int i = 1; i < 9; ++i) {
            h_lo = min(h_lo, s_patch_h[i]);
            h_hi = max(h_hi, s_patch_h[i]);
        }
        const float kLeanPad = 3.0f;
        const vec3 box_lo = vec3(place_min.x - kLeanPad, h_lo - 2.0f,
                                 place_min.y - kLeanPad);
        const vec3 box_hi = vec3(place_min.x + psize.x + kLeanPad, h_hi + 3.0f,
                                 place_min.y + psize.y + kLeanPad);
        bool patch_visible = grassRootVisible(0.5f * (box_lo + box_hi),
                                              0.5f * length(box_hi - box_lo));
#ifdef GRASS_HIZ
        if (patch_visible && grassHiZOccluded(box_lo, box_hi)) patch_visible = false;
#endif
        if (!patch_visible) {
            SetMeshOutputsEXT(0u, 0u);
            return;
        }
        // This lane's blade inside the patch.
        const uint b_local = k_group * 16u + local_idx;
        slot_live = b_local < n_blades;
        const uint t_local = b_local / blades_per_tuft;
        tuft_idx  = (patch_id << 16u) | t_local;
        blade_in  = b_local - t_local * blades_per_tuft;
        blade_key = tuft_idx * 8u + blade_in;
    }
    vec4 h_tuft  = grassHash4(tile_key, tuft_idx, 0u);
    vec4 h_blade = grassHash4(tile_key, blade_key, 1u);

    // ── Root placement with waterline rejection ─────────────────────
    // .y of the soil-water layer is the WATER column standing over the
    // root — the same value tile_water.frag culls its surface by.  A
    // wet tuft re-hashes its position (kGrassWaterRelocates tries)
    // before it is allowed to give up, so river beds shed their grass
    // onto the surrounding banks instead of just going bald (see
    // grass_common.glsl.h).
    // Built ground is rejected on the SAME budget and the same salt: a
    // tuft that lands on a house pad or a road is re-seated onto the
    // grass beside it, and only a tuft that is still on graded ground
    // after the last retry is shrunk away.
    vec2  root_xz;
    vec2  world_map_uv;
    vec2  soil_water_thickness = vec2(0.0f);
    float built = 0.0f;
    // ── Distance-driven density (grass_common.glsl.h) ───────────────
    // Decided on the tuft's ORIGINAL hash (relocation re-hashes
    // h_tuft, and the keep decision must not move with it) and, for the
    // early-out, on the camera's XZ distance to the un-relocated tuft:
    // XZ <= 3D distance, so a tuft the flat metric already drops is
    // dropped by the true one too -- the conservative direction.  A
    // dropped tuft skips the relocation loop and the four ground
    // samples entirely; it only has to reach the workgroup barrier.
    const float tuft_h = h_tuft.z;
    // This tile's share of the distance law (grass_common.glsl.h): the
    // C++ dispatched it at keep(d_min) of full, the lottery keeps
    // keep(d) / keep(d_min) of what it dispatched.
    float d_root = distance(camera_info.position.xz,
                            place_min + h_tuft.xy * place_range);
    float dens_k = slot_live
        ? grassKeepWeight(tuft_h, d_root, keep_ref, patched) : 0.0f;
    // ── Near-field re-seating (grass_common.glsl.h) ─────────────────
    // A dropped tuft tries a candidate root inside the near disc; the
    // candidate's weight fades with the original root's own margin so
    // the two crossfade instead of popping.  `seat_w` > 0 marks a
    // re-seated blade: its weight is final and skips the 3D lottery
    // below (inside the near disc the lottery is 1 anyway).
    float seat_w = 0.0f;
    if (dens_k <= 0.0f && !patched) {
        float free_w = clamp((-grassDensityMargin(tuft_h, d_root, keep_ref)
                              - kGrassDenseSoft) / kGrassDenseSoft,
                             0.0f, 1.0f);
        if (free_w > 0.0f) {
            // Half the tuft per candidate: blades 0,2,4 -> seat 0,
            // blades 1,3,5 -> seat 1.  Both halves stay whole clumps.
            uint seat = blade_in % kGrassNearSeats;
            vec4 h_seat = grassHash4(tile_key, tuft_idx, 2u + seat);
            float d_seat = distance(
                camera_info.position.xz,
                tile_params.min + h_seat.xy * tile_params.range);
            float band = 1.0f - smoothstep(kGrassNearSeatM - kGrassNearSeatBandM,
                                           kGrassNearSeatM, d_seat);
            if (band > 0.0f) {
                h_tuft = h_seat;
                seat_w = band * free_w;
                dens_k = seat_w;
            }
        }
    }
    if (dens_k <= 0.0f) {
        root_xz = place_min + h_tuft.xy * place_range;
        world_map_uv = (root_xz - tile_params.world_min) *
                       tile_params.inv_world_range;
    } else
    for (int attempt = 0; ; ++attempt) {
        root_xz = grassRootXZ(place_min, place_range,
                              h_tuft, h_blade);
        world_map_uv = (root_xz - tile_params.world_min) *
                       tile_params.inv_world_range;
        soil_water_thickness =
            texture(soil_water_layer, world_map_uv).xy *
            SOIL_WATER_LAYER_MAX_THICKNESS;
        built = texture(terrain_flat_mask, world_map_uv).x;
        bool rejected = soil_water_thickness.y >= kGrassWaterFadeEndM ||
                        built > kGrassBuiltRelocate;
        if (!rejected || attempt >= kGrassWaterRelocates) {
            break;
        }
        // Same salt for every blade of the tuft — the clump moves whole.
        h_tuft = grassHash4(tile_key, tuft_idx, 16u + uint(attempt));
    }

    // Ground height under THIS blade (not the tuft centre) so a clump on
    // a slope plants every blade in the dirt instead of leaving the
    // downhill ones hovering.
    // MUST match tile.vert's SOIL_PASS height exactly, term for term.
    // The terrain is drawn as base rock MIXED TOWARD the streamed 1 m
    // detail relief (terrainDetailHeight replaces the height, it does
    // not offset it) over kDetailFadeStart/EndMeters of camera
    // distance.  Sampling the base map alone -- which is all this did
    // -- left every blade rooted on a surface the terrain no longer
    // occupied anywhere inside the detail ring, i.e. across the whole
    // range where grass is drawn at all: metres of error at the
    // camera, fading to zero only out where the blades already have.
    // That is the grass standing in mid-air, and the same error with
    // the opposite sign is grass buried to the tip.
    float ground_height = (dens_k > 0.0f) ? grassGroundHeight(root_xz)
                                          : camera_info.position.y;
    // Still wet after every retry (mid-lake tiles): shrink to nothing.
    float water_k = 1.0f - smoothstep(kGrassWaterFadeStartM,
                                      kGrassWaterFadeEndM,
                                      soil_water_thickness.y);
    // Distance density, now on the true 3D distance of the planted root
    // (the XZ test above only ever culled; this one also shrinks the
    // tufts in the soft band).
    if (seat_w > 0.0f) {
        dens_k = seat_w;              // re-seated: weight already final
    } else if (dens_k > 0.0f) {
        dens_k = grassKeepWeight(
            tuft_h, distance(camera_info.position,
                             vec3(root_xz.x, ground_height, root_xz.y)),
            keep_ref, patched);
    }
    water_k *= dens_k;
    // Still on graded ground after every retry (deep inside a town):
    // same treatment.  Multiplied into the same height/width pair, so
    // a blade that is both wet and paved cannot come back.
    water_k *= 1.0f - smoothstep(kGrassBuiltFadeStart,
                                 kGrassBuiltFadeEnd, built);

    // ── Cover: follow the vegetation map (grass_common.glsl.h) ──────
    // At the FINAL root (re-seated or relocated), on the tuft's own
    // hash lane (.w -- .z is the distance lottery).  Skipped for a
    // tuft that is already gone.
    float cover = kGrassCoverFloor;
    if (water_k > 0.0f) {
        vec3 macro = grassCoverSample(src_map_mask, world_map_uv,
                                     tile_params.inv_world_range);
        cover = grassCoverField(macro, root_xz);
        water_k *= grassCoverKeep(h_tuft.w, cover);
    }

    float dry = grassDryField(root_xz);
    // Kind + size roll, one per tuft (grass_common.glsl.h).  .w is the
    // SLOT code: 0 for the six blades; for the flower slot, the flower
    // code on green land or -1 (empty, degenerate) elsewhere.
    vec4 h_kind = grassHash4(tile_key, tuft_idx, 4u);
    h_kind.w = 0.0f;
    if (blade_in == kGrassFlowerSlot) {
        vec4 h_fl = grassHash4(tile_key, tuft_idx, 5u);
        float code = grassFlowerOf(h_fl.x, cover, dry, h_fl.y);
        h_kind.w = (code > 0.5f) ? code : -1.0f;
    }
    GrassBlade blade = grassMakeBlade(root_xz, h_blade, h_kind, dry);
    blade.root_ws.y = ground_height - 0.01f;   // sink the sheath slightly
    blade.height *= water_k;
    blade.width  *= water_k;

    // ── View-distance fade + widen (see grass_common.glsl.h) ────────
    // TRUE 3D distance, not XZ: projected size is what decides whether
    // a blade can be drawn, and from an aerial camera the altitude IS
    // most of the distance — an XZ metric told a camera 400 m straight
    // up that the grass below it was at arm's length.
    {
        float cam_dist = distance(camera_info.position, blade.root_ws);
        // Widen toward ~pixel coverage first, then fade everything out.
        blade.width *= 1.0f + (kGrassWidenMax - 1.0f) *
            smoothstep(kGrassWidenStartM, kGrassViewFadeStartM, cam_dist);
        // Density compensation: the stand thins across the density ramp,
        // the blades widen toward 2x over the same distances.
        blade.width *= 1.0f + (kGrassDensityWidenMax - 1.0f) *
            smoothstep(kGrassDenseNearM, kGrassDenseFarM, cam_dist);
        float k = 1.0f - smoothstep(kGrassViewFadeStartM,
                                    kGrassViewFadeEndM, cam_dist);
        blade.height *= k;
        blade.width  *= k;
    }
    // ── Wind sway ───────────────────────────────────────────────────
    // Quadratic in height (the root is planted, the tip carries the
    // travel) — that is already how grassBladeVertex spends `arc`, so
    // the wind simply adds to it.  A small flutter at the blade's own
    // hashed phase keeps a field from swaying in lockstep.  Outside the
    // patch (weight 0) grass stands still: the coarse tier is
    // kilometre-scale weather and has nothing to say about one blade.
    {
        float wf_w;
        vec2  wv = sampleWindFine(wind_patch_tex, wind_region, root_xz, wf_w);
        float spd = length(wv);
        if (wf_w * spd > 1e-3f) {
            vec2  dir  = wv / max(spd, 1e-4f);
            float lean = min(spd * 0.055f, 0.40f) * blade.height;
            float flutter = 0.05f * min(spd, 8.0f) * blade.height *
                sin(tile_params.time * (3.0f + 2.0f * h_blade.w) +
                    h_blade.z * 6.2831853f);
            blade.arc += vec3(dir.x, 0.0f, dir.y) * ((lean + flutter) * wf_w);
        }
    }

    // ── Cull: frustum (+ Hi-Z occlusion), then compact ──────────────
    // Wind lean + flutter can push the tip up to ~0.45 x height sideways
    // and the widening can grow the blade to 3x, so the frustum sphere
    // is padded by the full height plus a metre (unchanged).
    bool blade_visible =
        blade.height > 0.0f && blade.width > 0.0f &&
        grassRootVisible(blade.root_ws + vec3(0.0f, 0.5f * blade.height, 0.0f),
                         blade.height + 1.0f);
#ifdef GRASS_HIZ
    if (blade_visible) {
        // Exact box of the blade as grassBladeVertex will build it (the
        // wind above is already in blade.arc): the centre curve runs
        // root -> root + arc horizontally and rises at most `height`
        // (it can dip by the droop), plus the ribbon half-width and a
        // flower head's radius.
        float arc_len = length(blade.arc);
        float droop = 0.5f * arc_len * arc_len / max(blade.height, 0.05f);
        float pad = blade.width + 0.03f;
        vec3 lo = blade.root_ws + vec3(min(blade.arc.x, 0.0f),
                                       min(blade.height - droop, 0.0f),
                                       min(blade.arc.z, 0.0f)) - vec3(pad);
        vec3 hi = blade.root_ws + vec3(max(blade.arc.x, 0.0f),
                                       blade.height,
                                       max(blade.arc.z, 0.0f)) + vec3(pad);
        if (grassHiZOccluded(lo, hi)) blade_visible = false;
    }
#endif
    s_blade_vis[local_idx] = blade_visible ? 1u : 0u;
    barrier();
    uint slot = 0u, n_vis = 0u;
    for (uint j = 0u; j < 16u; ++j) {
        const uint vj = s_blade_vis[j];
        if (j < local_idx) slot += vj;
        n_vis += vj;
    }
    if (n_vis == 0u) {
        SetMeshOutputsEXT(0u, 0u);
        return;
    }
    SetMeshOutputsEXT(n_vis * uint(kGrassBladeVerts),
                      n_vis * uint(kGrassBladeTris));
    if (!blade_visible) return;

    for (int i_ring = 0; i_ring < kGrassRings; i_ring++) {
        uint v_idx = slot * uint(kGrassBladeVerts) + uint(i_ring) * 2u;
        for (int i_side = 0; i_side < 2; i_side++) {
            float side_sign = (i_side == 0) ? 1.0f : -1.0f;
            vec3  p_ws; vec3 n_ws; float v;
            grassBladeVertex(blade, i_ring, side_sign, p_ws, n_ws, v);

            uint o = v_idx + uint(i_side);
            gl_MeshVerticesEXT[o].gl_Position =
                camera_info.view_proj * vec4(p_ws, 1.0f);
            out_data[o].pos_ws_v = vec4(p_ws, v);
            out_data[o].nrm_hash = vec4(n_ws, blade.hash);
            out_data[o].attribs  =
                vec4(blade.dry, side_sign * kGrassProfile[i_ring].x,
                     blade.height, blade.flower);
        }
    }

    for (int i_poly = 0; i_poly < kGrassBladeTris; i_poly++) {
        gl_PrimitiveTriangleIndicesEXT[slot * uint(kGrassBladeTris) + uint(i_poly)] =
            uvec3(slot * uint(kGrassBladeVerts) + uint(i_poly),
                  slot * uint(kGrassBladeVerts) + uint(i_poly) + 1u,
                  slot * uint(kGrassBladeVerts) + uint(i_poly) + 2u);
    }
}
